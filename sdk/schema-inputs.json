      "clean",
      "describe",
      "generate",
      "plan-clean",
      "plan-native",
      "scan",
      "validate",
      "verify"
    ],
    "0.6.4": [
      "bind",
      "clean",
      "describe",
      "generate",
      "lint",
      "plan-clean",
      "plan-native",
      "scan",
      "validate",
      "verify"
    ]
  },
