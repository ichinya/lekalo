{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/change-request.schema.v0.8.0.json",
  "title": "Lekalo change request",
  "description": "Closed contract of one ordered semantic change batch (issue #73). The request is a pure declaration: it names typed semantic subjects and closed operation payloads only. No source paths, JSON Pointers, shell fragments, executable patches, or wall-clock values may appear. Operation order is semantic and is hashed as written. Operations the running implementation does not provide decode as declared members and fail later with the registered unsupported outcome; unknown operation discriminators are malformed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lekalo/change-request/v0.8.0"
    },
    "expectModel": {
      "$ref": "#/$defs/sha256"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "symbolId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$"
    },
    "moduleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "fieldName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "typeRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "$ref": "#/$defs/symbolId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "list"
          ],
          "properties": {
            "list": {
              "$ref": "#/$defs/typeRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "optional"
          ],
          "properties": {
            "optional": {
              "$ref": "#/$defs/typeRef"
            }
          }
        }
      ]
    },
    "fieldDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/fieldName"
        },
        "type": {
          "$ref": "#/$defs/typeRef"
        },
        "required": {
          "const": true
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "default": {
          "$ref": "#/$defs/literal"
        }
      }
    },
    "caseDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/fieldName"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "value": {
          "$ref": "#/$defs/literal"
        }
      }
    },
    "literal": {
      "description": "One bounded JSON literal tree. The runtime decoder additionally bounds the depth to four and each string to 4096 bytes; deeper or larger values are malformed.",
      "anyOf": [
        {
          "type": "string",
          "maxLength": 8192
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/literal"
          }
        },
        {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "$ref": "#/$defs/literal"
          }
        }
      ]
    },
    "closedPayload": {
      "description": "One bounded declaration payload carried verbatim by an operation this implementation does not provide yet. Members are never interpreted; the payload exists so a request written against the full catalog decodes and fails with the registered unsupported outcome instead of a malformed shape.",
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "maxLength": 64
      },
      "additionalProperties": {
        "$ref": "#/$defs/literal"
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "entity",
            "field"
          ],
          "properties": {
            "operation": {
              "const": "entity-field:add"
            },
            "entity": {
              "$ref": "#/$defs/symbolId"
            },
            "field": {
              "$ref": "#/$defs/fieldDecl"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "entity",
            "name"
          ],
          "properties": {
            "operation": {
              "const": "entity-field:remove"
            },
            "entity": {
              "$ref": "#/$defs/symbolId"
            },
            "name": {
              "$ref": "#/$defs/fieldName"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "entity",
            "name",
            "to"
          ],
          "properties": {
            "operation": {
              "const": "entity-field:rename"
            },
            "entity": {
              "$ref": "#/$defs/symbolId"
            },
            "name": {
              "$ref": "#/$defs/fieldName"
            },
            "to": {
              "$ref": "#/$defs/fieldName"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "enum",
            "case"
          ],
          "properties": {
            "operation": {
              "const": "enum-case:add"
            },
            "enum": {
              "$ref": "#/$defs/symbolId"
            },
            "case": {
              "$ref": "#/$defs/caseDecl"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "enum",
            "name",
            "definition"
          ],
          "properties": {
            "operation": {
              "const": "enum-case:change"
            },
            "enum": {
              "$ref": "#/$defs/symbolId"
            },
            "name": {
              "$ref": "#/$defs/fieldName"
            },
            "definition": {
              "$ref": "#/$defs/closedPayload"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "kind",
            "module",
            "definition"
          ],
          "properties": {
            "operation": {
              "const": "definition:add"
            },
            "kind": {
              "enum": [
                "command",
                "query",
                "event",
                "policy",
                "scenario"
              ]
            },
            "module": {
              "$ref": "#/$defs/moduleId"
            },
            "definition": {
              "$ref": "#/$defs/closedPayload"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "operationTarget",
            "definition"
          ],
          "properties": {
            "operation": {
              "const": "operation-input:set"
            },
            "operationTarget": {
              "$ref": "#/$defs/symbolId"
            },
            "definition": {
              "$ref": "#/$defs/closedPayload"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "operationTarget",
            "type"
          ],
          "properties": {
            "operation": {
              "const": "operation-output:set"
            },
            "operationTarget": {
              "$ref": "#/$defs/symbolId"
            },
            "type": {
              "$ref": "#/$defs/typeRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "operationTarget",
            "definition"
          ],
          "properties": {
            "operation": {
              "const": "operation-error:set"
            },
            "operationTarget": {
              "$ref": "#/$defs/symbolId"
            },
            "definition": {
              "$ref": "#/$defs/closedPayload"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "command"
          ],
          "properties": {
            "operation": {
              "const": "command-effect:add"
            },
            "command": {
              "$ref": "#/$defs/symbolId"
            },
            "effect": {
              "$ref": "#/$defs/symbolId"
            },
            "emit": {
              "$ref": "#/$defs/symbolId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "command"
          ],
          "properties": {
            "operation": {
              "const": "command-effect:remove"
            },
            "command": {
              "$ref": "#/$defs/symbolId"
            },
            "effect": {
              "$ref": "#/$defs/symbolId"
            },
            "emit": {
              "$ref": "#/$defs/symbolId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "query",
            "effect"
          ],
          "properties": {
            "operation": {
              "const": "query-effect:add"
            },
            "query": {
              "$ref": "#/$defs/symbolId"
            },
            "effect": {
              "$ref": "#/$defs/symbolId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "query",
            "effect"
          ],
          "properties": {
            "operation": {
              "const": "query-effect:remove"
            },
            "query": {
              "$ref": "#/$defs/symbolId"
            },
            "effect": {
              "$ref": "#/$defs/symbolId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "symbol",
            "definition"
          ],
          "properties": {
            "operation": {
              "const": "binding:add"
            },
            "symbol": {
              "$ref": "#/$defs/symbolId"
            },
            "definition": {
              "$ref": "#/$defs/closedPayload"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "subject",
            "mode",
            "evidence"
          ],
          "properties": {
            "operation": {
              "const": "ownership:set"
            },
            "subject": {
              "$ref": "#/$defs/symbolId"
            },
            "mode": {
              "enum": [
                "observed",
                "contracted",
                "managed"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/closedPayload"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "symbol",
            "requirement"
          ],
          "properties": {
            "operation": {
              "const": "requirement:link"
            },
            "symbol": {
              "$ref": "#/$defs/symbolId"
            },
            "requirement": {
              "$ref": "#/$defs/fieldName"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "symbol",
            "requirement"
          ],
          "properties": {
            "operation": {
              "const": "requirement:unlink"
            },
            "symbol": {
              "$ref": "#/$defs/symbolId"
            },
            "requirement": {
              "$ref": "#/$defs/fieldName"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "symbol",
            "toModule"
          ],
          "properties": {
            "operation": {
              "const": "symbol:move"
            },
            "symbol": {
              "$ref": "#/$defs/symbolId"
            },
            "toModule": {
              "$ref": "#/$defs/moduleId"
            },
            "toName": {
              "$ref": "#/$defs/fieldName"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "module",
            "directory"
          ],
          "properties": {
            "operation": {
              "const": "module:move"
            },
            "module": {
              "$ref": "#/$defs/moduleId"
            },
            "directory": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-z][a-z0-9_]{0,62}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "step"
          ],
          "properties": {
            "operation": {
              "const": "migration:apply"
            },
            "step": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9.-]{0,126}$"
            },
            "parameters": {
              "$ref": "#/$defs/closedPayload"
            }
          }
        }
      ]
    }
  }
}
