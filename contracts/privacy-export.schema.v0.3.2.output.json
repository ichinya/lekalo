{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekalo.dev/contracts/privacy-export.schema.v0.3.2.output.json",
  "schemaId": "dev.lekalo.privacy-export-output-schema",
  "version": "0.3.2",
  "title": "Lekalo ExportDecisionOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "reasonCodes",
    "requiredTransforms",
    "effectiveRefs",
    "derivedArtifactRequirements",
    "sourceTransferAllowed"
  ],
  "properties": {
    "decision": {
      "enum": [
        "allow",
        "deny",
        "transform-required"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredTransforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "redact-content",
          "redact-secrets",
          "redact-pii",
          "aggregate-no-source-rows",
          "replace-repository-identity",
          "normalize-project-relative-paths"
        ]
      }
    },
    "effectiveRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionContractRef",
        "authorityRef",
        "policyRef",
        "classificationContractRef",
        "inputSchemaRef",
        "outputSchemaRef",
        "authorizingEvidenceContractRef",
        "authorizationSubjectProfileRef"
      ],
      "properties": {
        "decisionContractRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractId",
            "version"
          ],
          "properties": {
            "contractId": {
              "const": "dev.lekalo.privacy-export-decision"
            },
            "version": {
              "const": "0.2.16"
            }
          }
        },
        "authorityRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractId",
            "version",
            "digest"
          ],
          "properties": {
            "contractId": {
              "const": "dev.lekalo.authority-matrix"
            },
            "version": {
              "const": "0.3.2"
            },
            "digest": {
              "const": "sha256:7ae6454ea20f7b61202d368411ef9bff4e70af96f1f2a408c209d84fe9722f80"
            }
          }
        },
        "policyRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policyId",
            "version",
            "digest"
          ],
          "properties": {
            "policyId": {
              "const": "dev.lekalo.privacy-export-policy"
            },
            "version": {
              "const": "0.3.2"
            },
            "digest": {
              "const": "sha256:5a80966fa628fd4c9452325d34e7191f40ebb7a9cb49185c91d413861fb18384"
            }
          }
        },
        "inputSchemaRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaId",
            "version"
          ],
          "properties": {
            "schemaId": {
              "const": "dev.lekalo.privacy-export-input-schema"
            },
            "version": {
              "const": "0.3.2"
            }
          }
        },
        "outputSchemaRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaId",
            "version"
          ],
          "properties": {
            "schemaId": {
              "const": "dev.lekalo.privacy-export-output-schema"
            },
            "version": {
              "const": "0.3.2"
            }
          }
        },
        "classificationContractRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractId",
            "version",
            "digest"
          ],
          "properties": {
            "contractId": {
              "const": "dev.lekalo.privacy-classification-decision"
            },
            "version": {
              "const": "0.2.16"
            },
            "digest": {
              "const": "sha256:78de535f02b6a8065579b43798ed650849aca0b7edf1aa08b2e0219fc744dde6"
            }
          }
        },
        "authorizingEvidenceContractRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractId",
            "version",
            "digest"
          ],
          "properties": {
            "contractId": {
              "const": "dev.lekalo.privacy-authorizing-evidence"
            },
            "version": {
              "const": "0.2.16"
            },
            "digest": {
              "const": "sha256:cba51a4d9ae21a8d6ad7ebcb98f63410d918b0308ebcbdce1a165e084f52957e"
            }
          }
        },
        "authorizationSubjectProfileRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profileId",
            "version",
            "digest"
          ],
          "properties": {
            "profileId": {
              "const": "dev.lekalo.privacy-authorization-subject-profile"
            },
            "version": {
              "const": "0.2.16"
            },
            "digest": {
              "const": "sha256:11c3c6ddea482ba5cf1bca27f08d602801d7739f1bd57ed5efb15e100584dec0"
            }
          }
        }
      }
    },
    "derivedArtifactRequirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "new-artifact",
          "new-provenance",
          "retain-exact-source-authority-and-policy-refs",
          "retain-source-classification-refs",
          "record-applied-transforms",
          "record-declassification-or-aggregation-decision",
          "reevaluate-derived-output"
        ]
      }
    },
    "sourceTransferAllowed": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "transform-required"
          }
        }
      },
      "then": {
        "properties": {
          "requiredTransforms": {
            "minItems": 1
          },
          "derivedArtifactRequirements": {
            "minItems": 1
          },
          "sourceTransferAllowed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "deny"
          }
        }
      },
      "then": {
        "properties": {
          "requiredTransforms": {
            "maxItems": 0
          },
          "derivedArtifactRequirements": {
            "maxItems": 0
          },
          "sourceTransferAllowed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "allow"
          }
        }
      },
      "then": {
        "properties": {
          "requiredTransforms": {
            "maxItems": 0
          },
          "derivedArtifactRequirements": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "lifecycle": {
    "status": "accepted",
    "accepted": true,
    "predecessor": {
      "schemaId": "dev.lekalo.privacy-export-output-schema",
      "version": "1.5.0",
      "rawDigest": "sha256:973786421855c93484492b589012606fd81481631735731a5b59c7d21bff1aac",
      "status": "yanked-with-policy-1.0.6-after-constraint-intersection-audit"
    },
    "compatibility": "constraint-baseline-correction-with-refreshed-exact-policy-input-and-decision-refs",
    "silentMutationAllowed": false
  }
}
