{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekalo.dev/contracts/privacy-export.schema.v1.output.json",
  "schemaId": "dev.lekalo.privacy-export-output-schema",
  "version": "1.0.0",
  "title": "Lekalo ExportDecisionOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "reasonCodes",
    "requiredTransforms",
    "effectiveRefs",
    "derivedArtifactRequirements",
    "sourceTransferAllowed"
  ],
  "properties": {
    "decision": { "enum": ["allow", "deny", "transform-required"] },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredTransforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["redact-content", "redact-secrets", "redact-pii", "aggregate-no-source-rows", "replace-repository-identity", "normalize-project-relative-paths"]
      }
    },
    "effectiveRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionContractRef", "authorityRef", "policyRef", "inputSchemaRef", "outputSchemaRef"],
      "properties": {
        "decisionContractRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractId", "version"],
          "properties": {
            "contractId": { "const": "dev.lekalo.privacy-export-decision" },
            "version": { "const": "1.0.0" }
          }
        },
        "authorityRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractId", "version", "digest"],
          "properties": {
            "contractId": { "const": "dev.lekalo.authority-matrix" },
            "version": { "const": "1.3.1" },
            "digest": { "const": "sha256:5c96ed68fe27956512b6de37e0fa23d223e4430d391b6a5869b12d2a8cb522d3" }
          }
        },
        "policyRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policyId", "version", "digest"],
          "properties": {
            "policyId": { "const": "dev.lekalo.privacy-export-policy" },
            "version": { "const": "1.0.1" },
        "digest": { "const": "sha256:f8faab0908fb1bc2da8c173969921000d6424a1f900ab0b04f2b57fa058d0ffb" }
          }
        },
        "inputSchemaRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaId", "version"],
          "properties": {
            "schemaId": { "const": "dev.lekalo.privacy-export-input-schema" },
            "version": { "const": "2.0.0" }
          }
        },
        "outputSchemaRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaId", "version"],
          "properties": {
            "schemaId": { "const": "dev.lekalo.privacy-export-output-schema" },
            "version": { "const": "1.0.0" }
          }
        }
      }
    },
    "derivedArtifactRequirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["new-artifact", "new-provenance", "retain-exact-source-authority-and-policy-refs", "retain-source-classification-refs", "record-applied-transforms", "record-declassification-or-aggregation-decision", "reevaluate-derived-output"]
      }
    },
    "sourceTransferAllowed": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "transform-required" } } },
      "then": {
        "properties": {
          "requiredTransforms": { "minItems": 1 },
          "derivedArtifactRequirements": { "minItems": 1 },
          "sourceTransferAllowed": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "deny" } } },
      "then": {
        "properties": {
          "requiredTransforms": { "maxItems": 0 },
          "derivedArtifactRequirements": { "maxItems": 0 },
          "sourceTransferAllowed": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "allow" } } },
      "then": {
        "properties": {
          "requiredTransforms": { "maxItems": 0 },
          "derivedArtifactRequirements": { "maxItems": 0 }
        }
      }
    }
  ]
}
