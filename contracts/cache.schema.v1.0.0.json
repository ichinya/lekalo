{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/cache.schema.v1.0.0.json",
  "title": "Lekalo incremental cache wire",
  "description": "Closed contract of the Lekalo incremental cache (issue #20): the self-describing cache record envelope and the bounded cache health projection. The cache contract version is independent of the product release and of every Model/IR/graph/effect/lock/protocol contract version. The cache is Lekalo-owned derived data under .lekalo/cache/** only; it is never a canonical source. A record carries typed key fields, the exact binding vector, sorted dependency edges, and a bounded typed payload; no source text, raw document bytes, credentials, environment data, host identity, wall-clock timestamps, mtime values, or provider transcripts may appear.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/record" },
    { "$ref": "#/$defs/health" }
  ],
  "$defs": {
    "hex64": {
      "description": "A lowercase sha256 digest spelled sha256:<64 lowercase hex> or the bare 64 lowercase hex characters.",
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    },
    "logicalPath": {
      "description": "A project-relative POSIX logical path of an already-validated model source; bounded, portable, NFC, lowercase grammar as accepted by the structure contract.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "identity"],
      "properties": {
        "family": {
          "description": "The contract family, e.g. dev.lekalo.model.",
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^dev\\.lekalo\\.[a-z][a-z0-9-]*$"
        },
        "identity": {
          "description": "The exact consumed contract identity, e.g. dev.lekalo.ir@0.1.0.",
          "type": "string",
          "minLength": 5,
          "maxLength": 160,
          "pattern": "^dev\\.lekalo\\.[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "dependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyDigest", "role", "ordinal"],
      "properties": {
        "keyDigest": {
          "$ref": "#/$defs/hex64"
        },
        "role": {
          "enum": [
            "input",
            "upstream",
            "producer",
            "profile",
            "lock",
            "adapter"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "sourceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "rawDigest", "normalizedDigest"],
      "properties": {
        "kind": { "const": "source" },
        "path": { "$ref": "#/$defs/logicalPath" },
        "rawDigest": { "$ref": "#/$defs/hex64" },
        "normalizedDigest": { "$ref": "#/$defs/hex64" }
      }
    },
    "parsedFragmentKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "rawDigest"],
      "properties": {
        "kind": { "const": "parsed-fragment" },
        "path": { "$ref": "#/$defs/logicalPath" },
        "rawDigest": { "$ref": "#/$defs/hex64" },
        "normalizedDigest": { "$ref": "#/$defs/hex64" },
        "documentDigest": {
          "description": "The digest binding the parsed fragment to its upstream source record key bytes.",
          "$ref": "#/$defs/hex64"
        }
      }
    },
    "irFragmentKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modelVersion", "parsedDigests"],
      "properties": {
        "kind": { "const": "ir-fragment" },
        "modelVersion": { "enum": ["0.1.0", "1.0.0"] },
        "parsedDigests": {
          "description": "The sorted, deduplicated parsed-fragment key digests of the whole compilation input set.",
          "type": "array",
          "minItems": 1,
          "maxItems": 1000000,
          "items": { "$ref": "#/$defs/hex64" }
        }
      }
    },
    "graphFragmentKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "irDigest"],
      "properties": {
        "kind": { "const": "graph-fragment" },
        "irDigest": {
          "description": "The digest of the canonical IR bytes the graph was projected from.",
          "$ref": "#/$defs/hex64"
        }
      }
    },
    "effectFragmentKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "graphDigest"],
      "properties": {
        "kind": { "const": "effect-fragment" },
        "graphDigest": {
          "description": "The digest of the canonical graph bytes the effect projection was built from.",
          "$ref": "#/$defs/hex64"
        }
      }
    },
    "adapterCapabilityKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "adapterId", "protocolVersion", "executableDigest"],
      "properties": {
        "kind": { "const": "adapter-capability" },
        "adapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z0-9][a-z0-9./_-]*$"
        },
        "protocolVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "executableDigest": { "$ref": "#/$defs/hex64" }
      }
    },
    "adapterResultKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "capabilityDigest",
        "inputDigest",
        "profileDigest"
      ],
      "properties": {
        "kind": { "const": "adapter-result" },
        "capabilityDigest": { "$ref": "#/$defs/hex64" },
        "inputDigest": { "$ref": "#/$defs/hex64" },
        "profileDigest": { "$ref": "#/$defs/hex64" }
      }
    },
    "artifactManifestKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "manifestSchemaDigest",
        "lockRevision",
        "artifactDigest"
      ],
      "properties": {
        "kind": { "const": "artifact-manifest-key" },
        "manifestSchemaDigest": { "$ref": "#/$defs/hex64" },
        "lockRevision": { "$ref": "#/$defs/hex64" },
        "artifactDigest": { "$ref": "#/$defs/hex64" }
      }
    },
    "contextKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contextSchemaDigest",
        "scopeDigest",
        "profileDigest",
        "budget"
      ],
      "properties": {
        "kind": { "const": "context-key" },
        "contextSchemaDigest": { "$ref": "#/$defs/hex64" },
        "scopeDigest": { "$ref": "#/$defs/hex64" },
        "profileDigest": { "$ref": "#/$defs/hex64" },
        "budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "value"],
      "properties": {
        "encoding": { "const": "lekalo/canonical-json" },
        "value": {
          "description": "The closed, kind-specific bounded payload value; opaque to the cache store itself.",
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "fields"],
          "properties": {
            "digest": {
              "description": "The digest of the canonical producer snapshot this payload summarizes.",
              "$ref": "#/$defs/hex64"
            },
            "fields": {
              "description": "Bounded integer facts of the producer snapshot (counts and sizes only).",
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "value"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  }
                }
              }
            }
          }
        }
      }
    },
    "record": {
      "description": "One self-describing cache record: typed key, exact binding vector, sorted dependency edges, bounded payload.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "identity",
        "recordKind",
        "key",
        "keyDigest",
        "binding",
        "dependencies",
        "payload",
        "payloadDigest"
      ],
      "properties": {
        "schemaVersion": { "const": "lekalo/cache/v1.0.0" },
        "identity": { "const": "dev.lekalo.cache@1.0.0" },
        "recordKind": {
          "enum": [
            "source",
            "parsed-fragment",
            "ir-fragment",
            "graph-fragment",
            "effect-fragment",
            "adapter-capability",
            "adapter-result",
            "artifact-manifest-key",
            "context-key"
          ]
        },
        "key": {
          "oneOf": [
            { "$ref": "#/$defs/sourceKey" },
            { "$ref": "#/$defs/parsedFragmentKey" },
            { "$ref": "#/$defs/irFragmentKey" },
            { "$ref": "#/$defs/graphFragmentKey" },
            { "$ref": "#/$defs/effectFragmentKey" },
            { "$ref": "#/$defs/adapterCapabilityKey" },
            { "$ref": "#/$defs/adapterResultKey" },
            { "$ref": "#/$defs/artifactManifestKey" },
            { "$ref": "#/$defs/contextKey" }
          ]
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cacheIdentity", "contracts", "pipelineRevision"],
          "properties": {
            "cacheIdentity": { "const": "dev.lekalo.cache@1.0.0" },
            "pipelineRevision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "contracts": {
              "description": "The exact consumed producer contracts, sorted and deduplicated by identity.",
              "type": "array",
              "minItems": 0,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/contractRef" }
            }
          }
        },
        "dependencies": {
          "description": "Sorted, deduplicated typed dependency edges: sorted by keyDigest bytes, then role, then ordinal.",
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/dependencyEdge" }
        },
        "keyDigest": { "$ref": "#/$defs/hex64" },
        "payload": { "$ref": "#/$defs/payload" },
        "payloadDigest": { "$ref": "#/$defs/hex64" }
      }
    },
    "health": {
      "description": "The bounded cache health projection of `lekalo cache status`; no raw paths, host values, or volatile telemetry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "identity", "state", "backend"],
      "properties": {
        "schemaVersion": { "const": "lekalo/cache/v1.0.0" },
        "identity": { "const": "dev.lekalo.cache@1.0.0" },
        "state": {
          "enum": [
            "ok",
            "empty",
            "missing",
            "disabled",
            "corrupt",
            "quarantined",
            "locked",
            "unreadable"
          ]
        },
        "backend": { "const": "sqlite" },
        "records": {
          "description": "Bounded record counts by kind.",
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "count"],
            "properties": {
              "kind": {
                "enum": [
                  "source",
                  "parsed-fragment",
                  "ir-fragment",
                  "graph-fragment",
                  "effect-fragment",
                  "adapter-capability",
                  "adapter-result",
                  "artifact-manifest-key",
                  "context-key"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000
              }
            }
          }
        },
        "dependencyEdges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        }
      }
    }
  }
}
