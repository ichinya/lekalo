{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekalo.dev/contracts/privacy-cli-error.schema.v1.0.0.json",
  "schemaId": "dev.lekalo.privacy-cli-error-schema",
  "version": "1.0.0",
  "title": "Lekalo privacy checker startup and custody error",
  "description": "Closed exit-1 protocol for errors raised before ExportDecisionInput evaluation. This object is not an ExportDecisionOutput.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "reasonCodes"
  ],
  "properties": {
    "status": {
      "const": "invalid"
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "lifecycle": {
    "status": "accepted",
    "accepted": true,
    "compatibility": "initial-exact-separate-cli-startup-error-protocol",
    "exportDecisionOutput": false,
    "silentMutationAllowed": false
  }
}
