{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.run-history-store-schema@0.4.0",
  "title": "Lekalo run history store v0.4.0",
  "description": "Closed wire shape of the local-only run history store metadata (issue #121): the logical store state projection used by init, recovery, retention, and the dependent-reference seam. The physical SQLite database never leaves the project-local history home; this document describes logical state only and is never a persisted absolute-path carrier. Tenant scope ids and the repository id are locally generated opaque tokens. Dependent references carry only opaque ids, kinds, states, generations, and digest-bound source references - never dependent payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "repositoryId",
    "tenantScopes",
    "generation",
    "retention",
    "dependents"
  ],
  "properties": {
    "schema_version": {
      "const": "lekalo/run-history-store/v0.4.0"
    },
    "identity": {
      "const": "dev.lekalo.run-history-store@0.4.0"
    },
    "repositoryId": {
      "$ref": "#/$defs/hexToken32"
    },
    "tenantScopes": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenantScopeId",
          "createdAt"
        ],
        "properties": {
          "tenantScopeId": {
            "$ref": "#/$defs/hexToken32"
          },
          "createdAt": {
            "$ref": "#/$defs/timestampUtc"
          }
        }
      }
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAgeDays",
        "maxRecords",
        "maxBytes"
      ],
      "properties": {
        "maxAgeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "maxRecords": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1073741824
        }
      }
    },
    "dependents": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "state",
          "generation",
          "sourceRuns"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/boundedToken"
          },
          "kind": {
            "enum": [
              "index",
              "claim",
              "aggregate-input"
            ]
          },
          "state": {
            "enum": [
              "valid",
              "invalidated"
            ]
          },
          "generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sourceRuns": {
            "type": "array",
            "maxItems": 1024,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runId",
                "recordDigest",
                "assertionDigest"
              ],
              "properties": {
                "runId": {
                  "$ref": "#/$defs/hexToken32"
                },
                "recordDigest": {
                  "$ref": "#/$defs/sha256"
                },
                "assertionDigest": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/sha256"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hexToken32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "maxLength": 32
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "timestampUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "maxLength": 40
    },
    "boundedToken": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "maxLength": 128
    }
  }
}
