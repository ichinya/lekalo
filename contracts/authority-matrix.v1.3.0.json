  "conditionalPathBoundaries": [
    {
      "pattern": "project.yaml",
      "owner": "hlv",
      "artifactKind": "hlv.project-contract",
      "requiredContext": "hlvLayoutConfirmed",
      "requiredValue": true
    }
  ],
  "syncPolicy": {
    "defaultDirection": "canonical-to-derived",
    "allowedSourceClassifications": [
      "canonical",
      "direct-evidence"
    ],
    "allowedTargetClassifications": [
      "derived",
      "cached",
      "runtime-only"
    ],
    "automaticBidirectional": false,
    "crossOwnerCanonicalWrites": false,
    "reconciliationWritesCanonical": false,
    "requiredReconciliationReports": [
      "loss",
      "conflict",
      "provenance"
    ],
    "requiredReconciliationApprovals": [
      "each-canonical-owner"
    ]
  },
  "generatedPromotionPolicy": {
    "mode": "explicit-adoption",
    "requiredEvidence": [
      "explicitAdoption",
      "reviewed",
      "provenance"
    ],
    "silentPromotion": false
  },
  "brownfieldAdoptionPolicy": {
    "action": "adopt",
    "sourceKind": "lekalo.observed-model-draft",
    "targetKind": "lekalo.semantic-model",
    "actor": "lekalo",
    "requiredEvidence": [
      "explicitAdoption",
      "reviewed",
      "provenance"
    ],
    "genericSync": false
  },
  "operationProtocol": {
    "discriminator": "action",
    "actions": [
      "read",
      "write",
      "sync",
      "claim",
      "promote",
      "adopt"
    ],
    "evidenceProvenanceFields": [
      "sourceRevision",
      "sourceDigest",
      "recordedBy"
    ],
    "strictObjects": true,
    "unknownFields": "reject",
    "malformedExitCode": 1,
    "policyDeniedExitCode": 3
  },
  "claimPolicy": {
    "mode": "reference-only",
    "requiredSubstitute": false,
    "substitutionAllowed": false,
    "promotionAction": "promote",
    "adoptionAction": "adopt"
  },
  "traceability": {
    "chain": [
      "openspec.requirement",
      "lekalo.stable-symbol",
      "lekalo.target-binding",
      "lekalo.scenario-or-source-native.native-test",
      "hlv.gate-diagnostic"
    ],
    "requiredEvidenceMetadata": [
      "toolVersion",
      "protocolVersion",
      "changeId",
      "revision",
      "timestamp",
      "provenance"
    ],
    "missingLinkState": "unresolved",
    "contradictionAction": "block-dependent-operation"
  },
  "conflictPolicy": {
    "defaultAction": "block-and-report",
    "lastWriterWins": false,
    "precedenceByQuestion": {
      "what-and-why": "openspec",
      "how-work-is-executed": "ai-factory",
      "semantic-application-model": "lekalo",
      "validation-and-traceability-result": "hlv",
      "what-exists-and-runs": "source-native"
    }
  },
  "projectRules": {
    "greenfield": {
      "initialization": "explicit-user-action",
      "providerAutoInstall": false
    },
    "brownfield": {
      "discoveryWrites": false,
      "observedModelClassification": "derived",
      "canonicalAdoption": "explicit-reviewed-action"
    },
    "absentLayerTransfersAuthority": false
  }
}
