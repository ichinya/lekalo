{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/explain-result.schema.v0.8.0.json",
  "title": "lekalo/explain-result/v0.8.0",
  "description": "Closed schema of the `lekalo explain` result (issue #96). One result either resolves explicit selectors into a bounded explanations map, or reports one distinct refusal. Localized human output may vary; the code and the structured meaning of this document are the stable machine contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "schemaVersion",
    "identity",
    "state",
    "catalogVersion",
    "registryIdentity",
    "explanations"
  ],
  "properties": {
    "status": {
      "enum": [
        "valid",
        "unsupported"
      ]
    },
    "schemaVersion": {
      "const": "lekalo/explain-result/v0.8.0"
    },
    "identity": {
      "const": "dev.lekalo.explain-result@0.8.0"
    },
    "state": {
      "description": "explained: every selector resolved. unexplained: at least one selector has no explanation (distinct, machine-readable).",
      "enum": [
        "explained",
        "unexplained"
      ]
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "registryIdentity": {
      "type": "string",
      "const": "dev.lekalo.diagnostic-registry@0.8.0"
    },
    "explanations": {
      "description": "One stable explanation per resolved selector, in selector order. Empty exactly when the state is unexplained.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/explanation"
      }
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "diagnosticCode": {
      "type": "string",
      "pattern": "^LEK-[A-Z][A-Z0-9]{1,11}-[0-9]{3}$"
    },
    "category": {
      "enum": [
        "model",
        "semantic",
        "compatibility",
        "adapter",
        "infrastructure",
        "security"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "status": {
      "enum": [
        "valid",
        "invalid",
        "denied",
        "unsupported",
        "unavailable",
        "unsupported-version"
      ]
    },
    "fixClass": {
      "description": "The closed risk-class vocabulary, mirroring the versioned fix-recipe classes plus manual-only: no severity or adapter assertion can re-class a fix.",
      "enum": [
        "safe",
        "unsafe",
        "breaking",
        "manual-only"
      ]
    },
    "prose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "fixOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "description"
      ],
      "properties": {
        "class": {
          "$ref": "#/$defs/fixClass"
        },
        "recipeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
          "maxLength": 128
        },
        "description": {
          "$ref": "#/$defs/prose"
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/prose"
        },
        "after": {
          "$ref": "#/$defs/prose"
        }
      }
    },
    "targetNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "note"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 63
        },
        "note": {
          "$ref": "#/$defs/prose"
        }
      }
    },
    "docsLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "url"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 32
        },
        "url": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "severityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultSeverity",
        "severities",
        "allowedStatuses",
        "blocking",
        "waiverPolicy"
      ],
      "properties": {
        "defaultSeverity": {
          "$ref": "#/$defs/severity"
        },
        "severities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/severity"
          }
        },
        "allowedStatuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/status"
          }
        },
        "blocking": {
          "type": "boolean"
        },
        "waiverPolicy": {
          "$ref": "#/$defs/prose"
        }
      }
    },
    "sourceReport": {
      "description": "Attached diagnostic context: which diagnostic in the caller-supplied report this explanation resolves. Structural context only; the explanation is never claimed to apply to unverified source.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "location",
        "message",
        "severity"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "location": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "ruleId",
        "title",
        "category",
        "checks",
        "rationale",
        "rootCauses",
        "fixOptions",
        "executableRecipeId",
        "examples",
        "relatedCodes",
        "severityProfile",
        "targetNotes",
        "docsLinks",
        "source"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/diagnosticCode"
        },
        "ruleId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "checks": {
          "$ref": "#/$defs/prose"
        },
        "rationale": {
          "$ref": "#/$defs/prose"
        },
        "rootCauses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/prose"
          }
        },
        "fixOptions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/fixOption"
          }
        },
        "executableRecipeId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
              "maxLength": 128
            }
          ]
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "relatedCodes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/diagnosticCode"
          }
        },
        "severityProfile": {
          "$ref": "#/$defs/severityProfile"
        },
        "targetNotes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/targetNote"
          }
        },
        "docsLinks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/docsLink"
          }
        },
        "source": {
          "description": "Where this explanation came from: embedded core catalog, or a namespaced adapter explanation. Present only in the resolved state.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "const": "core"
            },
            "report": {
              "$ref": "#/$defs/sourceReport"
            }
          }
        }
      }
    }
  }
}
