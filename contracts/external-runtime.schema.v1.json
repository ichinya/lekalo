{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekalo.dev/contracts/external-runtime.schema.v1.json",
  "title": "External runtime configuration, packages and process protocol v1",
  "$ref": "#/$defs/config",
  "$defs": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "lekalo/runtime-config/v1"
        },
        "components": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._/@-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/component"
          }
        }
      },
      "required": [
        "schema",
        "components"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "runtime": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              },
              "required": [
                "command"
              ]
            }
          ]
        },
        "rules": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      },
      "required": [
        "path",
        "runtime"
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "lekalo/contract-rules/v1"
        },
        "requires": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._/@-]+$"
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._/@-]+$"
              },
              "schema": {
                "type": [
                  "object",
                  "boolean"
                ]
              }
            },
            "required": [
              "id",
              "schema"
            ]
          }
        }
      },
      "required": [
        "schema",
        "requires",
        "checks"
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "lekalo/package/v1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._/@-]+$"
        },
        "version": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "runtime",
            "rules"
          ]
        },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "command": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "rules": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "id",
        "version",
        "kind",
        "files"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "runtime"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "minItems": 1
              }
            },
            "not": {
              "required": [
                "rules"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rules"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "rules"
            ],
            "properties": {
              "command": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._/@-]+$"
        },
        "version": {
          "type": "string"
        },
        "rules_api": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._/@-]+$"
          }
        },
        "capabilities": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._/@-]+$"
          }
        },
        "operations": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._/@-]+$"
          }
        }
      },
      "required": [
        "id",
        "version",
        "rules_api",
        "capabilities",
        "operations"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "lekalo/runtime/v1"
        },
        "request_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "operation": {
          "enum": [
            "describe",
            "check"
          ]
        },
        "input": {
          "type": "object"
        }
      },
      "required": [
        "protocol",
        "request_id",
        "operation",
        "input"
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "lekalo/runtime/v1"
        },
        "request_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "protocol",
        "request_id",
        "result"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "complete"
        },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      },
      "required": [
        "state",
        "facts"
      ]
    }
  }
}
