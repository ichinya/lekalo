        "tools",
        "required_capabilities",
        "capabilities",
        "run_eligibility",
        "limits",
        "write_policy"
      ],
      "properties": {
        "schema_version": {
          "const": "lekalo/native-gate-plan/v0.4.0"
        },
        "kind": {
          "const": "native-plan"
        },
        "plan_digest": {
