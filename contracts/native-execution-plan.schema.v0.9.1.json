{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/native-execution-plan.schema.v0.9.1.json",
  "title": "Lekalo native execution-plan 0.9.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "plan_digest",
    "native_plan",
    "custody",
    "inputs",
    "tools"
  ],
  "properties": {
    "schema_version": {
      "const": "lekalo/native-execution-plan/v0.9.1"
    },
    "kind": {
      "const": "native-execution-plan"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "native_plan": {
      "$ref": "#/$defs/Plan_Document"
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_digest",
        "profile_digest",
        "catalog_digest",
        "adapter_manifest_digest",
        "adapter_package_digest",
        "adapter_entry_digest",
        "source_manifest_digest"
      ],
      "properties": {
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "profile_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "catalog_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "adapter_manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "adapter_package_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "adapter_entry_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/Plan_logicalPath"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "artifact_digest",
          "program_digest",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "program_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "maxLength": 32
          }
        }
      }
    }
  },
  "$defs": {
    "Plan_sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "Plan_contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "Plan_adapterIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "maxLength": 64
        },
        "version": {
          "$ref": "#/$defs/Plan_contractVersion"
        },
        "digest": {
          "$ref": "#/$defs/Plan_sha256Digest"
        }
      }
    },
    "Plan_repositoryRole": {
      "type": "string",
      "enum": [
        "local-workspace",
        "consumer-repository",
        "lekalo-repository",
        "openspec-repository",
        "ai-factory-repository",
        "hlv-repository",
        "source-native-repository",
        "external-repository",
        "public-channel"
      ]
    },
    "Plan_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "private",
            "untrusted",
            "public-fixture"
          ]
        },
        "fixture_ref": {
          "$ref": "#/$defs/Plan_sha256Digest"
        },
        "provenance_ref": {
          "$ref": "#/$defs/Plan_sha256Digest"
        }
      }
    },
    "Plan_authorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "version",
        "digest"
      ],
      "properties": {
        "contractId": {
          "const": "dev.lekalo.authority-matrix"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "digest": {
          "$ref": "#/$defs/Plan_sha256Digest"
        }
      }
    },
    "Plan_policyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "version",
        "digest"
      ],
      "properties": {
        "policyId": {
          "const": "dev.lekalo.privacy-export-policy"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "digest": {
          "$ref": "#/$defs/Plan_sha256Digest"
        }
      }
    },
    "Plan_classificationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "version",
        "digest"
      ],
      "properties": {
        "contractId": {
          "const": "dev.lekalo.privacy-classification-decision"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "digest": {
          "$ref": "#/$defs/Plan_sha256Digest"
        }
      }
    },
    "Plan_contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 128
        },
        "version": {
          "$ref": "#/$defs/Plan_contractVersion"
        },
        "digest": {
          "$ref": "#/$defs/Plan_sha256Digest"
        }
      }
    },
    "Plan_profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "maxLength": 64
        },
        "digest": {
          "$ref": "#/$defs/Plan_sha256Digest"
        }
      }
    },
    "Plan_packageId": {
      "type": "string",
      "pattern": "^[a-z0-9._][a-z0-9._/-]{0,63}=[a-z0-9@/._-]{1,192}$",
      "maxLength": 256
    },
    "Plan_logicalPath": {
      "type": "string",
      "pattern": "^(?!(?:.*[/])?(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:[./]|$))(?!(?:.*[/])?\\.{1,2}(?:/|$))(?!.*\\.(?:/|$))[a-z0-9._][a-z0-9._-]{0,63}(?:/[a-z0-9._][a-z0-9._-]{0,63})*$",
      "maxLength": 512
    },
    "Plan_capabilityId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$",
      "maxLength": 128
    },
    "Plan_workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manager",
        "declared_version",
        "compatibility_path",
        "root",
        "manifest_digest",
        "lock_digest_state",
        "packages",
        "edges",
        "completeness",
        "uncertainties"
      ],
      "properties": {
        "manager": {
          "type": "string",
          "enum": [
            "bun",
            "composer-project",
            "npm-standalone",
            "npm-workspaces",
            "pnpm-workspace",
            "yarn"
          ]
        },
        "declared_version": {
          "oneOf": [
            {
              "$ref": "#/$defs/Plan_contractVersion"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "compatibility_path": {
          "type": "string",
          "enum": [
            "supported",
            "partial",
            "unsupported"
          ]
        },
        "root": {
          "$ref": "#/$defs/Plan_workspaceRoot"
        },
        "manifest_digest": {
          "$ref": "#/$defs/Plan_sha256Digest"
        },
        "lock_digest_state": {
          "type": "string",
          "enum": [
            "present",
            "absent",
            "unreadable",
            "excluded"
          ]
        },
        "lock_digest": {
          "$ref": "#/$defs/Plan_sha256Digest"
        },
        "packages": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/Plan_package"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 8192,
          "items": {
            "$ref": "#/$defs/Plan_edge"
          }
        },
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "uncertainties": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/Plan_uncertainty"
          }
        }
      }
    },
    "Plan_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "root",
        "manifest_digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Plan_packageId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192
        },
        "root": {
          "$ref": "#/$defs/Plan_packageRoot"
        },
        "manifest_digest": {
          "$ref": "#/$defs/Plan_sha256Digest"
        }
      }
    },
    "Plan_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind",
        "provenance"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/Plan_packageId"
        },
        "to": {
          "$ref": "#/$defs/Plan_packageId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "dependency",
            "dev-dependency",
            "optional-dependency",
            "peer-dependency",
            "ts-reference",
            "scanner-reference",
            "target-binding"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "dependencies",
            "devDependencies",
            "optionalDependencies",
            "peerDependencies"
          ]
        },
        "specifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provenance": {
          "type": "string",
          "enum": [
            "workspace-specifier",
            "manifest-evidence",
            "lock-evidence",
            "scan-evidence",
            "explicit-binding"
          ]
        }
      }
    },
    "Plan_uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "detail"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "unresolved-dependency",
            "version-mismatch",
            "cycle",
            "excluded-read",
            "pattern-partial",
            "manager-ambiguous",
            "deleted-package",
            "unknown"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "package_id": {
          "$ref": "#/$defs/Plan_packageId"
        }
      }
    },
    "Plan_changes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "change"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/Plan_logicalPath"
              },
              "change": {
                "type": "string",
                "enum": [
                  "added",
                  "modified",
                  "deleted",
                  "renamed"
                ]
              },
              "before_digest": {
                "$ref": "#/$defs/Plan_sha256Digest"
              },
              "after_digest": {
                "$ref": "#/$defs/Plan_sha256Digest"
              }
            }
          }
        },
        "symbols": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,191}$",
            "maxLength": 192
          }
        }
      }
    },
    "Plan_affectedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "reasons"
      ],
      "properties": {
        "package_id": {
          "$ref": "#/$defs/Plan_packageId"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Plan_reason"
          }
        }
      }
    },
    "Plan_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "changed-package",
            "dependent-closure",
            "graph-bound-test",
            "build-prerequisite",
            "release-rule",
            "explicit-binding"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "edge_path": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Plan_packageId"
          }
        },
        "policy_rule_ref": {
          "$ref": "#/$defs/Plan_sha256Digest"
        }
      }
    },
    "Plan_excludedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "reason"
      ],
      "properties": {
        "package_id": {
          "$ref": "#/$defs/Plan_packageId"
        },
        "reason": {
          "type": "string",
          "enum": [
            "no-reason",
            "no-confirmation",
            "no-edge",
            "owner-unknown",
            "out-of-scope"
          ]
        }
      }
    },
    "Plan_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "package_id",
        "gate",
        "script_name",
        "script_digest",
        "confirmation_ref",
        "cwd",
        "tool_ref",
        "argv",
        "env",
        "depends_on",
        "affected_reason_refs",
        "read_manifest_ref",
        "allowed_writes",
        "limits",
        "gate_id",
        "gate_kind",
        "required",
        "selection_ref",
        "covers_suite_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "maxLength": 128
        },
        "package_id": {
          "$ref": "#/$defs/Plan_packageId"
        },
        "gate": {
          "type": "string",
          "enum": [
            "build",
            "typecheck",
            "lint",
            "test"
          ]
        },
        "script_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._:-]*$"
        },
        "script_digest": {
          "$ref": "#/$defs/Plan_sha256Digest"
        },
        "confirmation_ref": {
          "$ref": "#/$defs/Plan_sha256Digest"
        },
        "cwd": {
          "oneOf": [
            {
              "const": "."
            },
            {
              "$ref": "#/$defs/Plan_logicalPath"
            }
          ]
        },
        "tool_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "env": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "maxLength": 64
          }
        },
        "tsconfig_ref": {
          "$ref": "#/$defs/Plan_logicalPath"
        },
        "depends_on": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Plan_gateId"
          },
          "description": "The selected commands that must run first (command ids, issue #61 successor semantics)."
        },
        "affected_reason_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "read_manifest_ref": {
          "$ref": "#/$defs/Plan_sha256Digest"
        },
        "allowed_writes": {
          "$ref": "#/$defs/Plan_writePolicy"
        },
        "limits": {
          "$ref": "#/$defs/Plan_limits"
        },
        "provenance": {
          "$ref": "#/$defs/Plan_sha256Digest"
        },
        "gate_id": {
          "$ref": "#/$defs/Plan_gateId"
        },
        "gate_kind": {
          "$ref": "#/$defs/Plan_gateKind"
        },
        "required": {
          "type": "boolean"
        },
        "selection_ref": {
          "$ref": "#/$defs/Plan_sha256Digest"
        },
        "covers_suite_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Plan_gateId"
          }
        }
      }
    },
    "Plan_env": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_names",
        "bindings"
      ],
      "properties": {
        "allowed_names": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "maxLength": 64
          }
        },
        "bindings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Plan_envBinding"
          }
        }
      }
    },
    "Plan_envBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "maxLength": 64
        },
        "kind": {
          "type": "string",
          "enum": [
            "literal",
            "execution-temp",
            "execution-home",
            "platform-system-root"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "Plan_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "artifact_digest",
        "platform"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "oneOf": [
            {
              "$ref": "#/$defs/Plan_contractVersion"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "artifact_digest": {
          "$ref": "#/$defs/Plan_sha256Digest"
        },
        "entry_digest": {
          "$ref": "#/$defs/Plan_sha256Digest"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "provenance": {
          "type": "string",
          "enum": [
            "fixture-catalog",
            "declared-manifest",
            "unknown"
          ]
        }
      }
    },
    "Plan_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "definition_version",
        "state",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Plan_capabilityId"
        },
        "definition_version": {
          "$ref": "#/$defs/Plan_contractVersion"
        },
        "state": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "unsupported",
            "unknown"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "declared",
            "probed",
            "verified"
          ]
        },
        "evidence_ref": {
          "$ref": "#/$defs/Plan_sha256Digest"
        }
      }
    },
    "Plan_runEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason_codes"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "runnable",
            "blocked",
            "plan-only"
          ]
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "maxLength": 64
          }
        }
      }
    },
    "Plan_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms_per_command",
        "timeout_ms_per_run",
        "max_stdout_bytes",
        "max_stderr_bytes",
