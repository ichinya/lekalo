{
  "contractId": "dev.lekalo.authority-matrix",
  "version": "0.3.2",
  "status": "accepted",
  "compatibility": {
    "checkerProfile": "closed-exact",
    "extensionsAllowed": false,
    "semanticallyIdenticalCopiesAllowed": false,
    "changeType": "corrective-boundary-custody"
  },
  "registryPolicy": {
    "closure": "closed-exact",
    "runtimeExtensionsAllowed": false,
    "localAliasesAllowed": false,
    "unknownKinds": "reject",
    "successorAdmission": "reviewed-exact-triple-only",
    "kindRequiredFields": [
      "id",
      "canonicalOwner",
      "classification",
      "allowedPaths",
      "allowedReaders",
      "allowedWriters"
    ],
    "forbiddenKindFields": [
      "dataSensitivity",
      "exportDisposition"
    ]
  },
  "successorProcedure": {
    "versionSource": "workspace.package.version",
    "exactDigestRequired": true,
    "acceptanceManifest": "contracts/authority-contracts.manifest.json"
  },
  "boundaryPolicy": {
    "schemaVersion": "0.2.16",
    "resolution": "all-matches-most-specific",
    "specificityOrder": [
      "literal-prefix-segments-desc",
      "literal-segment-count-desc",
      "literal-character-count-desc",
      "segment-depth-desc",
      "wildcard-token-count-asc"
    ],
    "equalSpecificity": "identical-policy-or-reject",
    "kindBinding": "exact-boundary-artifactKinds",
    "readerWriterBinding": "boundary-and-kind-intersection",
    "actionAccess": {
      "read": {
        "source": "read"
      },
      "write": {
        "target": "write"
      },
      "syncOneWay": {
        "source": "read",
        "target": "write"
      },
      "syncBidirectionalProposal": {
        "source": "read",
        "target": "read"
      },
      "claimReference": {
        "source": "read",
        "target": "read"
      },
      "promote": {
        "source": "read",
        "target": "write"
      },
      "adopt": {
        "source": "read",
        "target": "write"
      }
    }
  },
  "pathSyntax": "project-relative-posix",
  "pathComparison": "case-insensitive-fail-closed",
  "pathSafety": {
    "trailingDotOrSpacePerSegment": "reject",
    "alternateDataStreamColon": "reject",
    "dosDeviceName": "reject",
    "shortNameLikeTildeNumber": "reject",
    "physicalContainment": "adapter-must-resolve-and-verify"
  },
