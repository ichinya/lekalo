{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "projectRef",
    "sourceRevision",
    "modelRef",
    "workingSetDigest",
    "traceDigest",
    "mappingDigest",
    "policy",
    "requiredProviders",
    "providerPins",
    "requireExecution",
    "scope",
    "chains",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lekalo/trace-validation-evidence/v0.6.4"
    },
    "identity": {
      "const": "dev.lekalo.trace-validation-evidence@0.6.4"
    },
    "projectRef": {
      "$ref": "#/$defs/id"
    },
    "sourceRevision": {
      "$ref": "#/$defs/revision"
    },
    "modelRef": {
      "$ref": "#/$defs/model"
    },
    "workingSetDigest": {
      "$ref": "#/$defs/digest"
    },
    "traceDigest": {
      "$ref": "#/$defs/digest"
    },
    "mappingDigest": {
      "$ref": "#/$defs/digest"
    },
    "policy": {
      "enum": [
        "optional",
        "required"
      ]
    },
    "requiredProviders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      },
      "maxItems": 5,
      "minItems": 0,
      "uniqueItems": true
    },
    "providerPins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/providerPin"
      },
      "maxItems": 5,
      "minItems": 0
    },
    "requireExecution": {
      "type": "boolean"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "chains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chain"
      },
      "maxItems": 10000,
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "maxItems": 2000,
      "minItems": 0
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/trace-validation-evidence.schema.v0.6.4.json",
  "title": "Neutral trace validation evidence",
  "description": "Caller-selected scope, explicit six-role mapping and revision-bound normalized receipts. Closed wire; no HLV layout, native documents, commands or raw streams. Semantic gate independently checks total bounds, duplicate identities, mapping digest and relational custody. Input <= 8 MiB. Digests are integrity pins, not authenticity proof.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$",
      "maxLength": 192
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "occurrence": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
      "maxLength": 64
    },
    "provider": {
      "enum": [
        "openspec",
        "hlv",
        "source-native",
        "aifhub",
        "lekalo"
      ]
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+(?:/[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)*)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 32
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "digest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.2.16"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "originalDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "subject"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$",
          "maxLength": 128
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "subject": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "providerPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "tool",
        "protocol"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "tool": {
          "$ref": "#/$defs/pin"
        },
        "protocol": {
          "$ref": "#/$defs/pin"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "artifacts",
        "scenarios"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 10000,
          "minItems": 1,
          "uniqueItems": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 10000,
          "minItems": 1,
          "uniqueItems": true
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 10000,
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "occurrence",
        "requirement",
        "symbol",
        "artifact",
        "scenario",
        "relationRefs",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "occurrence": {
          "$ref": "#/$defs/occurrence"
        },
        "requirement": {
          "$ref": "#/$defs/id"
        },
        "symbol": {
          "$ref": "#/$defs/id"
        },
        "artifact": {
          "$ref": "#/$defs/id"
        },
        "scenario": {
          "$ref": "#/$defs/id"
        },
        "test": {
          "$ref": "#/$defs/id"
        },
        "gate": {
          "$ref": "#/$defs/id"
        },
        "relationRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          },
          "maxItems": 5,
          "minItems": 0,
          "uniqueItems": true
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 16,
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "kind",
        "outcome",
        "protocol",
        "sourceRevision",
        "modelRef",
        "workingSetDigest",
        "resultDigest",
        "diagnostics"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "kind": {
          "enum": [
            "check",
            "execution"
          ]
        },
        "outcome": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "unavailable",
            "unsupported",
            "infrastructure",
            "configuration"
          ]
        },
        "tool": {
          "$ref": "#/$defs/pin"
        },
        "protocol": {
          "$ref": "#/$defs/pin"
        },
        "sourceRevision": {
          "$ref": "#/$defs/revision"
        },
        "modelRef": {
          "$ref": "#/$defs/model"
        },
        "workingSetDigest": {
          "$ref": "#/$defs/digest"
        },
        "resultDigest": {
          "$ref": "#/$defs/digest"
        },
        "gate": {
          "$ref": "#/$defs/id"
        },
        "test": {
          "$ref": "#/$defs/id"
        },
        "artifact": {
          "$ref": "#/$defs/id"
        },
        "artifactDigest": {
          "$ref": "#/$defs/digest"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/originalDiagnostic"
          },
          "maxItems": 128,
          "minItems": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "execution"
              }
            }
          },
          "then": {
            "required": [
              "gate",
              "test",
              "artifact",
              "artifactDigest"
            ],
            "properties": {
              "gate": {},
              "test": {},
              "artifact": {},
              "artifactDigest": {}
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "gate"
                  ],
                  "properties": {
                    "gate": {}
                  }
                },
                {
                  "required": [
                    "test"
                  ],
                  "properties": {
                    "test": {}
                  }
                },
                {
                  "required": [
                    "artifact"
                  ],
                  "properties": {
                    "artifact": {}
                  }
                },
                {
                  "required": [
                    "artifactDigest"
                  ],
                  "properties": {
                    "artifactDigest": {}
                  }
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "pass",
                  "warn",
                  "fail"
                ]
              }
            }
          },
          "then": {
            "required": [
              "tool"
            ],
            "properties": {
              "tool": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "const": "info"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "warn"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "enum": [
                        "warning",
                        "info"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
