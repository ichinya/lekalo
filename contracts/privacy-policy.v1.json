    },
    {
      "disposition": "consumer-repository-only",
      "allowOperations": ["local-use", "repository-store", "derive"],
      "transformOperations": [],
      "sourceTransferAllowed": true,
      "requirements": ["originating-repository-only", "same-origin-acl", "same-tenant"]
    },
    {
      "disposition": "shareable-with-redaction",
      "allowOperations": ["local-use", "repository-store"],
      "transformOperations": ["derive", "transfer", "publish"],
      "sourceTransferAllowed": false,
