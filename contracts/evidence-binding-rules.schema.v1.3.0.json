{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.evidence-binding-rules@1.3.0",
  "title": "Declarative evidence binding rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "identity", "match", "source_roles"],
  "properties": {
    "schema": {"const": "lekalo/evidence-binding-rules/v1.3.0"},
    "kind": {
      "enum": ["scalar", "enum", "value-object", "entity", "command", "query", "event", "policy", "effect", "endpoint"]
    },
    "identity": {"$ref": "#/$defs/selectors"},
    "match": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/token"},
        "method": {"$ref": "#/$defs/token"},
        "path": {"$ref": "#/$defs/token"}
      }
    },
    "source_roles": {
      "allOf": [
        {"$ref": "#/$defs/selectors"},
        {"contains": {"const": "subject"}}
      ]
    }
  },
  "if": {"properties": {"kind": {"not": {"const": "endpoint"}}}},
  "then": {
    "properties": {"match": {"required": ["id"], "maxProperties": 1}}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "selectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/token"}
    }
  }
}
