{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/change-catalog.schema.v0.8.0.json",
  "title": "Lekalo change catalog schema",
  "description": "Closed schema of the embedded change operation catalog (issue #73). The catalog is the stable machine-readable surface a future MCP tool consumes to discover which operation discriminators exist, whether the running implementation provides each one, and what mutation class and evidence each requires. The catalog and the sealed executors bind one-to-one: every request discriminator must be declared here exactly once, in canonical operation-ID byte order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "closed",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lekalo/change-catalog/v0.8.0"
    },
    "identity": {
      "const": "dev.lekalo.change-catalog@0.8.0"
    },
    "closed": {
      "const": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "operationId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "status",
        "title",
        "mutationClass",
        "requiredEvidence"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/operationId"
        },
        "status": {
          "enum": [
            "implemented",
            "unsupported"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mutationClass": {
          "enum": [
            "additive",
            "member-additive",
            "member-destructive",
            "destructive",
            "administrative"
          ]
        },
        "requiredEvidence": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          }
        }
      }
    }
  }
}
