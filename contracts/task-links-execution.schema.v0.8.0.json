{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.task-links-execution-schema@0.8.0",
  "title": "Task-links execution owner export 0.8.0",
  "description": "Export-only normalized observation of the executing owner. No file containing this shape is re-importable execution authority: trusted admission requires the sealed process-local capability produced by actual engine execution and independent assertions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "owner", "implementation", "buildDigest", "sourceDigest", "inputDigest", "resultDigest", "executionId", "attachmentRevision", "origin", "scenarios", "steps", "assertions"],
  "properties": {
    "schemaVersion": {"const": "lekalo/task-links-execution/v0.8.0"},
    "identity": {"const": "dev.lekalo.task-links-execution@0.8.0"},
    "owner": {"const": "lekalo-core/task-links-execution"},
    "implementation": {"const": "lekalo-core-deterministic-mock"},
    "buildDigest": {"$ref": "#/$defs/digest"},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "inputDigest": {"$ref": "#/$defs/digest"},
    "resultDigest": {"$ref": "#/$defs/digest"},
    "attachmentRevision": {"$ref": "#/$defs/digest"},
    "executionId": {"$ref": "#/$defs/symbol"},
    "origin": {"const": "mock"},
    "scenarios": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/symbol"}},
    "assertions": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["command", "outcome", "stateDigest"], "properties": {
      "command": {"$ref": "#/$defs/symbol"}, "outcome": {"$ref": "#/$defs/token"}, "stateDigest": {"$ref": "#/$defs/digest"}
    }}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 256},
    "symbol": {"type": "string", "maxLength": 191, "pattern": "^[a-z][a-z0-9_]{0,62}(\\.[a-z][a-z0-9_]{0,62}){1,3}$"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "implementation", "buildDigest", "sourceDigest", "inputDigest", "resultDigest", "profileId", "profileDigest", "origin", "assertions"],
      "properties": {
        "owner": {"$ref": "#/$defs/token"}, "implementation": {"$ref": "#/$defs/token"},
        "buildDigest": {"$ref": "#/$defs/digest"}, "sourceDigest": {"$ref": "#/$defs/digest"},
        "inputDigest": {"$ref": "#/$defs/digest"}, "resultDigest": {"$ref": "#/$defs/digest"},
        "profileId": {"$ref": "#/$defs/token"}, "profileDigest": {"$ref": "#/$defs/digest"},
        "origin": {"enum": ["mock", "native"]},
        "assertions": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}
      }
    }
  }
}
