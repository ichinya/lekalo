{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.mcp-tool-context-input@0.8.0",
  "title": "Lekalo MCP tool input: context",
  "description": "Issue #33 closed request grammar of the context tool. Structural violations (missing, unknown, wrong-typed, or out-of-range members) are JSON-RPC -32602; cross-field semantic invariants are the typed mcp.input-invalid refusal. projectId must name a server-catalog project; groupId an optional catalog group of that project.",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "groupId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "mode": {
      "enum": [
        "symbol",
        "changed"
      ]
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,191}$"
    },
    "changedSymbols": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,191}$"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "spans": {
      "type": "boolean"
    }
  },
  "required": [
    "projectId",
    "mode",
    "budget"
  ],
  "additionalProperties": false
}
