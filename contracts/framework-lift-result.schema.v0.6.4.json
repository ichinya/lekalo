    },
    "campaignRef": {
      "$ref": "#/$defs/ref"
    },
    "taskRef": {
      "$ref": "#/$defs/ref"
    },
    "baselineRef": {
      "$ref": "#/$defs/ref"
    },
    "profileDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceStatus": {
      "enum": [
        "recorded-simulation",
        "recorded-unverified"
      ]
    },
    "exportDisposition": {
      "const": "local-private"
    },
    "consumerRole": {
      "const": "consumer-repository"
    },
    "consumerAlias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "pilot": {
      "$ref": "#/$defs/pilot"
    },
    "analysis": {
      "const": "intent-to-run-wilson-95-paired-counts-1"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true
    },
    "summaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/summary"
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "paired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bothSuccess",
        "aOnly",
        "bOnly",
        "neither",
        "incomplete"
      ],
      "properties": {
        "bothSuccess": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "aOnly": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bOnly": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "neither": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "incomplete": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "liftPercentagePoints": {
      "$ref": "#/$defs/lift"
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "minimumLift",
        "maximumLift"
