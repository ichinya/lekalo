{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.framework-lift-result-schema@0.6.4",
  "description": "Closed local-only recorded evaluation evidence. Simulation is never live agent evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "campaignRef",
    "taskRef",
    "baselineRef",
    "profileDigest",
    "evidenceStatus",
    "exportDisposition",
    "consumerRole",
    "consumerAlias",
    "pilot",
    "analysis",
    "rows",
    "summaries",
    "paired",
    "liftPercentagePoints",
    "uncertainty",
    "claim"
  ],
