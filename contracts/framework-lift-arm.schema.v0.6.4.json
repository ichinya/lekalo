{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.framework-lift-arm-schema@0.6.4",
  "description": "Closed local-only recorded evaluation evidence. Simulation is never live agent evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "runId",
    "campaignRef",
    "taskRef",
    "baselineRef",
    "slot",
    "attempt",
    "origin",
    "profileDigest",
    "applicationDigest",
    "policy",
    "candidateDigest",
    "coverage",
    "assertions",
    "failures",
    "events",
    "metrics",
    "measurementSources",
    "optionalJudge"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lekalo/framework-lift-arm/v0.6.4"
    },
    "identity": {
      "const": "dev.lekalo.framework-lift-arm@0.6.4"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "campaignRef": {
      "$ref": "#/$defs/ref"
    },
    "taskRef": {
      "$ref": "#/$defs/ref"
    },
    "baselineRef": {
      "$ref": "#/$defs/ref"
    },
    "slot": {
      "$ref": "#/$defs/slot"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "origin": {
      "$ref": "#/$defs/origin"
    },
    "profileDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "applicationDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lekalo",
        "semanticExposure",
        "network"
      ],
      "properties": {
        "lekalo": {
          "type": "boolean"
        },
        "semanticExposure": {
          "type": "boolean"
        },
        "network": {
          "enum": [
            "local-only",
            "public-synthetic"
          ]
        }
      }
    },
    "candidateDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "coverage": {
      "enum": [
        "complete",
        "incomplete",
        "unknown"
      ]
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      },
      "minItems": 0,
      "maxItems": 768,
      "uniqueItems": true
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failure"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "measurementSources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 0,
      "maxItems": 25,
      "uniqueItems": true
    },
