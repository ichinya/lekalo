{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.mcp-tool-impact-output@0.8.0",
  "title": "Lekalo MCP tool output: impact",
  "description": "Issue #33 closed result envelope of the impact tool. status \"valid\" carries the preserved core receipt in \"result\"; every other status carries the typed \"failure\" branch and never a fabricated payload. The status/result|failure coherence is the published conditional; embedded core payloads are the exact bundled upstream definitions.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "lekalo/mcp-tool-impact-output/v0.8.0"
    },
    "identity": {
      "const": "dev.lekalo.mcp-tool-impact-output@0.8.0"
    },
    "tool": {
      "const": "lekalo_impact"
    },
    "scope": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "groupId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "projectId",
        "groupId"
      ],
      "additionalProperties": false
    },
    "snapshotRef": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "valid",
        "invalid",
        "denied",
        "unsupported",
        "unavailable",
        "unsupported-version"
      ]
    },
    "contractPins": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "const": "0.2.16"
        },
        "diagnosticRegistry": {
          "const": "0.8.0"
        },
        "protocolProfile": {
          "const": "2025-11-25"
        },
        "impact": {
          "const": "0.2.16"
        }
      },
      "required": [
        "diagnostic",
        "diagnosticRegistry",
        "protocolProfile",
        "impact"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/diagnosticItem"
      },
      "description": "Wire diagnostic items (lekalo/diagnostic/v0.2.16) resolved against dev.lekalo.diagnostic-registry@0.8.0; every item is the closed published projection bundled under $defs.diagnosticItem."
    },
    "result": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "lekalo/impact/v0.2.16"
        },
        "identity": {
          "const": "dev.lekalo.impact@0.2.16"
        },
        "impact": {
          "$ref": "#/$defs/impact.Root"
        }
      },
      "required": [
        "schemaVersion",
        "identity",
        "impact"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "failureClass": {
          "enum": [
            "invalid-input",
            "scope-denied",
            "sensitive-output",
            "request-limit",
            "output-limit",
            "timeout",
            "cancelled",
            "contract-unsupported",
            "snapshot-stale",
            "backend-unavailable",
            "result-invalid",
            "domain-invalid",
            "domain-denied",
            "domain-unavailable",
            "domain-unsupported",
            "domain-unsupported-version"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "failureClass"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "tool",
    "scope",
    "snapshotRef",
    "status",
    "contractPins",
    "diagnostics"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "status": {
        "const": "valid"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "properties": {
      "result": {
        "$ref": "#/$defs/_anchor"
      },
      "failure": {
        "not": {}
      }
    },
    "required": [
      "result"
    ]
  },
  "else": {
    "properties": {
      "failure": {
        "$ref": "#/$defs/_anchor"
      },
      "result": {
        "not": {}
      }
    },
    "required": [
      "failure"
    ]
  },
  "$defs": {
    "_anchor": {},
    "validation.counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "warning",
        "info"
      ],
      "properties": {
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "validation.report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "profileVersion",
        "registryVersion",
        "rulesEnabled",
        "counts"
      ],
      "properties": {
        "profile": {
          "description": "The closed built-in profile id that ran (`default` or `strict`).",
          "type": "string",
          "enum": [
            "default",
            "strict"
          ]
        },
        "profileVersion": {
          "description": "The exact profile document version that ran.",
          "const": "0.6.4"
        },
        "registryVersion": {
          "description": "The exact diagnostic registry version the findings resolve against.",
          "const": "0.6.4"
        },
        "moduleScope": {
          "description": "Present only for a `--module`-scoped run; the module semantic id scope.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "rulesEnabled": {
          "description": "The number of rules the profile enabled.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "counts": {
          "$ref": "#/$defs/validation.counts"
        }
      }
    },
    "validation.diagnostic": {
      "ruleId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
        "maxLength": 128
      },
      "diagnosticCode": {
        "type": "string",
        "pattern": "^LEK-[A-Z][A-Z0-9]{1,11}-[0-9]{3}$"
      },
      "symbolId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,2}$",
        "maxLength": 256
      },
      "boundedText": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "logicalPath": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*(/[a-z0-9._-]+)*$",
        "maxLength": 1024,
        "not": {
          "pattern": "(^|/)\\.\\.?(/|$)"
        }
      },
      "position": {
        "type": "object",
        "properties": {
          "byte": {
            "type": "integer",
            "minimum": 0
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "byte",
          "line",
          "column"
        ],
        "additionalProperties": false
      },
      "range": {
        "type": "object",
        "properties": {
          "start": {
            "$ref": "#/$defs/validation.diagnostic/position"
          },
          "end": {
            "$ref": "#/$defs/validation.diagnostic/position"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "source": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "#/$defs/validation.diagnostic/logicalPath"
          },
          "range": {
            "$ref": "#/$defs/validation.diagnostic/range"
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      },
      "dataObject": {
        "type": "object",
        "maxProperties": 16,
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
        },
        "additionalProperties": {
          "$ref": "#/$defs/validation.diagnostic/dataValue"
        }
      },
      "dataValue": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 256
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "maxProperties": 16,
            "propertyNames": {
              "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "maxProperties": 16,
                  "propertyNames": {
                    "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 256
                      },
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "type": "array",
            "maxItems": 64,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 256
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          }
        ]
      },
      "location": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "#/$defs/validation.diagnostic/logicalPath"
          },
          "range": {
            "$ref": "#/$defs/validation.diagnostic/range"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "relatedLocations": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "properties": {
            "relation": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "message_id": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "location": {
              "$ref": "#/$defs/validation.diagnostic/location"
            }
          },
          "required": [
            "relation",
            "message_id",
            "location"
          ],
          "additionalProperties": false
        }
      },
      "causes": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "code": {
              "$ref": "#/$defs/validation.diagnostic/diagnosticCode"
            },
            "message_id": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "message": {
              "$ref": "#/$defs/validation.diagnostic/boundedText"
            },
            "data": {
              "$ref": "#/$defs/validation.diagnostic/dataObject"
            },
            "provider": {
              "$ref": "#/$defs/validation.diagnostic/providerMetadata"
            }
          },
          "required": [
            "id",
            "code",
            "message_id",
            "message",
            "data"
          ],
          "additionalProperties": false
        }
      },
      "fixes": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "properties": {
            "fix_id": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "applicability": {
              "enum": [
                "safe",
                "unsafe",
                "breaking"
              ]
            },
            "message": {
              "$ref": "#/$defs/validation.diagnostic/boundedText"
            },
            "data": {
              "$ref": "#/$defs/validation.diagnostic/dataObject"
            },
            "target": {
              "$ref": "#/$defs/validation.diagnostic/location"
            }
          },
          "required": [
            "fix_id",
            "applicability",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "providerMetadata": {
        "type": "object",
        "maxProperties": 8,
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+:[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "original_code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[\\x21-\\x7E]+$"
            }
          },
          "required": [
            "original_code"
          ],
          "additionalProperties": false
        }
      }
    },
    "diagnosticItem": {
      "description": "One closed `lekalo/diagnostic/v0.2.16` item: a faithful projection of the governing `contracts/diagnostic.schema.v0.2.16.json` (same grammars, bounds, and closed object shapes) with the receipt-level constants pinned.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "registry_version",
        "id",
        "code",
        "severity",
        "category",
        "message_id",
        "message",
        "data",
        "related_locations",
        "causes",
        "fixes",
        "metadata"
      ],
      "properties": {
        "schema_version": {
          "const": "lekalo/diagnostic/v0.2.16"
        },
        "registry_version": {
          "const": "0.6.4"
        },
        "id": {
          "$ref": "#/$defs/validation.diagnostic/ruleId"
        },
        "code": {
          "$ref": "#/$defs/validation.diagnostic/diagnosticCode"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "category": {
          "enum": [
            "model",
            "semantic",
            "compatibility",
            "adapter",
            "infrastructure",
            "security"
          ]
        },
        "message_id": {
          "$ref": "#/$defs/validation.diagnostic/ruleId"
        },
        "message": {
          "$ref": "#/$defs/validation.diagnostic/boundedText"
        },
        "symbol": {
          "$ref": "#/$defs/validation.diagnostic/symbolId"
        },
        "source": {
          "$ref": "#/$defs/validation.diagnostic/source"
        },
        "data": {
          "$ref": "#/$defs/validation.diagnostic/dataObject"
        },
        "related_locations": {
          "$ref": "#/$defs/validation.diagnostic/relatedLocations"
        },
        "causes": {
          "$ref": "#/$defs/validation.diagnostic/causes"
        },
        "fixes": {
          "$ref": "#/$defs/validation.diagnostic/fixes"
        },
        "metadata": {
          "$ref": "#/$defs/validation.diagnostic/providerMetadata"
        }
      }
    },
    "impact.Root": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "lekalo/impact/v0.2.16"
        },
        "identity": {
          "const": "dev.lekalo.impact@0.2.16"
        },
        "algorithm": {
          "const": "dev.lekalo.impact.algorithm@0.2.16"
        },
        "modelVersion": {
          "enum": [
            "0.2.16",
            "0.2.16"
          ]
        },
        "project": {
          "oneOf": [
            {
              "$ref": "#/$defs/impact.semanticId"
            },
            {
              "type": "null"
            }
          ]
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "baseRevisionRef",
            "candidateRevisionRef",
            "changedInputDigest"
          ],
          "properties": {
            "mode": {
              "enum": [
                "symbol",
                "committed",
                "index",
                "worktree",
                "mixed"
              ]
            },
            "baseRevisionRef": {
              "$ref": "#/$defs/impact.revisionRef"
            },
            "candidateRevisionRef": {
              "$ref": "#/$defs/impact.revisionRef"
            },
            "changedInputDigest": {
              "$ref": "#/$defs/impact.digest"
            }
          }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "depth",
            "relations",
            "kinds",
            "module",
            "target",
            "profile"
          ],
          "properties": {
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "relations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/impact.relationKind"
              }
            },
            "kinds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/impact.nodeKind"
              }
            },
            "module": {
              "oneOf": [
                {
                  "$ref": "#/$defs/impact.semanticId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target": {
              "oneOf": [
                {
                  "$ref": "#/$defs/impact.boundedToken"
                },
                {
                  "type": "null"
                }
              ]
            },
            "profile": {
              "$ref": "#/$defs/impact.profile"
            }
          }
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/impact.nodeRef"
          }
        },
        "direct": {
          "$ref": "#/$defs/impact.impactSection"
        },
        "transitive": {
          "$ref": "#/$defs/impact.impactSection"
        },
        "mandatoryPublic": {
          "$ref": "#/$defs/impact.impactSection"
        },
        "risks": {
          "$ref": "#/$defs/impact.riskSection"
        },
        "targets": {
          "$ref": "#/$defs/impact.targetSection"
        },
        "artifacts": {
          "$ref": "#/$defs/impact.simpleSection"
        },
        "scenarios": {
          "$ref": "#/$defs/impact.simpleSection"
        },
        "tests": {
          "$ref": "#/$defs/impact.simpleSection"
        },
        "gates": {
          "$ref": "#/$defs/impact.gateSection"
        },
        "explanations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/impact.explanationPath"
          }
        },
        "evidence": {
          "$ref": "#/$defs/impact.evidenceSection"
        },
        "completeness": {
          "$ref": "#/$defs/impact.completenessSection"
        },
        "diagnosticRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/impact.ruleId"
          }
        },
        "digest": {
          "$ref": "#/$defs/impact.digest"
        }
      },
      "required": [
        "schemaVersion",
        "identity",
        "algorithm",
        "modelVersion",
        "project",
        "input",
        "request",
        "roots",
        "direct",
        "transitive",
        "mandatoryPublic",
        "risks",
        "targets",
        "artifacts",
        "scenarios",
        "tests",
        "gates",
        "explanations",
        "evidence",
        "completeness",
        "diagnosticRefs",
        "digest"
      ],
      "additionalProperties": false
    },
    "impact.count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "impact.semanticId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "impact.boundedToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "impact.nodeKind": {
      "enum": [
        "project",
        "module",
        "type",
        "entity",
        "operation",
        "policy",
        "event",
        "effect",
        "endpoint",
        "scenario",
        "target-binding",
        "requirement"
      ]
    },
    "impact.relationKind": {
      "enum": [
        "requires",
        "references",
        "accepts",
        "returns",
        "reads",
        "writes",
        "emits",
        "authorizes",
        "exposes",
        "implements",
        "verifies",
        "derived_from"
      ]
    },
    "impact.profile": {
      "enum": [
        "default",
        "strict"
      ]
    },
    "impact.nodeRef": {
      "type": "string",
      "pattern": "^(project|module|type|entity|operation|policy|event|effect|endpoint|scenario|target-binding|requirement):[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "impact.revisionRef": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "impact.digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "impact.ruleId": {
      "type": "string",
      "pattern": "^impact\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]+)*$",
      "maxLength": 64
    },
    "impact.confidence": {
      "enum": [
        "canonical",
        "verified",
        "extracted",
        "inferred",
        "unknown"
      ]
    },
    "impact.evidenceState": {
      "enum": [
        "canonical",
        "verified",
        "extracted",
        "inferred",
        "stale",
        "unknown"
      ]
    },
    "impact.sectionState": {
      "enum": [
        "complete",
        "incomplete",
        "stale",
        "unknown",
        "unsupported",
        "conflicting"
      ]
    },
    "impact.scope": {
      "enum": [
        "direct",
        "transitive",
        "mandatory-public"
      ]
    },
    "impact.riskDimension": {
      "enum": [
        "public_contract",
        "migration_data",
        "transaction",
        "authorization",
        "portability",
        "effects",
        "bindings_artifacts",
        "scenarios_tests"
      ]
    },
    "impact.gateState": {
      "enum": [
        "selected",
        "not-required",
        "unknown",
        "blocked"
      ]
    },
    "impact.gateId": {
      "type": "string",
      "pattern": "^impact\\.gate\\.[a-z][a-z-]*$",
      "maxLength": 64
    },
    "impact.provenanceKind": {
      "enum": [
        "canonical-ir",
        "evidence",
        "derived"
      ]
    },
