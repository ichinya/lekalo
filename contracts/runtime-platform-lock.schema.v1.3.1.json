{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekalo.dev/contracts/runtime-platform-lock.schema.v1.3.1.json",
  "title": "Platform-indexed runtime lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "config_digest", "platforms"],
  "properties": {
    "schema": { "const": "lekalo/runtime-lock/v3" },
    "config_digest": { "$ref": "#/$defs/digest" },
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9_]{1,20}-[a-z0-9_]{1,20}$" },
      "additionalProperties": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "config_digest", "components"],
      "properties": {
        "schema": { "const": "lekalo/runtime-lock/v2" },
        "config_digest": { "$ref": "#/$defs/digest" },
        "components": { "type": "object", "maxProperties": 64, "additionalProperties": { "$ref": "#/$defs/component" } },
        "services": { "type": "object", "maxProperties": 32, "additionalProperties": { "$ref": "#/$defs/runtime" } }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "rules"],
      "properties": {
        "runtime": { "$ref": "#/$defs/runtime" },
        "rules": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/package" } }
      }
    },
    "command": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "files", "description", "package"],
      "properties": {
        "command": { "type": "array", "$ref": "#/$defs/command", "minItems": 1 },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0"],
          "properties": {
            "0": { "$ref": "#/$defs/digest" },
            "1": { "$ref": "#/$defs/digest" }
          }
        },
        "description": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "rules_api", "capabilities", "operations"],
          "properties": {
            "id": { "type": "string" },
            "version": { "type": "string" },
            "rules_api": { "type": "array", "items": { "type": "string" } },
            "capabilities": { "type": "array", "items": { "type": "string" } },
            "operations": { "type": "array", "items": { "type": "string" } }
          }
        },
        "package": { "anyOf": [{ "$ref": "#/$defs/package" }, { "type": "null" }] }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "revision", "manifest", "digest", "files"],
      "properties": {
        "source": { "type": "string" },
        "revision": { "type": ["string", "null"] },
        "manifest": { "$ref": "#/$defs/manifest" },
        "digest": { "$ref": "#/$defs/digest" },
        "files": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } },
        "dependencies": { "type": "object", "additionalProperties": { "$ref": "#/$defs/package" } }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "version", "kind", "files", "command", "rules"],
      "properties": {
        "schema": { "const": "lekalo/package/v1" },
        "id": { "type": "string" },
        "version": { "type": "string" },
        "kind": { "enum": ["runtime", "rules", "library"] },
        "files": { "type": "array", "items": { "type": "string" } },
        "command": { "$ref": "#/$defs/command" },
        "rules": { "type": ["string", "null"] },
        "libraries": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
