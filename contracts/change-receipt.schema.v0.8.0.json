{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/change-receipt.schema.v0.8.0.json",
  "title": "Lekalo change receipt",
  "description": "Closed contract of one change outcome (issue #73). Receipt states are Change-service states, never envelope statuses: prepared (preview), committed (durable revision), replayed (original receipt of a repeated key), no-op (declared change already present), rejected (refused before mutation), rolled-back (restored after ordinary failure), and recovery-required (interrupted transaction blocks readers). A committed receipt exists only after the durable commit point; an interrupted or unknown transaction never reports committed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "schemaVersion",
    "identity",
    "state",
    "planId",
    "requestDigest",
    "keyDigest",
    "operations",
    "files",
    "policy",
    "history",
    "transaction",
    "diagnosticIds",
    "replayed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lekalo/change-receipt/v0.8.0"
    },
    "identity": {
      "const": "dev.lekalo.change-receipt@0.8.0"
    },
    "state": {
      "enum": [
        "prepared",
        "committed",
        "replayed",
        "no-op",
        "rejected",
        "rolled-back",
        "recovery-required"
      ]
    },
    "planId": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "requestDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "keyDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "operations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/resolvedOperation"
      }
    },
    "files": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/fileOutcome"
      }
    },
    "history": {
      "anyOf": [
        {
          "$ref": "#/$defs/historyAnchor"
        },
        {
          "type": "null"
        }
      ]
    },
    "transaction": {
      "anyOf": [
        {
          "$ref": "#/$defs/transactionState"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnosticIds": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      }
    },
    "replayed": {
      "type": "boolean"
    },
    "status": {
      "const": "valid",
      "description": "The envelope status of the run; only valid runs carry a plan or receipt payload."
    },
    "policy": {
      "description": "The accepted policy and evidence of the run; null where no plan applies.",
      "anyOf": [
        {
          "$ref": "#/$defs/policyAcceptance"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operationId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
    },
    "token": {
      "type": "string",
      "maxLength": 256
    },
    "resolvedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "subject",
        "subjectFamily",
        "status"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/operationId"
        },
        "subject": {
          "$ref": "#/$defs/token"
        },
        "subjectFamily": {
          "enum": [
            "project",
            "module",
            "scalar",
            "enum",
            "value-object",
            "entity",
            "command",
            "query",
            "policy",
            "event",
            "effect",
            "endpoint",
            "scenario",
            "target-binding",
            "none"
          ]
        },
        "status": {
          "enum": [
            "resolved",
            "unsupported"
          ]
        },
        "detail": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "fileOutcome": {
      "type": "object",
      "additionalProperties": false,
      "if": {"properties":{"outcome":{"const":"removed"}},"required":["outcome"]},
      "then": {"properties":{"afterDigest":{"const":"sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}},
      "required": [
        "path",
        "beforeDigest",
        "afterDigest",
        "outcome"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "beforeDigest": {
          "$ref": "#/$defs/sha256"
        },
        "afterDigest": {
          "$ref": "#/$defs/sha256"
        },
        "outcome": {
          "enum": [
            "replaced",
            "removed",
            "moved-from",
            "moved-to",
            "unchanged"
          ]
        }
      }
    },
    "historyAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "recordDigest"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "recordDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "transactionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-z0-9-]+$"
        },
        "state": {
          "enum": [
            "none",
            "staged",
            "committed",
            "rolled-back",
            "recovery-required"
          ]
        }
      }
    },
    "policyAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyDigest",
        "allowBreaking",
        "evidence",
        "expectPlan"
      ],
      "properties": {
        "policyDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowBreaking": {
          "type": "boolean"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectPlan": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "The accepted policy, evidence, and expected-plan pins of the run; the stored execution-intent constituents cross-checked against the record intentDigest."
    }
  }
}
