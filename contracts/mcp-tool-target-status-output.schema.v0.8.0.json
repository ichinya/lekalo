{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.mcp-tool-target-status-output@0.8.0",
  "title": "Lekalo MCP tool output: target-status",
  "description": "Issue #33 closed result envelope of the target-status tool. status \"valid\" carries the preserved core receipt in \"result\"; every other status carries the typed \"failure\" branch and never a fabricated payload. The status/result|failure coherence is the published conditional; embedded core payloads are the exact bundled upstream definitions.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "lekalo/mcp-tool-target-status-output/v0.8.0"
    },
    "identity": {
      "const": "dev.lekalo.mcp-tool-target-status-output@0.8.0"
    },
    "tool": {
      "const": "lekalo_target_status"
    },
    "scope": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "groupId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        }
      },
      "required": [
        "projectId",
        "groupId"
      ],
      "additionalProperties": false
    },
    "snapshotRef": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "valid",
        "invalid",
        "denied",
        "unsupported",
        "unavailable",
        "unsupported-version"
      ]
    },
    "contractPins": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "const": "0.2.16"
        },
        "diagnosticRegistry": {
          "const": "0.8.0"
        },
        "protocolProfile": {
          "const": "2025-11-25"
        },
        "doctor": {
          "const": "0.3.2"
        }
      },
      "required": [
        "diagnostic",
        "diagnosticRegistry",
        "protocolProfile",
        "doctor"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/diagnosticItem"
      },
      "description": "Wire diagnostic items (lekalo/diagnostic/v0.2.16) resolved against dev.lekalo.diagnostic-registry@0.8.0; every item is the closed published projection bundled under $defs.diagnosticItem."
    },
    "result": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "lekalo/doctor/v0.3.2"
        },
        "identity": {
          "const": "dev.lekalo.doctor@0.3.2"
        },
        "doctor": {
          "$ref": "#/$defs/doctor.Root"
        }
      },
      "required": [
        "schemaVersion",
        "identity",
        "doctor"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "failureClass": {
          "enum": [
            "invalid-input",
            "scope-denied",
            "sensitive-output",
            "request-limit",
            "output-limit",
            "timeout",
            "cancelled",
            "contract-unsupported",
            "snapshot-stale",
            "backend-unavailable",
            "result-invalid",
            "domain-invalid",
            "domain-denied",
            "domain-unavailable",
            "domain-unsupported",
            "domain-unsupported-version"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "failureClass"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "tool",
    "scope",
    "snapshotRef",
    "status",
    "contractPins",
    "diagnostics"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "status": {
        "const": "valid"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "properties": {
      "result": {
        "$ref": "#/$defs/_anchor"
      },
      "failure": {
        "not": {}
      }
    },
    "required": [
      "result"
    ]
  },
  "else": {
    "properties": {
      "failure": {
        "$ref": "#/$defs/_anchor"
      },
      "result": {
        "not": {}
      }
    },
    "required": [
      "failure"
    ]
  },
  "$defs": {
    "_anchor": {},
    "validation.counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "warning",
        "info"
      ],
      "properties": {
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "validation.report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "profileVersion",
        "registryVersion",
        "rulesEnabled",
        "counts"
      ],
      "properties": {
        "profile": {
          "description": "The closed built-in profile id that ran (`default` or `strict`).",
          "type": "string",
          "enum": [
            "default",
            "strict"
          ]
        },
        "profileVersion": {
          "description": "The exact profile document version that ran.",
          "const": "0.6.4"
        },
        "registryVersion": {
          "description": "The exact diagnostic registry version the findings resolve against.",
          "const": "0.6.4"
        },
        "moduleScope": {
          "description": "Present only for a `--module`-scoped run; the module semantic id scope.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "rulesEnabled": {
          "description": "The number of rules the profile enabled.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "counts": {
          "$ref": "#/$defs/validation.counts"
        }
      }
    },
    "validation.diagnostic": {
      "ruleId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
        "maxLength": 128
      },
      "diagnosticCode": {
        "type": "string",
        "pattern": "^LEK-[A-Z][A-Z0-9]{1,11}-[0-9]{3}$"
      },
      "symbolId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,2}$",
        "maxLength": 256
      },
      "boundedText": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "logicalPath": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*(/[a-z0-9._-]+)*$",
        "maxLength": 1024,
        "not": {
          "pattern": "(^|/)\\.\\.?(/|$)"
        }
      },
      "position": {
        "type": "object",
        "properties": {
          "byte": {
            "type": "integer",
            "minimum": 0
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "byte",
          "line",
          "column"
        ],
        "additionalProperties": false
      },
      "range": {
        "type": "object",
        "properties": {
          "start": {
            "$ref": "#/$defs/validation.diagnostic/position"
          },
          "end": {
            "$ref": "#/$defs/validation.diagnostic/position"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "source": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "#/$defs/validation.diagnostic/logicalPath"
          },
          "range": {
            "$ref": "#/$defs/validation.diagnostic/range"
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      },
      "dataObject": {
        "type": "object",
        "maxProperties": 16,
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
        },
        "additionalProperties": {
          "$ref": "#/$defs/validation.diagnostic/dataValue"
        }
      },
      "dataValue": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 256
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "maxProperties": 16,
            "propertyNames": {
              "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "maxProperties": 16,
                  "propertyNames": {
                    "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 256
                      },
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "type": "array",
            "maxItems": 64,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 256
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          }
        ]
      },
      "location": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "#/$defs/validation.diagnostic/logicalPath"
          },
          "range": {
            "$ref": "#/$defs/validation.diagnostic/range"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "relatedLocations": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "properties": {
            "relation": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "message_id": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "location": {
              "$ref": "#/$defs/validation.diagnostic/location"
            }
          },
          "required": [
            "relation",
            "message_id",
            "location"
          ],
          "additionalProperties": false
        }
      },
      "causes": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "code": {
              "$ref": "#/$defs/validation.diagnostic/diagnosticCode"
            },
            "message_id": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "message": {
              "$ref": "#/$defs/validation.diagnostic/boundedText"
            },
            "data": {
              "$ref": "#/$defs/validation.diagnostic/dataObject"
            },
            "provider": {
              "$ref": "#/$defs/validation.diagnostic/providerMetadata"
            }
          },
          "required": [
            "id",
            "code",
            "message_id",
            "message",
            "data"
          ],
          "additionalProperties": false
        }
      },
      "fixes": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "properties": {
            "fix_id": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "applicability": {
              "enum": [
                "safe",
                "unsafe",
                "breaking"
              ]
            },
            "message": {
              "$ref": "#/$defs/validation.diagnostic/boundedText"
            },
            "data": {
              "$ref": "#/$defs/validation.diagnostic/dataObject"
            },
            "target": {
              "$ref": "#/$defs/validation.diagnostic/location"
            }
          },
          "required": [
            "fix_id",
            "applicability",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "providerMetadata": {
        "type": "object",
        "maxProperties": 8,
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+:[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "original_code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[\\x21-\\x7E]+$"
            }
          },
          "required": [
            "original_code"
          ],
          "additionalProperties": false
        }
      }
    },
    "diagnosticItem": {
      "description": "One closed `lekalo/diagnostic/v0.2.16` item: a faithful projection of the governing `contracts/diagnostic.schema.v0.2.16.json` (same grammars, bounds, and closed object shapes) with the receipt-level constants pinned.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "registry_version",
        "id",
        "code",
        "severity",
        "category",
        "message_id",
        "message",
        "data",
        "related_locations",
        "causes",
        "fixes",
        "metadata"
      ],
      "properties": {
        "schema_version": {
          "const": "lekalo/diagnostic/v0.2.16"
        },
        "registry_version": {
          "description": "The exact registry version the item resolves against: the MCP union successor (0.8.0) for transport diagnostics, or the accepted predecessor pin of a preserved domain diagnostic.",
          "enum": [
            "0.2.16",
            "0.6.4",
            "0.6.5",
            "0.8.0"
          ]
        },
        "id": {
          "$ref": "#/$defs/validation.diagnostic/ruleId"
        },
        "code": {
          "$ref": "#/$defs/validation.diagnostic/diagnosticCode"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "category": {
          "enum": [
            "model",
            "semantic",
            "compatibility",
            "adapter",
            "infrastructure",
            "security"
          ]
        },
        "message_id": {
          "$ref": "#/$defs/validation.diagnostic/ruleId"
        },
        "message": {
          "$ref": "#/$defs/validation.diagnostic/boundedText"
        },
        "symbol": {
          "$ref": "#/$defs/validation.diagnostic/symbolId"
        },
        "source": {
          "$ref": "#/$defs/validation.diagnostic/source"
        },
        "data": {
          "$ref": "#/$defs/validation.diagnostic/dataObject"
        },
        "related_locations": {
          "$ref": "#/$defs/validation.diagnostic/relatedLocations"
        },
        "causes": {
          "$ref": "#/$defs/validation.diagnostic/causes"
        },
        "fixes": {
          "$ref": "#/$defs/validation.diagnostic/fixes"
        },
        "metadata": {
          "$ref": "#/$defs/validation.diagnostic/providerMetadata"
        }
      }
    },
    "doctor.Root": {
      "type": "object",
      "properties": {
        "status": {
          "const": "valid"
        },
        "schemaVersion": {
          "const": "lekalo/doctor/v0.3.2"
        },
        "identity": {
          "const": "dev.lekalo.doctor@0.3.2"
        },
        "report": {
          "description": "The closed report-kind vocabulary.",
          "enum": [
            "doctor",
            "status",
            "readiness"
          ]
        },
        "phase": {
          "description": "The readiness phase; present only when report is `readiness`. `done` is an accepted CLI alias of `release` and never appears on the wire.",
          "enum": [
            "model",
            "implement",
            "generate",
            "verify",
            "release"
          ]
        },
        "productVersion": {
          "description": "The exact product version of the producing binary.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "verdict": {
          "description": "The derived verdict: blocked when a required check (or, for `doctor`, any check) is blocked or unknown; degraded when any check is not ok; ready otherwise. Missing optional evidence (for example HLV) degrades and is never a core failure.",
          "enum": [
            "ready",
            "degraded",
            "blocked"
          ]
        },
        "revisions": {
          "$ref": "#/$defs/doctor.revisions"
        },
        "checks": {
          "description": "The closed check panel, sorted by id with no duplicates.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/doctor.check"
          }
        },
        "recipes": {
          "description": "The safe-fix recipe preview of `lekalo doctor --fix`; advice only, never executed.",
          "type": "array",
          "maxItems": 13,
          "items": {
            "$ref": "#/$defs/doctor.recipe"
          }
        }
      },
      "required": [
        "status",
        "schemaVersion",
        "identity",
        "report",
        "productVersion",
        "verdict",
        "revisions",
        "checks"
      ],
      "additionalProperties": false
    },
    "doctor.revisions": {
      "description": "The exact git/model/lock revision facts; nothing more about the host.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git",
        "model",
        "lock"
      ],
      "properties": {
        "git": {
          "$ref": "#/$defs/doctor.gitRevision"
        },
        "model": {
          "$ref": "#/$defs/doctor.modelRevision"
        },
        "lock": {
          "$ref": "#/$defs/doctor.lockRevision"
        }
      }
    },
    "doctor.gitRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "ok",
            "unavailable",
            "not-a-repository"
          ]
        },
        "commit": {
          "description": "The exact HEAD commit identity (sha1 or sha256 spelling).",
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "doctor.modelRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "ok",
            "unknown"
          ]
        },
        "version": {
          "description": "The exact canonical Model contract version.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "doctor.lockRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "description": "fresh: the verifier accepts the committed lock; stale: a newer resolution exists; absent: no lock; invalid: the lock refused verification.",
          "enum": [
            "fresh",
            "stale",
            "absent",
            "invalid"
          ]
        },
        "digest": {
          "description": "The exact lock payload digest.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "doctor.check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "required"
      ],
      "properties": {
        "id": {
          "description": "The closed check vocabulary.",
          "enum": [
            "adapters.inventory",
            "adapters.trust",
            "artifacts.drift",
            "bindings.freshness",
            "cache.health",
            "capabilities.profiles",
            "fs.confinement",
            "integrations.hlv",
            "lock.freshness",
            "model.references",
            "model.version",
            "platform.limits",
            "project.root",
            "tools.gates"
          ]
        },
        "state": {
          "description": "ok: nothing to report; degraded: actionable, non-blocking; blocked: a blocking condition; unknown: the check could not run because an upstream input was unavailable.",
          "enum": [
            "ok",
            "degraded",
            "blocked",
            "unknown"
          ]
        },
        "required": {
          "description": "Whether the check is required by the selected report kind and phase.",
          "type": "boolean"
        },
        "reason": {
          "description": "The closed distinguishing token (fresh/absent/stale, corrupt/missing, drift/clean, and so on).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "nextAction": {
          "description": "The closed safe-fix recipe id; present exactly when the state is not ok. Advice only.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "diagnostics": {
          "description": "Preserved registry rule ids of the underlying refusal, normalized and bounded.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          }
        },
        "notes": {
          "description": "Closed informational tokens (platform facts, external-ref coverage); never a finding.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "enum": [
              "case-sensitive-filesystem",
              "case-insensitive-filesystem",
              "posix-path-syntax",
              "windows-path-syntax",
              "symlink-privilege-required",
              "unicode-normalization-sensitive",
              "ref-openspec",
              "ref-hlv",
              "ref-aifhub",
              "ref-source-native",
              "ref-lekalo"
            ]
          }
        }
      }
    },
    "doctor.recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mutating",
        "steps"
      ],
      "properties": {
        "id": {
          "description": "The closed recipe id.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "mutating": {
          "description": "Whether the advice would mutate the project; doctor itself never mutates.",
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}
