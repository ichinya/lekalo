{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/change-history.schema.v0.8.0.json",
  "title": "Lekalo change history",
  "description": "Closed contract of the canonical per-project change audit history (issue #73). The history is the durable idempotency ledger and committed-receipt store: it binds every accepted semantic decision to its request, plan, idempotency-key digest, and file outcomes. Records are canonical and ordered by sequence; key digests are unique and never carry the raw key. No raw source bodies, secrets, absolute paths, or wall-clock values may appear. Deleting or tampering with the canonical history is an explicit destructive project change: replay fails closed when integrity cannot be established.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "project",
    "nextSequence",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lekalo/change-history/v0.8.0"
    },
    "identity": {
      "const": "dev.lekalo.change-history@0.8.0"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "nextSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000001
    },
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "maxLength": 256
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "keyDigest",
        "requestDigest",
        "planId",
        "intentDigest",
        "operations",
        "files",
        "receipt"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "keyDigest": {
          "$ref": "#/$defs/sha256"
        },
        "requestDigest": {
          "$ref": "#/$defs/sha256"
        },
        "planId": {
          "$ref": "#/$defs/sha256"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
          }
        },
        "files": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "receipt": {
          "$ref": "#/$defs/receiptProjection"
        },
        "intentDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "receiptProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "schemaVersion",
        "identity",
        "state",
        "planId",
        "requestDigest",
        "keyDigest",
        "operations",
        "files",
        "policy",
        "history",
        "transaction",
        "diagnosticIds",
        "replayed"
      ],
      "properties": {
        "schemaVersion": {
          "const": "lekalo/change-receipt/v0.8.0"
        },
        "identity": {
          "const": "dev.lekalo.change-receipt@0.8.0"
        },
        "state": {
          "enum": [
            "committed",
            "no-op"
          ]
        },
        "planId": {
          "$ref": "#/$defs/sha256"
        },
        "requestDigest": {
          "$ref": "#/$defs/sha256"
        },
        "keyDigest": {
          "$ref": "#/$defs/sha256"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/receiptOperation"
          }
        },
        "files": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/receiptFile"
          }
        },
        "history": {
          "$ref": "#/$defs/receiptHistory"
        },
        "transaction": {
          "$ref": "#/$defs/receiptTransaction"
        },
        "diagnosticIds": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          }
        },
        "replayed": {
          "const": false
        },
        "status": {
          "const": "valid"
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/policyAcceptance"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "receiptOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "subject",
        "subjectFamily",
        "status"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
        },
        "subject": {
          "type": "string",
          "maxLength": 256
        },
        "subjectFamily": {
          "enum": [
            "project",
            "module",
            "scalar",
            "enum",
            "value-object",
            "entity",
            "command",
            "query",
            "policy",
            "event",
            "effect",
            "endpoint",
            "scenario",
            "target-binding",
            "none"
          ]
        },
        "status": {
          "enum": [
            "resolved",
            "unsupported"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "receiptFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "beforeDigest",
        "afterDigest",
        "outcome"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "beforeDigest": {
          "$ref": "#/$defs/sha256"
        },
        "afterDigest": {
          "$ref": "#/$defs/sha256"
        },
        "outcome": {
          "enum": [
            "replaced",
            "unchanged"
          ]
        }
      }
    },
    "receiptHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "recordDigest"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "recordDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "receiptTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-z0-9-]+$"
        },
        "state": {
          "enum": [
            "committed"
          ]
        }
      }
    },
    "policyAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyDigest",
        "allowBreaking",
        "evidence"
      ],
      "properties": {
        "policyDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowBreaking": {
          "type": "boolean"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
