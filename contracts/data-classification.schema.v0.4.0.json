{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/data-classification.schema.v0.4.0.json",
  "title": "Lekalo Data Classification Attachment",
  "description": "Closed independent attachment contract declaring per-subject data kinds, defaults, and subject-bound declassification grants for one project (issue #87). The attachment is metadata-only declaration data bound to the exact projectId/modelRef/irRef custody triple: it never carries, quotes, or embeds field values, source text, physical paths, runtime principals, tokens, secrets, provider transcripts, or Model/IR bytes. Subjects address Model symbols and bounded field paths resolved against the bound IR; unknown subjects reject. Declassification is never implicit: every lowering carries an opaque review reference, a bounded justification, optional closed conditions and an optional expiry, and the credential kind is never declassifiable downward. The contract is independent of the product release, of the Model and IR contract versions, of the authorization, extended-effects, transport, NFR, and privacy-policy families, and of the diagnostic registry; sinks and reader/writer rules live in the classification-policy family.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "attachmentRevision",
    "projectId",
    "modelRef",
    "irRef",
    "defaults",
    "classifications",
    "declassifications"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lekalo/data-classification/v0.4.0"
    },
    "identity": {
      "const": "dev.lekalo.data-classification@0.4.0"
    },
    "attachmentRevision": {
      "$ref": "#/$defs/semver"
    },
    "projectId": {
      "$ref": "#/$defs/projectId"
    },
    "modelRef": {
      "$ref": "#/$defs/modelRef"
    },
    "irRef": {
      "$ref": "#/$defs/irRef"
    },
    "defaults": {
      "description": "Per-profile secure defaults. A subject with no matching entry and no covering default resolves to the unclassified state, which is distinct from any kind.",
      "$ref": "#/$defs/defaults"
    },
    "classifications": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/classification"
      }
    },
    "declassifications": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/declassificationGrant"
          },
          {
            "description": "The closed empty shape; declared lowering must exist on every kind.",
            "allOf": [
              {
                "$ref": "#/$defs/declassificationGrant"
              }
            ]
          }
        ]
      }
    },
    "openQuestions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/openQuestion"
      }
    }
  },
  "$defs": {
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "not": {
        "enum": [
          "lekalo",
          "dev"
        ]
      }
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-][0-9A-Za-z.-]+)?([+][0-9A-Za-z.-]+)?$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelVersion",
        "digest"
      ],
      "properties": {
        "modelVersion": {
          "const": "0.2.16"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "irRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "irVersion",
        "digest"
      ],
      "properties": {
        "irVersion": {
          "const": "0.2.16"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "semanticId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
    },
    "fieldToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "subjectPath": {
      "description": "One classification subject: a semantic id alone (definition-level) or a bounded `/`-separated field path under it (field or payload level). Exactly one to three segments; every segment is a bounded snake token. Paths resolve against the bound IR at validation time; unknown symbols or paths reject there.",
      "type": "string",
      "minLength": 1,
      "maxLength": 324,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*(:[a-z][a-z0-9_]*)?(/[a-z][a-z0-9_]*(:[a-z][a-z0-9_]*)?){0,2}$"
    },
    "dataKind": {
      "description": "The closed kind vocabulary. personal is PII, credential is a secret, health is special-category, derived is derived or synthetic data.",
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "personal",
        "credential",
        "financial",
        "health",
        "tenant-scoped",
        "retention-limited",
        "derived"
      ]
    },
    "boundedText": {
      "description": "Bounded declaration text. Never source text, paths, credentials, URLs, runtime values, or provider output.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 .,:;()/_-]*$"
    },
    "boundedToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "reviewRef": {
      "description": "One opaque review reference of the extended-effects security-gate shape. It references a review; it never embeds identity claims, actor names, or credentials.",
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "contractRef": {
      "description": "One exact namespaced contract id with a SemVer tail (for example an NFR constraint family id, a privacy-policy family id, or a masking-policy document id).",
      "type": "string",
      "minLength": 3,
      "maxLength": 192,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "policyRef": {
      "description": "One exact policy document id inside the privacy/export-policy family of issue #120.",
      "type": "string",
      "minLength": 3,
      "maxLength": 192,
      "pattern": "^[a-z0-9][a-zA-Z0-9._:/-]*$"
    },
    "isoTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "unclassifiedFields",
        "unclassifiedPayloads"
      ],
      "properties": {
        "profile": {
          "description": "The secure-defaults profile. strict raises the defaults for unclassified subjects and rejects them on sensitive sinks.",
          "type": "string",
          "enum": [
            "default",
            "strict"
          ]
        },
        "unclassifiedFields": {
          "$ref": "#/$defs/dataKind"
        },
        "unclassifiedPayloads": {
          "$ref": "#/$defs/dataKind"
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "kind"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/subjectPath"
        },
        "kind": {
          "$ref": "#/$defs/dataKind"
        },
        "tenantScoped": {
          "type": "boolean"
        },
        "retentionClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "labels": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/boundedToken"
          }
        }
      }
    },
    "declassificationGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "fromKind",
        "toKind",
        "approvedBy",
        "justification"
      ],
      "properties": {
        "id": {
          "description": "The exact contract id of this grant; one namespaced identity with a SemVer tail.",
          "$ref": "#/$defs/contractRef"
        },
        "subject": {
          "$ref": "#/$defs/subjectPath"
        },
        "fromKind": {
          "$ref": "#/$defs/dataKind"
        },
        "toKind": {
          "$ref": "#/$defs/dataKind"
        },
        "approvedBy": {
          "$ref": "#/$defs/reviewRef"
        },
        "justification": {
          "$ref": "#/$defs/boundedText"
        },
        "conditions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "enum": [
              "aggregated",
              "anonymized",
              "consent-obtained",
              "pseudonymized",
              "suppressed"
            ]
          }
        },
        "expiresAt": {
          "$ref": "#/$defs/isoTimestamp"
        }
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/boundedToken"
        },
        "question": {
          "$ref": "#/$defs/boundedText"
        },
        "subject": {
          "$ref": "#/$defs/subjectPath"
        }
      }
    }
  }
}
