{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/target-profile.schema.v1.0.0.json",
  "title": "Lekalo Target Profile",
  "description": "Closed contract for composable target profiles (issue #29): a profile document declares exactly one component per axis (runtime, storage, transport, testing, analysis, deployment) from the embedded, versioned component registry, with optional single-parent inheritance, explicit override acknowledgments for weaker capability resolution, and deterministic resolution into an immutable resolved snapshot whose canonical bytes feed the lock's profile digests. The document and the resolved snapshot are the two accepted top-level shapes; unknown members are refused on both.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/profileDocument"
    },
    {
      "$ref": "#/$defs/resolvedProfile"
    }
  ],
  "$defs": {
    "schemaVersion": {
      "const": "lekalo/target-profile/v1.0.0"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 128
    },
    "canonicalVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "const": "0.0.0"
      }
    },
    "axis": {
      "enum": [
        "analysis",
        "deployment",
        "runtime",
        "storage",
        "testing",
        "transport"
      ]
    },
    "support": {
      "enum": [
        "full",
        "partial"
      ]
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$",
      "maxLength": 128
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "accept"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/capabilityId"
        },
        "accept": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "profileDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "components"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/canonicalVersion"
        },
        "extends": {
          "$ref": "#/$defs/identifier"
        },
        "components": {
          "$ref": "#/$defs/componentMap"
        },
        "overrides": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/override"
          }
        }
      }
    },
    "profileDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profiles"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/profileDeclaration"
          }
        }
      }
    },
    "resolvedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "id",
        "definition_version"
      ],
      "properties": {
        "axis": {
          "$ref": "#/$defs/axis"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "definition_version": {
          "const": "1.0.0"
        }
      }
    },
    "resolvedCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "support"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityId"
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "origin": {
      "oneOf": [
        {
          "const": "declared"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inherited"
          ],
          "properties": {
            "inherited": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from"
              ],
              "properties": {
                "from": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        }
      ]
    },
    "axisProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "origin"
      ],
      "properties": {
        "axis": {
          "$ref": "#/$defs/axis"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      }
    },
    "resolvedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "components",
        "capabilities",
        "digest",
        "source_digest",
        "provenance",
        "overrides_applied"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/canonicalVersion"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/resolvedComponent"
          }
        },
        "capabilities": {
          "type": "array",
          "maxItems": 384,
          "items": {
            "$ref": "#/$defs/resolvedCapability"
          }
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/axisProvenance"
          }
        },
        "overrides_applied": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capabilityId"
          }
        }
      }
    },
    "componentMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 6,
      "additionalProperties": false,
      "properties": {
        "analysis": {
          "$ref": "#/$defs/identifier"
        },
        "deployment": {
          "$ref": "#/$defs/identifier"
        },
        "runtime": {
          "$ref": "#/$defs/identifier"
        },
        "storage": {
          "$ref": "#/$defs/identifier"
        },
        "testing": {
          "$ref": "#/$defs/identifier"
        },
        "transport": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
