{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekalo.dev/schemas/discovery-scope/v0.9.0",
  "title": "discovery-scope v0.9.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "includes",
    "excludes",
    "gitIgnore"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lekalo/discovery-scope/v0.9.0"
    },
    "identity": {
      "const": "dev.lekalo.discovery-scope@0.9.0"
    },
    "includes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?:\\.|(?:[A-Za-z0-9]|[A-Za-z0-9.][A-Za-z0-9._-]{0,62}[A-Za-z0-9_-])(?:/(?:[A-Za-z0-9]|[A-Za-z0-9.][A-Za-z0-9._-]{0,62}[A-Za-z0-9_-]))*)$",
        "description": "Literal repository-relative path, or dot; hidden names and actual source capitalization are admitted. Shared escape/device rules and case-accurate physical no-follow checks additionally apply."
      }
    },
    "excludes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?:\\.|(?:[A-Za-z0-9]|[A-Za-z0-9.][A-Za-z0-9._-]{0,62}[A-Za-z0-9_-])(?:/(?:[A-Za-z0-9]|[A-Za-z0-9.][A-Za-z0-9._-]{0,62}[A-Za-z0-9_-]))*)$",
        "description": "Literal repository-relative path, or dot; hidden names and actual source capitalization are admitted. Shared escape/device rules and case-accurate physical no-follow checks additionally apply."
      }
    },
    "gitIgnore": {
      "const": "respect"
    }
  }
}
