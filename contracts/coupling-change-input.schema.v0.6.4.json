{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekalo.dev/contracts/coupling-change-input.schema.v0.6.4.json",
  "title": "Coupling change-input 0.6.4",
  "$ref": "#/$defs/change-input",
  "$defs": {
    "change-input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "lekalo/coupling-change-input/v0.6.4"
        },
        "identity": {
          "const": "dev.lekalo.coupling-change-input@0.6.4"
        },
        "mode": {
          "enum": [
            "committed",
            "index",
            "worktree",
            "mixed"
          ]
        },
        "baseRevision": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "known"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 192,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
                }
              },
              "required": [
                "state",
                "value"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "unknown"
                }
              },
              "required": [
                "state"
              ]
            }
          ]
        },
        "candidateRevision": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "known"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 192,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
                }
              },
              "required": [
                "state",
                "value"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "unknown"
                }
              },
              "required": [
                "state"
              ]
            }
          ]
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "symbolIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 192,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
                },
                "maxItems": 2000,
                "uniqueItems": true
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "entity": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 192,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
                    },
                    "field": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 192,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
                    },
                    "change": {
                      "enum": [
                        "removed",
                        "type-narrowed"
                      ]
                    }
                  },
                  "required": [
                    "entity",
                    "field",
                    "change"
                  ]
                },
                "maxItems": 2000,
                "uniqueItems": true
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "fromPath": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "const": "known"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      }
                    },
                    "required": [
                      "state",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "const": "unknown"
                      }
                    },
                    "required": [
                      "state"
                    ]
                  }
                ]
              },
              "change": {
                "enum": [
                  "added",
                  "modified",
                  "deleted",
                  "renamed"
                ]
              },
              "evidence": {
                "enum": [
                  "canonical",
                  "verified",
                  "extracted",
                  "stale",
                  "unknown"
                ]
              }
            },
            "required": [
              "symbolIds",
              "members",
              "path",
              "fromPath",
              "change",
              "evidence"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "identity",
        "mode",
        "baseRevision",
        "candidateRevision",
        "entries"
      ]
    }
  }
}
