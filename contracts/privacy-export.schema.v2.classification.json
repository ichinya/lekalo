    "version": { "const": "1.0.0" },
    "digest": { "const": "sha256:58626d1889990bf6120874fcd194c9fc68f2d81f05af1f3b8f7d04336fb3aa9e" },
    "decisionId": { "type": "string", "pattern": "^classification-sha256:[0-9a-f]{64}$" },
    "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
