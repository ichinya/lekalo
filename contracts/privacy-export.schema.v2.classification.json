{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekalo.dev/contracts/privacy-export.schema.v2.classification.json",
  "schemaId": "dev.lekalo.privacy-classification-decision-schema",
  "version": "1.0.0",
  "lifecycle": {
