{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/impact-report.schema.v0.8.0.json",
  "title": "Lekalo adoption impact report (v0.8.0)",
  "description": "Issue #136 scoped brownfield adoption, selective refactoring, and hybrid mode. Closed Draft 2020-12 contract at the 0.8.0 product generation; the exact discriminator is lekalo/adoption-{family}/v0.8.0 and the schema identity is dev.lekalo.adoption-{family}@0.8.0. The typed opt-in wrapper around one upstream impact result plus the admitted coverage attachment: the exact upstream envelope is preserved verbatim and joined with mode-boundary witnesses (including observed neighbors outside the canonical graph) and explicit coverage gaps. Original impact completeness is never narrowed by the adoption projection.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema_version",
    "identity",
    "upstream",
    "coverage",
    "boundaries",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "lekalo/adoption-impact-report/v0.8.0"
    },
    "identity": {
      "const": "dev.lekalo.adoption-impact-report@0.8.0"
    },
    "upstream": {
      "type": "object"
    },
    "coverage": {
      "$ref": "#/$defs/sha256"
    },
    "boundaries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "mode",
          "witness",
          "freshness"
        ],
        "properties": {
          "symbol": {
            "$ref": "#/$defs/semanticId"
          },
          "mode": {
            "$ref": "#/$defs/effectiveMode"
          },
          "witness": {
            "$ref": "#/$defs/token"
          },
          "freshness": {
            "enum": [
              "fresh",
              "unqualified",
              "stale",
              "unknown"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digestOrNull": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semanticId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "relPath": {
      "allOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[a-z0-9._][a-z0-9._-]*(/[a-z0-9._][a-z0-9._-]*)*$"
        },
        {
          "not": {
            "type": "string",
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        }
      ]
    },
    "nativeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "confidence": {
      "enum": [
        "exact",
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "adapterOrNull": {
      "type": [
        "object",
        "null"
      ],
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "symbol",
            "module",
            "use-case"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        }
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "lock",
        "observed_index",
        "adapter",
        "sources"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "lock": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "observed_index": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "adapter": {
          "type": [
            "object",
            "null"
          ],
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version",
                "digest"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "digest": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "allOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^[a-z0-9._][a-z0-9._-]*(/[a-z0-9._][a-z0-9._-]*)*$"
                  },
                  {
                    "not": {
                      "type": "string",
                      "pattern": "(^|/)\\.\\.?(/|$)"
                    }
                  }
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "sourcePins": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "allOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[a-z0-9._][a-z0-9._-]*(/[a-z0-9._][a-z0-9._-]*)*$"
              },
              {
                "not": {
                  "type": "string",
                  "pattern": "(^|/)\\.\\.?(/|$)"
                }
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "writeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "action",
        "before",
        "after",
        "content"
      ],
      "properties": {
        "path": {
          "allOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[a-z0-9._][a-z0-9._-]*(/[a-z0-9._][a-z0-9._-]*)*$"
            },
            {
              "not": {
                "type": "string",
                "pattern": "(^|/)\\.\\.?(/|$)"
              }
            }
          ]
        },
        "action": {
          "enum": [
            "create",
            "replace"
          ]
        },
        "before": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "after": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "content": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1048576
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journal",
        "snapshots"
      ],
      "properties": {
        "journal": {
          "allOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[a-z0-9._][a-z0-9._-]*(/[a-z0-9._][a-z0-9._-]*)*$"
            },
            {
              "not": {
                "type": "string",
                "pattern": "(^|/)\\.\\.?(/|$)"
              }
            }
          ]
        },
        "snapshots": {
          "allOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[a-z0-9._][a-z0-9._-]*(/[a-z0-9._][a-z0-9._-]*)*$"
            },
            {
              "not": {
                "type": "string",
                "pattern": "(^|/)\\.\\.?(/|$)"
              }
            }
          ]
        }
      }
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "detail"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "effectiveMode": {
      "enum": [
        "observed",
        "contracted-legacy",
        "contracted-new",
        "unbound",
        "conflicting"
      ]
    },
    "bindingRef": {
      "type": [
        "object",
        "null"
      ],
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposal",
            "candidate"
          ],
          "properties": {
            "proposal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "candidate": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
