{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.diagnostic-registry-schema@0.8.0",
  "title": "Lekalo diagnostic registry schema v1",
  "description": "Merged additive union successor: the 522 predecessor entries and the entry grammar are preserved verbatim. Issue #94 adds the closed format.* family (LEK-FORMAT-001..009), issue #136 adds nine adoption.* rules (LEK-ADOPT-001..009) owning service-specific admission, consent, revision, verification, and recovery failures, issue #19 adds nine portability.* diagnostics (LEK-PORT-001..009), issue #51 adds seven worklog-changelog.* diagnostics (LEK-WC-001..007), issue #41 adds the managed.* infrastructure family, issue #52 adds eight tasklink.* diagnostics (LEK-TASKLINK-001..008), issue #113 adds fourteen module-api.* diagnostics (LEK-MODULE-001..014) owning the versioned module public API and dependency-boundary grammar, issue #93 adds eight search.* diagnostics (search.ambiguous, search.coverage-incomplete, search.cursor-invalid, search.index-stale, search.input-invalid, search.query-invalid, search.result-limit, search.version-unsupported) owning semantic-search admission, index, cursor and coverage failures, issue #73 adds the twelve change.* diagnostics (LEK-CHANGE-001..012) owning semantic-change admission, custody, transaction, and history failures, and issue #33 adds eleven mcp.* transport diagnostics (LEK-MCP-001..011) owning the read-only MCP server. Wire diagnostics remain v0.2.16; predecessor producer registries (0.6.4 default, 0.6.5 architecture union) keep their exact pins.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "lekalo/diagnostic-registry/v0.8.0"
    },
    "identity": {
      "const": "dev.lekalo.diagnostic-registry@0.8.0"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "closed": {
      "const": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "schema_version",
    "identity",
    "registry_version",
    "closed",
    "entries"
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "ruleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "maxLength": 128
    },
    "diagnosticCode": {
      "type": "string",
      "pattern": "^LEK-[A-Z][A-Z0-9]{1,11}-[0-9]{3}$"
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ruleId"
        },
        "code": {
          "$ref": "#/$defs/diagnosticCode"
        },
        "category": {
          "enum": [
            "model",
            "semantic",
            "compatibility",
            "adapter",
            "infrastructure",
            "security"
          ]
        },
        "default_severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "allowed_statuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "valid",
              "invalid",
              "denied",
              "unsupported",
              "unavailable",
              "unsupported-version"
            ]
          }
        },
        "message_id": {
          "$ref": "#/$defs/ruleId"
        },
        "default_message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "location_requirement": {
          "enum": [
            "none",
            "path",
            "span"
          ]
        },
        "data_fields": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
              },
              "type": {
                "enum": [
                  "token",
                  "count",
                  "flag",
                  "list",
                  "records",
                  "record"
                ]
              }
            },
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "allowed_fix_ids": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ruleId"
          }
        },
        "lifecycle": {
          "enum": [
            "active",
            "reserved",
            "retired"
          ]
        },
        "replacement": {
          "$ref": "#/$defs/ruleId"
        }
      },
      "required": [
        "id",
        "code",
        "category",
        "default_severity",
        "allowed_statuses",
        "message_id",
        "default_message",
        "location_requirement",
        "data_fields",
        "allowed_fix_ids",
        "lifecycle"
      ],
      "additionalProperties": false
    }
  }
}
