{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekalo.dev/contracts/coupling-profile.schema.v0.6.4.json",
  "title": "Coupling profile 0.6.4",
  "$ref": "#/$defs/profile",
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "lekalo/coupling-profile/v0.6.4"
        },
        "identity": {
          "const": "dev.lekalo.coupling-profile@0.6.4"
        },
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
        },
        "profileRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recipe": {
              "const": "declared-architecture/1"
            },
            "includeObserved": {
              "type": "boolean"
            }
          },
          "required": [
            "recipe",
            "includeObserved"
          ]
        },
        "project": {
          "$ref": "#/$defs/limits"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
              },
              "thresholds": {
                "$ref": "#/$defs/limits"
              }
            },
            "required": [
              "module",
              "thresholds"
            ]
          },
          "maxItems": 2000,
          "uniqueItems": true
        },
        "domainGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
              },
              "modules": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 192,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
                },
                "maxItems": 2000,
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "id",
              "modules"
            ]
          },
          "maxItems": 2000,
          "uniqueItems": true
        },
        "centralityDeclarations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "reviewRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
              },
              "rules": {
                "type": "array",
                "items": {
                  "enum": [
                    "coupling.fan-exceeded",
                    "coupling.public-contract-amplification",
                    "coupling.shared-abstraction-radius"
                  ]
                },
                "maxItems": 3,
                "uniqueItems": true
              }
            },
            "required": [
              "subject",
              "reason",
              "reviewRef",
              "rules"
            ]
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "advisory",
                "strict"
              ]
            },
            "failOn": {
              "type": "array",
              "items": {
                "enum": [
                  "baseline-regression",
                  "required-incomplete",
                  "threshold-exceeded"
                ]
              },
              "maxItems": 3,
              "uniqueItems": true
            },
            "baselineReadyRef": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "const": "known"
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "state",
                    "value"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "const": "unknown"
                    }
                  },
                  "required": [
                    "state"
                  ]
                }
              ]
            }
          },
          "required": [
            "mode",
            "failOn",
            "baselineReadyRef"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "identity",
        "profileId",
        "profileRevision",
        "measurement",
        "project",
        "modules",
        "domainGroups",
        "centralityDeclarations",
        "gate"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "metric": {
                "enum": [
                  "fanInSymbols",
                  "fanOutSymbols",
                  "fanInModules",
                  "fanOutModules",
                  "publicContractsAffected",
                  "internalSymbolsAffected",
                  "semanticSymbolsAffected",
                  "modulesAffected",
                  "affectedArtifacts",
                  "affectedTests",
                  "affectedTargets",
                  "requiredChecks",
                  "crossModuleCycles",
                  "sharedMutableResources",
                  "transactionSpread",
                  "sharedAbstractionRadius",
                  "publicTargetExposure",
                  "duplicationDivergence"
                ]
              },
              "maximum": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "metric",
              "maximum"
            ]
          },
          "maxItems": 18,
          "uniqueItems": true
        },
        "regressionLimits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "metric": {
                "enum": [
                  "fanInSymbols",
                  "fanOutSymbols",
                  "fanInModules",
                  "fanOutModules",
                  "publicContractsAffected",
                  "internalSymbolsAffected",
                  "semanticSymbolsAffected",
                  "modulesAffected",
                  "affectedArtifacts",
                  "affectedTests",
                  "affectedTargets",
                  "requiredChecks",
                  "crossModuleCycles",
                  "sharedMutableResources",
                  "transactionSpread",
                  "sharedAbstractionRadius",
                  "publicTargetExposure",
                  "duplicationDivergence"
                ]
              },
              "absoluteIncrease": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "relativeIncrease": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "const": "known"
                      },
                      "value": {
                        "$ref": "#/$defs/rational"
                      }
                    },
                    "required": [
                      "state",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "const": "unknown"
                      }
                    },
                    "required": [
                      "state"
                    ]
                  }
                ]
              }
            },
            "required": [
              "metric",
              "absoluteIncrease",
              "relativeIncrease"
            ]
          },
          "maxItems": 18,
          "uniqueItems": true
        }
      },
      "required": [
        "limits",
        "regressionLimits"
      ]
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    }
  }
}
