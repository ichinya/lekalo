{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.framework-lift-baseline-schema@0.6.4",
  "description": "Closed local-only recorded evaluation evidence. Simulation is never live agent evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "baselineId",
    "pilot",
    "revision",
    "files",
    "dataSeedDigest",
    "semanticBundleDigest",
    "oracleDigest",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lekalo/framework-lift-baseline/v0.6.4"
    },
    "identity": {
      "const": "dev.lekalo.framework-lift-baseline@0.6.4"
    },
    "baselineId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "pilot": {
      "$ref": "#/$defs/pilot"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "dataSeedDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semanticBundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "oracleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentDigest",
        "role",
        "revision"
      ],
      "properties": {
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "pilot": {
      "enum": [
        "greenfield-contracted",
        "brownfield-observed"
      ]
    }
  }
}
