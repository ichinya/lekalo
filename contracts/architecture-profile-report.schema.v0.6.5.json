{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.architecture-profile-report-schema@0.6.5",
  "title": "Lekalo architecture-profile-report 0.6.5",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "lekalo/architecture-profile-report/v0.6.5"
    },
    "identity": {
      "const": "dev.lekalo.architecture-profile-report@0.6.5"
    },
    "recipe": {
      "const": "architecture-core/1"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "documentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "modelRef": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "irRef": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "snapshotRef": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resolved"
      },
      "maxItems": 256,
      "minItems": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "maxItems": 10000,
      "minItems": 0
    },
    "baselineRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unknown"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        }
      ]
    },
    "assessment": {
      "enum": [
        "advisory",
        "denied",
        "adopting",
        "enforced-core"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "recipe",
    "scope",
    "documentDigest",
    "modelRef",
    "irRef",
    "snapshotRef",
    "profiles",
    "rows",
    "baselineRef",
    "assessment"
  ],
  "additionalProperties": false,
  "$defs": {
    "limit": {
      "type": "object",
      "properties": {
        "maximum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "calibrationRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:/@-]+$",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "maximum",
        "calibrationRef"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:/@-]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:/@-]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "resolved": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "lekalo/architecture-profile-resolved/v0.6.5"
        },
        "identity": {
          "const": "dev.lekalo.architecture-profile-resolved@0.6.5"
        },
        "profileRef": {
          "$ref": "#/$defs/reference"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "catalogRef": {
          "$ref": "#/$defs/reference"
        },
        "chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "maxItems": 8,
          "minItems": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selection"
          },
          "maxItems": 15,
          "minItems": 15
        }
      },
      "required": [
        "schemaVersion",
        "identity",
        "profileRef",
        "sourceDigest",
        "catalogRef",
        "chain",
        "rules"
      ],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "properties": {
        "ruleId": {
          "enum": [
            "architecture.bounded-context",
            "architecture.deterministic-generation",
            "architecture.errors-as-contracts",
            "architecture.explicit-dependencies",
            "architecture.explicit-operation-contracts",
            "architecture.explicit-target-bindings",
            "architecture.immutable-defaults",
            "architecture.justified-abstractions",
            "architecture.no-hidden-observers",
            "architecture.no-service-locator-magic",
            "architecture.scenario-linked-behavior",
            "architecture.single-entrypoint",
            "architecture.stable-semantic-ids",
            "architecture.strict-native-types",
            "architecture.tracked-duplication"
          ]
        },
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:/@-]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "producer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:/@-]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "measurement": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:/@-]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unsupported",
            "disabled"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "known"
                },
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "state",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "unknown"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "unsupported"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "withheld"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            }
          ]
        },
        "witnesses": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/@-]+$",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 10000,
          "minItems": 0
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "limit": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "known"
                },
                "value": {
                  "$ref": "#/$defs/limit"
                }
              },
              "required": [
                "state",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "unknown"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            }
          ]
        },
        "disposition": {
          "enum": [
            "disabled",
            "observed",
            "evidence-gap",
            "violation",
            "adopted"
          ]
        },
        "conditionDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "alternative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      },
      "required": [
        "ruleId",
        "module",
        "producer",
        "measurement",
        "coverage",
        "value",
        "witnesses",
        "severity",
        "required",
        "limit",
        "disposition",
        "conditionDigest",
        "rationale",
        "alternative"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "project",
            "module"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:/@-]+$",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "architecture.bounded-context",
            "architecture.deterministic-generation",
            "architecture.errors-as-contracts",
            "architecture.explicit-dependencies",
            "architecture.explicit-operation-contracts",
            "architecture.explicit-target-bindings",
            "architecture.immutable-defaults",
            "architecture.justified-abstractions",
            "architecture.no-hidden-observers",
            "architecture.no-service-locator-magic",
            "architecture.scenario-linked-behavior",
            "architecture.single-entrypoint",
            "architecture.stable-semantic-ids",
            "architecture.strict-native-types",
            "architecture.tracked-duplication"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "limit": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "known"
                },
                "value": {
                  "$ref": "#/$defs/limit"
                }
              },
              "required": [
                "state",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "unknown"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "enabled",
        "severity",
        "required",
        "limit"
      ],
      "additionalProperties": false
    }
  }
}
