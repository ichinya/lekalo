{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekalo.dev/contracts/privacy-export.schema.v2.3.json",
  "schemaId": "dev.lekalo.privacy-export-input-schema",
  "version": "2.3.0",
  "title": "Lekalo ExportDecisionInput",
  "description": "Strict, closed, metadata-only input for accepted privacy policy 1.0.4 with purpose-bound authorizing evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionContractRef",
    "authorityRef",
    "policyRef",
    "authorizingEvidenceContractRef",
    "artifactKind",
    "artifactRef",
    "operation",
    "source",
    "destination",
    "audience",
    "dataSensitivity",
    "exportDisposition",
    "provenance",
    "resourcePath",
    "conflictResolution",
    "constraints",
    "broadeningGrant"
  ],
  "properties": {
    "decisionContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "version"
      ],
      "properties": {
        "contractId": {
          "const": "dev.lekalo.privacy-export-decision"
        },
        "version": {
          "const": "1.3.0"
        }
      }
    },
    "authorityRef": {
      "$ref": "#/$defs/authorityRef"
    },
    "policyRef": {
      "$ref": "#/$defs/policyRef"
    },
    "artifactKind": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "enum": [
            "local-use",
            "repository-store",
            "derive",
            "transfer",
            "publish"
          ]
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryRole",
        "repositoryRef"
      ],
      "properties": {
        "repositoryRole": {
          "$ref": "#/$defs/repositoryRole"
        },
        "repositoryRef": {
          "$ref": "#/$defs/repositoryRef"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryRole",
        "repositoryRef",
        "trustBoundary",
        "repositoryRelation",
        "tenantRelation"
      ],
      "properties": {
        "repositoryRole": {
          "$ref": "#/$defs/repositoryRole"
        },
        "trustBoundary": {
          "enum": [
            "same-local-workspace",
            "same-repository",
            "same-tenant",
            "cross-repository",
            "cross-tenant",
            "public"
          ]
        },
        "repositoryRelation": {
          "enum": [
            "not-applicable",
            "same-origin",
            "different-repository"
          ]
        },
        "tenantRelation": {
          "enum": [
            "same-tenant",
            "cross-tenant",
            "not-applicable"
          ]
        },
        "repositoryRef": {
          "$ref": "#/$defs/repositoryRef"
        }
      }
    },
    "audience": {
      "enum": [
        "operator-only",
        "repository-collaborators",
        "tenant-members",
        "named-external",
        "public"
      ]
    },
    "dataSensitivity": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "personal-pii",
          "credential-secret",
          "financial",
          "health-special-category",
          "tenant-scoped",
          "retention-limited"
        ]
      }
    },
    "exportDisposition": {
      "enum": [
        "local-private",
        "consumer-repository-only",
        "shareable-with-redaction",
        "public-aggregate",
        "public-fixture",
        "forbidden-to-export"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "resourcePath": {
      "$ref": "#/$defs/pathRepresentation"
    },
    "valueState": {
      "$ref": "#/$defs/valueState"
    },
    "conflictResolution": {
      "$ref": "#/$defs/conflictResolution"
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      },
      "uniqueItems": true
    },
    "broadeningGrant": {
      "type": "null"
    },
    "derivedArtifact": {
      "$ref": "#/$defs/derivedArtifact"
    },
    "authorizingEvidenceContractRef": {
      "$ref": "#/$defs/authorizingEvidenceContractRef"
    },
    "artifactRef": {
      "$ref": "#/$defs/artifactRef"
    }
  },
  "$defs": {
    "authorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "version",
        "digest"
      ],
      "properties": {
        "contractId": {
          "const": "dev.lekalo.authority-matrix"
        },
        "version": {
          "const": "1.3.1"
        },
        "digest": {
          "const": "sha256:5c96ed68fe27956512b6de37e0fa23d223e4430d391b6a5869b12d2a8cb522d3"
        }
      }
    },
    "policyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "version",
        "digest"
      ],
      "properties": {
        "policyId": {
          "const": "dev.lekalo.privacy-export-policy"
        },
        "version": {
          "const": "1.0.4"
        },
        "digest": {
          "const": "sha256:259cf596fcdc38423fa45d1df0937e85591569621c481197f3940f894bbc4ce5"
        }
      }
    },
    "repositoryRole": {
      "enum": [
        "local-workspace",
        "consumer-repository",
        "lekalo-repository",
        "openspec-repository",
        "ai-factory-repository",
        "hlv-repository",
        "source-native-repository",
        "external-repository",
        "public-channel"
      ]
    },
    "auditRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "evidenceDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "repositoryRole",
        "repositoryRef",
        "synthetic",
        "derived",
        "classificationRef",
        "publicFixturePermissionRef",
        "publicFixtureLicenseRef",
        "publicFixtureConsentRef",
        "consumerAclPermissionRef",
        "consumerRepositoryConsentRef",
        "exportTransferConsentRef"
      ],
      "properties": {
        "origin": {
          "enum": [
            "synthetic",
            "consumer-repository",
            "lekalo-repository",
            "tool-runtime",
            "derived",
            "external"
          ]
        },
        "repositoryRole": {
          "$ref": "#/$defs/repositoryRole"
        },
        "synthetic": {
          "type": "boolean"
        },
        "derived": {
          "type": "boolean"
        },
        "classificationRef": {
          "$ref": "#/$defs/classificationRef"
        },
        "repositoryRef": {
          "$ref": "#/$defs/repositoryRef"
        },
        "publicFixturePermissionRef": {
          "$ref": "#/$defs/nullablePublicFixturePermissionEvidence"
        },
        "publicFixtureLicenseRef": {
          "$ref": "#/$defs/nullablePublicFixtureLicenseEvidence"
        },
        "publicFixtureConsentRef": {
          "$ref": "#/$defs/nullablePublicFixtureConsentEvidence"
        },
        "consumerAclPermissionRef": {
          "$ref": "#/$defs/nullableConsumerAclPermissionEvidence"
        },
        "consumerRepositoryConsentRef": {
          "$ref": "#/$defs/nullableConsumerRepositoryConsentEvidence"
        },
        "exportTransferConsentRef": {
          "$ref": "#/$defs/nullableExportTransferConsentEvidence"
        }
      }
    },
    "pathRepresentation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "unknown",
                "withheld",
                "unsupported"
              ]
            }
          }
        }
      ]
    },
    "valueState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": [
                "number",
                "string",
                "boolean",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "unknown",
                "withheld",
                "unsupported"
              ]
            }
          }
        }
      ]
    },
    "conflictResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "decisionRef"
      ],
      "properties": {
        "state": {
          "enum": [
            "none",
            "resolved-allow",
            "resolved-deny",
            "unresolved"
          ]
        },
        "decisionRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/conflictResolutionEvidence"
            }
          ]
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "constraintRef",
        "allowedOperations",
        "allowedTrustBoundaries",
        "allowedAudiences"
      ],
      "properties": {
        "scope": {
          "enum": [
            "project",
            "profile",
            "operation"
          ]
        },
        "constraintRef": {
          "$ref": "#/$defs/auditRef"
        },
        "allowedOperations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "local-use",
              "repository-store",
              "derive",
              "transfer",
              "publish"
            ]
          }
        },
        "allowedTrustBoundaries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "same-local-workspace",
              "same-repository",
              "same-tenant",
              "cross-repository",
              "cross-tenant",
              "public"
            ]
          }
        },
        "allowedAudiences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "operator-only",
              "repository-collaborators",
              "tenant-members",
              "named-external",
              "public"
            ]
          }
        }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRef",
        "artifactKind",
        "authorityRef",
        "policyRef",
        "classificationRef",
        "dataSensitivity",
        "exportDisposition"
      ],
      "properties": {
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "artifactKind": {
          "type": "string",
          "minLength": 1
        },
        "authorityRef": {
          "$ref": "#/$defs/authorityRef"
        },
        "policyRef": {
          "$ref": "#/$defs/policyRef"
        },
        "classificationRef": {
          "$ref": "#/$defs/classificationRef"
        },
        "dataSensitivity": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "personal-pii",
              "credential-secret",
              "financial",
              "health-special-category",
              "tenant-scoped",
              "retention-limited"
            ]
          }
        },
        "exportDisposition": {
          "enum": [
            "local-private",
            "consumer-repository-only",
            "shareable-with-redaction",
            "public-aggregate",
            "public-fixture",
            "forbidden-to-export"
          ]
        }
      }
    },
    "appliedTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transformId",
        "version",
        "evidenceDigest"
      ],
      "properties": {
        "transformId": {
          "enum": [
            "redact-content",
            "redact-secrets",
            "redact-pii",
            "aggregate-no-source-rows",
            "replace-repository-identity",
            "normalize-project-relative-paths"
          ]
        },
        "version": {
          "const": "1.0.0"
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "declassificationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyRef",
        "decisionRef",
        "version",
        "removedSensitivities"
      ],
      "properties": {
        "policyRef": {
          "$ref": "#/$defs/policyRef"
        },
        "decisionRef": {
          "$ref": "#/$defs/declassificationEvidence"
        },
        "version": {
          "const": "1.0.0"
        },
        "removedSensitivities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "personal-pii",
              "credential-secret",
              "financial",
              "health-special-category",
              "tenant-scoped",
              "retention-limited"
            ]
          }
        }
      }
    },
    "aggregationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyRef",
        "decisionRef",
        "version",
        "removesSourceRows",
        "removesSourceIdentities"
      ],
      "properties": {
        "policyRef": {
          "$ref": "#/$defs/policyRef"
        },
        "decisionRef": {
          "$ref": "#/$defs/aggregationEvidence"
        },
        "version": {
          "const": "1.0.0"
        },
        "removesSourceRows": {
          "const": true
        },
        "removesSourceIdentities": {
          "const": true
        }
      }
    },
    "derivedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceArtifacts",
        "appliedTransforms",
        "declassificationDecision",
        "aggregationDecision",
        "containsSourceRows",
        "containsSourceIdentities",
        "reevaluated"
      ],
      "properties": {
        "sourceArtifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceArtifact"
          }
        },
        "appliedTransforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/appliedTransform"
          }
        },
        "declassificationDecision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/declassificationDecision"
            }
          ]
        },
        "aggregationDecision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/aggregationDecision"
            }
          ]
        },
        "containsSourceRows": {
          "type": "boolean"
        },
        "containsSourceIdentities": {
          "type": "boolean"
        },
        "reevaluated": {
          "type": "boolean"
        }
      }
    },
    "repositoryRef": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^repo-sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^source-sha256:[0-9a-f]{64}$"
    },
    "classificationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "version",
        "digest",
        "decisionId",
        "evidenceDigest"
      ],
      "properties": {
        "contractId": {
          "const": "dev.lekalo.privacy-classification-decision"
        },
        "version": {
          "const": "1.0.0"
        },
        "digest": {
          "const": "sha256:58626d1889990bf6120874fcd194c9fc68f2d81f05af1f3b8f7d04336fb3aa9e"
        },
        "decisionId": {
          "type": "string",
          "pattern": "^classification-sha256:[0-9a-f]{64}$"
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "authorizingEvidenceContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "version",
        "digest"
      ],
      "properties": {
        "contractId": {
          "const": "dev.lekalo.privacy-authorizing-evidence"
        },
        "version": {
          "const": "1.0.0"
        },
        "digest": {
          "const": "sha256:5fc226843be9913327586ec02603eddec5dc7ea8dfdc066dc6bfb132c09187b6"
        }
      }
    },
    "artifactRef": {
      "type": "string",
      "pattern": "^artifact-sha256:[0-9a-f]{64}$"
    },
    "authorizingEvidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactRef",
        "artifactKind",
        "operation",
        "authorityRef",
        "policyRef",
        "source",
        "destination",
        "audience",
        "sourceRefs"
      ],
      "properties": {
        "artifactRef": {
          "$ref": "#/$defs/artifactRef"
        },
        "artifactKind": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "enum": [
                "local-use",
                "repository-store",
                "derive",
                "transfer",
                "publish"
              ]
            },
            "version": {
              "const": "1.0.0"
            }
          }
        },
        "authorityRef": {
          "$ref": "#/$defs/authorityRef"
        },
        "policyRef": {
          "$ref": "#/$defs/policyRef"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositoryRole",
            "repositoryRef"
          ],
          "properties": {
            "repositoryRole": {
              "$ref": "#/$defs/repositoryRole"
            },
            "repositoryRef": {
              "$ref": "#/$defs/repositoryRef"
            }
          }
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositoryRole",
            "repositoryRef",
            "trustBoundary",
            "repositoryRelation",
            "tenantRelation"
          ],
          "properties": {
            "repositoryRole": {
              "$ref": "#/$defs/repositoryRole"
            },
            "repositoryRef": {
              "$ref": "#/$defs/repositoryRef"
            },
            "trustBoundary": {
              "enum": [
                "same-local-workspace",
                "same-repository",
                "same-tenant",
                "cross-repository",
                "cross-tenant",
                "public"
              ]
            },
            "repositoryRelation": {
              "enum": [
                "not-applicable",
                "same-origin",
                "different-repository"
              ]
            },
            "tenantRelation": {
              "enum": [
                "same-tenant",
                "cross-tenant",
                "not-applicable"
              ]
            }
          }
        },
        "audience": {
          "enum": [
            "operator-only",
            "repository-collaborators",
            "tenant-members",
            "named-external",
            "public"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "publicFixturePermissionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "version",
        "digest",
        "evidenceKind",
        "purpose",
        "outcome",
        "evidenceId",
        "verificationState",
        "freshnessState",
        "binding"
      ],
      "properties": {
        "contractId": {
          "const": "dev.lekalo.privacy-authorizing-evidence"
        },
        "version": {
          "const": "1.0.0"
        },
        "digest": {
          "const": "sha256:5fc226843be9913327586ec02603eddec5dc7ea8dfdc066dc6bfb132c09187b6"
        },
        "evidenceKind": {
          "const": "public-fixture-permission"
        },
        "purpose": {
          "const": "authorize-public-fixture-permission"
        },
        "outcome": {
          "enum": [
            "granted",
            "denied"
          ]
        },
        "evidenceId": {
          "type": "string",
          "pattern": "^evidence-sha256:[0-9a-f]{64}$"
        },
        "verificationState": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "freshnessState": {
          "enum": [
            "current",
            "stale",
            "expired"
          ]
        },
        "binding": {
          "$ref": "#/$defs/authorizingEvidenceBinding"
        }
      }
    },
    "publicFixtureLicenseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "version",
        "digest",
        "evidenceKind",
        "purpose",
        "outcome",
        "evidenceId",
        "verificationState",
        "freshnessState",
        "binding"
      ],
      "properties": {
        "contractId": {
          "const": "dev.lekalo.privacy-authorizing-evidence"
        },
        "version": {
          "const": "1.0.0"
        },
        "digest": {
          "const": "sha256:5fc226843be9913327586ec02603eddec5dc7ea8dfdc066dc6bfb132c09187b6"
        },
        "evidenceKind": {
          "const": "public-fixture-license"
        },
        "purpose": {
          "const": "authorize-public-fixture-license"
        },
        "outcome": {
          "enum": [
            "licensed",
            "unlicensed"
          ]
        },
        "evidenceId": {
          "type": "string",
          "pattern": "^evidence-sha256:[0-9a-f]{64}$"
        },
        "verificationState": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "freshnessState": {
          "enum": [
            "current",
            "stale",
            "expired"
          ]
