{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/nfr-report.schema.v0.4.0.json",
  "title": "Lekalo NFR Resolution Report",
  "description": "Closed derived read-only resolution report for NFR constraints (issue #85): per-constraint statuses computed as a pure function of the constraint attachment, the supplied evidence sets, the resolved capability snapshot, and the injected as-of reference date. `unverified` is a first-class computed status: no wire spelling lets a document assert satisfaction. Evidence rows are keyed per exact environment identity; results from incompatible environments stay visible under their own key and never satisfy. The runtime and ai-budget dimensions are rendered as disjoint sections. The contract is independent of the product release, of the Model/IR/trace/graph contract versions, and of the diagnostic registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "projectId",
    "modelRef",
    "irRef",
    "attachmentDigest",
    "asOf",
    "capabilitiesResolved",
    "verdict",
    "runtime",
    "aiBudget",
    "foreignEvidence",
    "openQuestions",
    "coverageGaps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lekalo/nfr-report/v0.4.0"
    },
    "identity": {
      "const": "dev.lekalo.nfr-report@0.4.0"
    },
    "projectId": {
      "$ref": "#/$defs/projectId"
    },
    "modelRef": {
      "$ref": "#/$defs/modelRef"
    },
    "irRef": {
      "$ref": "#/$defs/irRef"
    },
    "attachmentDigest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "asOf": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "capabilitiesResolved": {
      "type": "boolean"
    },
    "verdict": {
      "enum": ["pass", "denied"]
    },
    "runtime": {
      "$ref": "#/$defs/dimensionSection"
    },
    "aiBudget": {
      "$ref": "#/$defs/dimensionSection"
    },
    "foreignEvidence": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/foreignRow"
      }
    },
    "openQuestions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/openQuestionRow"
      }
    },
    "coverageGaps": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/coverageGapRow"
      }
    }
  },
  "$defs": {
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "not": {
        "enum": ["lekalo", "dev"]
      }
    },
    "semanticId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
    },
    "constraintId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 192,
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-][0-9A-Za-z.-]+)?([+][0-9A-Za-z.-]+)?$"
    },
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelVersion", "digest"],
      "properties": {
        "modelVersion": {
          "const": "0.2.16"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "irRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["irVersion", "digest"],
      "properties": {
        "irVersion": {
          "const": "0.2.16"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "dimensionSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraints"],
      "properties": {
        "constraints": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/constraintRow"
          }
        }
      }
    },
    "constraintRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraintId",
        "kind",
        "scope",
        "enforcement",
        "requirement",
        "revision",
        "status",
        "environments",
        "method"
      ],
      "properties": {
        "constraintId": {
          "$ref": "#/$defs/constraintId"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z-]*$"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref"],
          "properties": {
            "kind": {
              "enum": ["project", "module", "operation", "endpoint"]
            },
            "ref": {
              "$ref": "#/$defs/semanticId"
            }
          }
        },
        "enforcement": {
          "enum": ["mandatory", "advisory"]
        },
        "requirement": {
          "$ref": "#/$defs/requirementSummary"
        },
        "revision": {
          "$ref": "#/$defs/semver"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "environments": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/environmentRow"
          }
        },
        "method": {
          "enum": [
            "benchmark",
            "load-test",
            "soak-test",
            "slo-report",
            "chaos-experiment",
            "synthetic-probe",
            "audit-document",
            "declaration"
          ]
        },
        "gateRef": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*/[a-z][a-z0-9-]*$"
        },
        "sourceRequirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 161,
          "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9-]{0,62}\\.REQ-[a-z0-9][a-z0-9-]{0,63}$"
        }
      }
    },
    "requirementSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "percentile": {
          "enum": ["p50", "p95", "p99"]
        },
        "comparator": {
          "enum": ["lt", "lte", "eq", "gte", "gt", "within", "outside"]
        },
        "value": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "max": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z-]*$"
        },
        "resource": {
          "enum": ["cpu", "memory", "storage", "connections", "threads"]
        },
        "mode": {
          "enum": ["strong", "bounded", "stale-ok", "platform", "topology", "region"]
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
          }
        },
        "maxAttempts": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,8}$"
        },
        "window": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "windowUnit": {
          "enum": ["seconds", "minutes", "hours"]
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "digest"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*/[a-z][a-z0-9-]*$"
            },
            "digest": {
              "$ref": "#/$defs/sha256Digest"
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "satisfied",
        "violated",
        "unverified",
        "stale",
        "foreign-environment",
        "open-question",
        "unsupported",
        "conflict"
      ]
    },
    "environmentRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envKey", "status"],
      "properties": {
        "envKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.:-]{0,127}$"
        },
        "status": {
          "enum": ["satisfied", "violated", "unverified", "stale", "conflict"]
        },
        "measuredOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "foreignRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraintId", "envKey", "reason"],
      "properties": {
        "constraintId": {
          "$ref": "#/$defs/constraintId"
        },
        "envKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.:-]{0,127}$"
        },
        "reason": {
          "enum": [
            "undeclared-environment",
            "profile-mismatch",
            "adapter-mismatch",
            "runtime-mismatch",
            "platform-mismatch",
            "labels-mismatch"
          ]
        }
      }
    },
    "openQuestionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId"],
      "properties": {
        "questionId": {
          "$ref": "#/$defs/constraintId"
        },
        "relatedConstraint": {
          "$ref": "#/$defs/constraintId"
        }
      }
    },
    "coverageGapRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": {
          "$ref": "#/$defs/semanticId"
        }
      }
    }
  }
}
