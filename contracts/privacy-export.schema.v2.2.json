{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekalo.dev/contracts/privacy-export.schema.v2.2.json",
  "schemaId": "dev.lekalo.privacy-export-input-schema",
  "version": "2.2.0",
  "title": "Lekalo ExportDecisionInput",
  "description": "Strict, closed, metadata-only input for accepted privacy policy 1.0.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionContractRef",
    "authorityRef",
    "policyRef",
    "artifactKind",
    "operation",
    "source",
    "destination",
    "audience",
    "dataSensitivity",
    "exportDisposition",
    "provenance",
    "resourcePath",
    "conflictResolution",
    "constraints",
    "broadeningGrant"
  ],
  "properties": {
    "decisionContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "version"
      ],
      "properties": {
        "contractId": {
          "const": "dev.lekalo.privacy-export-decision"
        },
        "version": {
          "const": "1.2.0"
        }
      }
    },
    "authorityRef": {
      "$ref": "#/$defs/authorityRef"
    },
    "policyRef": {
      "$ref": "#/$defs/policyRef"
    },
    "artifactKind": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "enum": [
            "local-use",
            "repository-store",
            "derive",
            "transfer",
            "publish"
          ]
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryRole",
        "repositoryRef"
      ],
      "properties": {
        "repositoryRole": {
          "$ref": "#/$defs/repositoryRole"
        },
        "repositoryRef": {
          "$ref": "#/$defs/repositoryRef"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryRole",
        "repositoryRef",
        "trustBoundary",
        "repositoryRelation",
        "tenantRelation"
      ],
      "properties": {
        "repositoryRole": {
          "$ref": "#/$defs/repositoryRole"
        },
        "trustBoundary": {
          "enum": [
            "same-local-workspace",
            "same-repository",
            "same-tenant",
            "cross-repository",
            "cross-tenant",
            "public"
          ]
        },
        "repositoryRelation": {
          "enum": [
            "not-applicable",
            "same-origin",
            "different-repository"
          ]
        },
        "tenantRelation": {
          "enum": [
            "same-tenant",
            "cross-tenant",
            "not-applicable"
          ]
        },
        "repositoryRef": {
          "$ref": "#/$defs/repositoryRef"
        }
      }
    },
    "audience": {
      "enum": [
        "operator-only",
        "repository-collaborators",
        "tenant-members",
        "named-external",
        "public"
      ]
    },
    "dataSensitivity": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "personal-pii",
          "credential-secret",
          "financial",
          "health-special-category",
          "tenant-scoped",
          "retention-limited"
        ]
      }
    },
    "exportDisposition": {
      "enum": [
        "local-private",
        "consumer-repository-only",
        "shareable-with-redaction",
        "public-aggregate",
        "public-fixture",
        "forbidden-to-export"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "resourcePath": {
      "$ref": "#/$defs/pathRepresentation"
    },
    "valueState": {
      "$ref": "#/$defs/valueState"
    },
    "conflictResolution": {
      "$ref": "#/$defs/conflictResolution"
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      },
      "uniqueItems": true
    },
    "broadeningGrant": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/broadeningGrant"
        }
      ]
    },
    "derivedArtifact": {
      "$ref": "#/$defs/derivedArtifact"
    }
  },
  "$defs": {
    "authorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "version",
        "digest"
      ],
      "properties": {
        "contractId": {
          "const": "dev.lekalo.authority-matrix"
        },
        "version": {
          "const": "1.3.1"
        },
        "digest": {
          "const": "sha256:5c96ed68fe27956512b6de37e0fa23d223e4430d391b6a5869b12d2a8cb522d3"
        }
      }
    },
    "policyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "version",
        "digest"
      ],
      "properties": {
        "policyId": {
          "const": "dev.lekalo.privacy-export-policy"
        },
        "version": {
          "const": "1.0.3"
        },
        "digest": {
          "const": "sha256:868ced73748caa4ad80a74df0e5d6ad8d3c5463a6593caa4ead09d872160280f"
        }
      }
    },
    "repositoryRole": {
      "enum": [
        "local-workspace",
        "consumer-repository",
        "lekalo-repository",
        "openspec-repository",
        "ai-factory-repository",
        "hlv-repository",
        "source-native-repository",
        "external-repository",
        "public-channel"
      ]
    },
    "auditRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "evidenceDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "nullableAuditRef": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/auditRef"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "repositoryRole",
        "repositoryRef",
        "synthetic",
        "derived",
        "classificationRef",
        "permissionRef",
        "licenseRef",
        "consentRef"
      ],
      "properties": {
        "origin": {
          "enum": [
            "synthetic",
            "consumer-repository",
            "lekalo-repository",
            "tool-runtime",
            "derived",
            "external"
          ]
        },
        "repositoryRole": {
          "$ref": "#/$defs/repositoryRole"
        },
        "synthetic": {
          "type": "boolean"
        },
        "derived": {
          "type": "boolean"
        },
        "classificationRef": {
          "$ref": "#/$defs/classificationRef"
        },
        "permissionRef": {
          "$ref": "#/$defs/nullableAuditRef"
        },
        "licenseRef": {
          "$ref": "#/$defs/nullableAuditRef"
        },
        "consentRef": {
          "$ref": "#/$defs/nullableAuditRef"
        },
        "repositoryRef": {
          "$ref": "#/$defs/repositoryRef"
        }
      }
    },
    "pathRepresentation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "unknown",
                "withheld",
                "unsupported"
              ]
            }
          }
        }
      ]
    },
    "valueState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": [
                "number",
                "string",
                "boolean",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "unknown",
                "withheld",
                "unsupported"
              ]
            }
          }
        }
      ]
    },
    "conflictResolution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "decisionRef"
          ],
          "properties": {
            "state": {
              "enum": [
                "none",
                "unresolved"
              ]
            },
            "decisionRef": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "decisionRef"
          ],
          "properties": {
            "state": {
              "enum": [
                "resolved-allow",
                "resolved-deny"
              ]
            },
            "decisionRef": {
              "$ref": "#/$defs/auditRef"
            }
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "constraintRef",
        "allowedOperations",
        "allowedTrustBoundaries",
        "allowedAudiences"
      ],
      "properties": {
        "scope": {
          "enum": [
            "project",
            "profile",
            "operation"
          ]
        },
        "constraintRef": {
          "$ref": "#/$defs/auditRef"
        },
        "allowedOperations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "local-use",
              "repository-store",
              "derive",
              "transfer",
              "publish"
            ]
          }
        },
        "allowedTrustBoundaries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "same-local-workspace",
              "same-repository",
              "same-tenant",
              "cross-repository",
              "cross-tenant",
              "public"
            ]
          }
        },
        "allowedAudiences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "operator-only",
              "repository-collaborators",
              "tenant-members",
              "named-external",
              "public"
            ]
          }
        }
      }
    },
    "broadeningGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantId",
        "version",
        "policyRef",
        "reviewRef"
      ],
      "properties": {
        "grantId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "policyRef": {
          "$ref": "#/$defs/policyRef"
        },
        "reviewRef": {
          "$ref": "#/$defs/auditRef"
        }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRef",
        "artifactKind",
        "authorityRef",
        "policyRef",
        "classificationRef",
        "dataSensitivity",
        "exportDisposition"
      ],
      "properties": {
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "artifactKind": {
          "type": "string",
          "minLength": 1
        },
        "authorityRef": {
          "$ref": "#/$defs/authorityRef"
        },
        "policyRef": {
          "$ref": "#/$defs/policyRef"
        },
        "classificationRef": {
          "$ref": "#/$defs/classificationRef"
        },
        "dataSensitivity": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "personal-pii",
              "credential-secret",
              "financial",
              "health-special-category",
              "tenant-scoped",
              "retention-limited"
            ]
          }
        },
        "exportDisposition": {
          "enum": [
            "local-private",
            "consumer-repository-only",
            "shareable-with-redaction",
            "public-aggregate",
            "public-fixture",
            "forbidden-to-export"
          ]
        }
      }
    },
    "appliedTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transformId",
        "version",
        "evidenceDigest"
      ],
      "properties": {
        "transformId": {
          "enum": [
            "redact-content",
            "redact-secrets",
            "redact-pii",
            "aggregate-no-source-rows",
            "replace-repository-identity",
            "normalize-project-relative-paths"
          ]
        },
        "version": {
          "const": "1.0.0"
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "declassificationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyRef",
        "decisionRef",
        "version",
        "removedSensitivities"
      ],
      "properties": {
        "policyRef": {
          "$ref": "#/$defs/policyRef"
        },
        "decisionRef": {
          "$ref": "#/$defs/auditRef"
        },
        "version": {
          "const": "1.0.0"
        },
        "removedSensitivities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "personal-pii",
              "credential-secret",
              "financial",
              "health-special-category",
              "tenant-scoped",
              "retention-limited"
            ]
          }
        }
      }
    },
    "aggregationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyRef",
        "decisionRef",
        "version",
        "removesSourceRows",
        "removesSourceIdentities"
      ],
      "properties": {
        "policyRef": {
          "$ref": "#/$defs/policyRef"
        },
        "decisionRef": {
          "$ref": "#/$defs/auditRef"
        },
        "version": {
          "const": "1.0.0"
        },
        "removesSourceRows": {
          "const": true
        },
        "removesSourceIdentities": {
          "const": true
        }
      }
    },
    "derivedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceArtifacts",
        "appliedTransforms",
        "declassificationDecision",
        "aggregationDecision",
        "containsSourceRows",
        "containsSourceIdentities",
        "reevaluated"
      ],
      "properties": {
        "sourceArtifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceArtifact"
          }
        },
        "appliedTransforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/appliedTransform"
          }
        },
        "declassificationDecision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/declassificationDecision"
            }
          ]
        },
        "aggregationDecision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/aggregationDecision"
            }
          ]
        },
        "containsSourceRows": {
          "type": "boolean"
        },
        "containsSourceIdentities": {
          "type": "boolean"
        },
        "reevaluated": {
          "type": "boolean"
        }
      }
    },
    "repositoryRef": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^repo-sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^source-sha256:[0-9a-f]{64}$"
    },
    "classificationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "version",
        "digest",
        "decisionId",
        "evidenceDigest"
      ],
      "properties": {
        "contractId": {
          "const": "dev.lekalo.privacy-classification-decision"
        },
        "version": {
          "const": "1.0.0"
        },
        "digest": {
          "const": "sha256:58626d1889990bf6120874fcd194c9fc68f2d81f05af1f3b8f7d04336fb3aa9e"
        },
        "decisionId": {
          "type": "string",
          "pattern": "^classification-sha256:[0-9a-f]{64}$"
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "lifecycle": {
    "status": "accepted",
    "accepted": true,
    "predecessor": {
      "schemaId": "dev.lekalo.privacy-export-input-schema",
      "version": "2.1.0",
      "rawDigest": "sha256:7f1eb0baa64e9197dc78f433b325f7eb584f47b37416cbb0e0970306aefc631c",
      "status": "yanked-with-policy-1.0.2"
    },
    "compatibility": "shape-closure-and-conflict-coupling-successor",
    "silentMutationAllowed": false
  }
}
