{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekalo.dev/contracts/privacy-export-input.schema.v2.json",
  "schemaId": "dev.lekalo.privacy-export-input-schema",
  "version": "2.0.0",
  "title": "Lekalo ExportDecisionInput",
  "description": "Strict, closed, metadata-only input for privacy policy candidate 1.0.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionContractRef",
    "authorityRef",
    "policyRef",
    "artifactKind",
    "operation",
    "source",
    "destination",
    "audience",
    "dataSensitivity",
    "exportDisposition",
    "provenance",
    "resourcePath",
    "conflictResolution",
    "constraints",
    "broadeningGrant"
  ],
  "properties": {
    "decisionContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "version"],
      "properties": {
        "contractId": { "const": "dev.lekalo.privacy-export-decision" },
        "version": { "const": "1.0.0" }
      }
    },
    "authorityRef": { "$ref": "#/$defs/authorityRef" },
    "policyRef": { "$ref": "#/$defs/policyRef" },
    "artifactKind": { "type": "string", "minLength": 1 },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "enum": ["local-use", "repository-store", "derive", "transfer", "publish"] },
        "version": { "const": "1.0.0" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryRole"],
      "properties": {
        "repositoryRole": { "$ref": "#/$defs/repositoryRole" }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryRole", "trustBoundary", "repositoryRelation", "tenantRelation"],
      "properties": {
        "repositoryRole": { "$ref": "#/$defs/repositoryRole" },
        "trustBoundary": {
          "enum": ["same-local-workspace", "same-repository", "same-tenant", "cross-repository", "cross-tenant", "public"]
        },
        "repositoryRelation": { "enum": ["not-applicable", "same-origin", "different-repository"] },
        "tenantRelation": { "enum": ["same-tenant", "cross-tenant", "not-applicable"] }
      }
    },
    "audience": { "enum": ["operator-only", "repository-collaborators", "tenant-members", "named-external", "public"] },
    "dataSensitivity": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["public", "internal", "confidential", "personal-pii", "credential-secret", "financial", "health-special-category", "tenant-scoped", "retention-limited"]
      }
    },
    "exportDisposition": {
      "enum": ["local-private", "consumer-repository-only", "shareable-with-redaction", "public-aggregate", "public-fixture", "forbidden-to-export"]
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "resourcePath": { "$ref": "#/$defs/pathRepresentation" },
    "valueState": { "$ref": "#/$defs/valueState" },
    "conflictResolution": { "$ref": "#/$defs/conflictResolution" },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" }
    },
    "broadeningGrant": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/broadeningGrant" }
      ]
    },
    "derivedArtifact": { "$ref": "#/$defs/derivedArtifact" }
  },
  "$defs": {
    "authorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "version", "digest"],
      "properties": {
        "contractId": { "const": "dev.lekalo.authority-matrix" },
        "version": { "const": "1.3.1" },
        "digest": { "const": "sha256:5c96ed68fe27956512b6de37e0fa23d223e4430d391b6a5869b12d2a8cb522d3" }
      }
    },
    "policyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "version", "digest"],
      "properties": {
        "policyId": { "const": "dev.lekalo.privacy-export-policy" },
        "version": { "const": "1.0.1" },
        "digest": { "const": "sha256:f8faab0908fb1bc2da8c173969921000d6424a1f900ab0b04f2b57fa058d0ffb" }
      }
    },
    "repositoryRole": {
      "enum": ["local-workspace", "consumer-repository", "lekalo-repository", "openspec-repository", "ai-factory-repository", "hlv-repository", "source-native-repository", "external-repository", "public-channel"]
    },
    "auditRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "evidenceDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "nullableAuditRef": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/auditRef" }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "repositoryRole", "synthetic", "derived", "classificationRef", "permissionRef", "licenseRef", "consentRef"],
      "properties": {
        "origin": { "enum": ["synthetic", "consumer-repository", "lekalo-repository", "tool-runtime", "derived", "external"] },
        "repositoryRole": { "$ref": "#/$defs/repositoryRole" },
        "synthetic": { "type": "boolean" },
        "derived": { "type": "boolean" },
        "classificationRef": { "$ref": "#/$defs/auditRef" },
        "permissionRef": { "$ref": "#/$defs/nullableAuditRef" },
        "licenseRef": { "$ref": "#/$defs/nullableAuditRef" },
        "consentRef": { "$ref": "#/$defs/nullableAuditRef" }
      }
    },
    "pathRepresentation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "known" },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "enum": ["unknown", "withheld", "unsupported"] }
          }
        }
      ]
    },
    "valueState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "known" },
            "value": { "type": ["number", "string", "boolean", "null"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "enum": ["unknown", "withheld", "unsupported"] }
          }
        }
      ]
    },
    "conflictResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "decisionRef"],
      "properties": {
        "state": { "enum": ["none", "resolved-allow", "resolved-deny", "unresolved"] },
        "decisionRef": { "$ref": "#/$defs/nullableAuditRef" }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "constraintRef", "allowedOperations", "allowedTrustBoundaries", "allowedAudiences"],
      "properties": {
        "scope": { "enum": ["project", "profile", "operation"] },
        "constraintRef": { "$ref": "#/$defs/auditRef" },
        "allowedOperations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["local-use", "repository-store", "derive", "transfer", "publish"] }
        },
        "allowedTrustBoundaries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["same-local-workspace", "same-repository", "same-tenant", "cross-repository", "cross-tenant", "public"] }
        },
        "allowedAudiences": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["operator-only", "repository-collaborators", "tenant-members", "named-external", "public"] }
        }
      }
    },
    "broadeningGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantId", "version", "policyRef", "reviewRef"],
      "properties": {
        "grantId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "policyRef": { "$ref": "#/$defs/policyRef" },
        "reviewRef": { "$ref": "#/$defs/auditRef" }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "authorityRef", "policyRef", "classificationRef", "dataSensitivity", "exportDisposition"],
      "properties": {
        "artifactKind": { "type": "string", "minLength": 1 },
        "authorityRef": { "$ref": "#/$defs/authorityRef" },
        "policyRef": { "$ref": "#/$defs/policyRef" },
        "classificationRef": { "$ref": "#/$defs/auditRef" },
        "dataSensitivity": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "exportDisposition": { "type": "string", "minLength": 1 }
      }
    },
    "appliedTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transformId", "version", "evidenceDigest"],
      "properties": {
        "transformId": { "enum": ["redact-content", "redact-secrets", "redact-pii", "aggregate-no-source-rows", "replace-repository-identity", "normalize-project-relative-paths"] },
        "version": { "const": "1.0.0" },
        "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "declassificationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyRef", "decisionRef", "version", "removedSensitivities"],
      "properties": {
        "policyRef": { "$ref": "#/$defs/policyRef" },
        "decisionRef": { "$ref": "#/$defs/auditRef" },
        "version": { "const": "1.0.0" },
        "removedSensitivities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "aggregationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyRef", "decisionRef", "version", "removesSourceRows", "removesSourceIdentities"],
      "properties": {
        "policyRef": { "$ref": "#/$defs/policyRef" },
        "decisionRef": { "$ref": "#/$defs/auditRef" },
        "version": { "const": "1.0.0" },
        "removesSourceRows": { "const": true },
        "removesSourceIdentities": { "const": true }
      }
    },
    "derivedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceArtifacts", "appliedTransforms", "declassificationDecision", "aggregationDecision", "containsSourceRows", "containsSourceIdentities", "reevaluated"],
      "properties": {
        "sourceArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceArtifact" }
        },
        "appliedTransforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/appliedTransform" }
        },
        "declassificationDecision": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/declassificationDecision" }
          ]
        },
        "aggregationDecision": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/aggregationDecision" }
          ]
        },
        "containsSourceRows": { "type": "boolean" },
        "containsSourceIdentities": { "type": "boolean" },
        "reevaluated": { "type": "boolean" }
      }
    }
  }
}
