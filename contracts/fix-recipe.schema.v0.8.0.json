{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/fix-recipe.schema.v0.8.0.json",
  "title": "lekalo/fix-recipe/v0.8.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "id", "version", "class", "owner", "target", "diagnosticCodes", "explanation", "preconditions", "scope", "operation", "postValidation"],
  "properties": {
    "schemaVersion": {"const": "lekalo/fix-recipe/v0.8.0"},
    "identity": {"const": "dev.lekalo.fix-recipe@0.8.0"},
    "id": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
    "version": {"type": "string", "maxLength": 32, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "class": {"enum": ["safe", "unsafe", "breaking", "manual-only"]},
    "owner": {"type": "string", "maxLength": 80, "pattern": "^(core|user|adapter\\.[a-z][a-z0-9-]*)$"},
    "target": {"anyOf": [{"type": "null"}, {"type": "string", "maxLength": 63, "pattern": "^[a-z][a-z0-9-]*$"}]},
    "diagnosticCodes": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^LEK-[A-Z][A-Z0-9-]*-[0-9]{3}$"}},
    "explanation": {"type": "string", "minLength": 1, "maxLength": 1024},
    "preconditions": {
      "type": "object", "additionalProperties": false, "required": ["sourceFingerprint"],
      "properties": {"sourceFingerprint": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]}}
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["operations", "subjects"],
      "properties": {
        "operations": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"}},
        "subjects": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    },
    "operation": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "model-format"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "request"], "properties": {"kind": {"const": "model-change"}, "request": {"$ref": "https://dev.lekalo/change-request.schema.v0.8.0.json"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "manual-only"}}}
      ]
    },
    "postValidation": {"enum": ["format-check", "validate", "manual-only"]}
  },
  "allOf": [
    {
      "if": {"properties": {"class": {"const": "safe"}}, "required": ["class"]},
      "then": {"properties": {"owner": {"const": "core"}, "id": {"const": "core.canonical-format"}, "version": {"const": "1.0.0"}, "operation": {"type": "object", "properties": {"kind": {"const": "model-format"}}, "required": ["kind"]}, "postValidation": {"const": "format-check"}}}
    },
    {
      "if": {"properties": {"class": {"const": "manual-only"}}, "required": ["class"]},
      "then": {"properties": {"operation": {"type": "object", "properties": {"kind": {"const": "manual-only"}}, "required": ["kind"]}, "postValidation": {"const": "manual-only"}, "scope": {"type": "object", "properties": {"operations": {"type": "array", "maxItems": 0}, "subjects": {"type": "array", "maxItems": 0}}}}}
    },
    {
      "if": {"properties": {"class": {"enum": ["unsafe", "breaking"]}}, "required": ["class"]},
      "then": {"properties": {"operation": {"type": "object", "properties": {"kind": {"const": "model-change"}}, "required": ["kind"]}, "postValidation": {"const": "validate"}}}
    }
  ]
}
