{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.framework-lift-task-schema@1.1.0",
  "description": "Closed local-only recorded evaluation successor. Unknown policy and post-run import provenance do not authenticate execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "taskId",
    "taskVersion",
    "taskClass",
    "pilot",
    "baselineRef",
    "requestDigest",
    "oracleDigest",
    "requiredAssertions",
    "regressionAssertions",
    "holdoutAssertions",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lekalo/framework-lift-task/v1.1.0"
    },
    "identity": {
      "const": "dev.lekalo.framework-lift-task@1.1.0"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "taskVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "taskClass": {
      "enum": [
        "priority",
        "status-transition",
        "command-event",
        "authorization",
        "relation-many",
        "idempotency-concurrency",
        "service-extraction"
      ]
    },
    "pilot": {
      "$ref": "#/$defs/pilot"
    },
    "baselineRef": {
      "$ref": "#/$defs/ref"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "oracleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requiredAssertions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "regressionAssertions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "holdoutAssertions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "limits": {
      "$ref": "#/$defs/limits"
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTokens",
        "maxToolCalls",
        "deadlineMs",
        "maxFixCycles",
        "maxProviderRetries"
      ],
      "properties": {
        "maxTokens": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unbounded",
                    "unknown"
                  ]
                }
              }
            }
          ]
        },
        "maxToolCalls": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unbounded",
                    "unknown"
                  ]
                }
              }
            }
          ]
        },
        "deadlineMs": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unbounded",
                    "unknown"
                  ]
                }
              }
            }
          ]
        },
        "maxFixCycles": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unbounded",
                    "unknown"
                  ]
                }
              }
            }
          ]
        },
        "maxProviderRetries": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unbounded",
                    "unknown"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "pilot": {
      "enum": [
        "greenfield-contracted",
        "brownfield-observed",
        "public-synthetic-observed"
      ]
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
