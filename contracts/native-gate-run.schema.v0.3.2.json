{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/native-gate-run.schema.v0.3.2.json",
  "title": "Lekalo Native Gate Run Request and Receipt",
  "description": "Closed contract for one native gate run request and its terminal receipt (issue #48). The run request names one exact approved plan digest with an explicit or checked-in approval that lives outside the hashed plan — a plan can never approve itself — plus the trusted fixture catalog reference for the test-only runner. The receipt is the terminal, exactly-once result: the closed outcome set distinguishes passed, failed, missing, blocked, unsupported, infrastructure and security; per-command results carry valueState measurements (a never-executed command reports unknown, never a fabricated zero); mutation, original-verification and cleanup sections propagate security and cleanup defects over any gate exit; and portable evidence carries repository-relative paths only.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/runRequest" },
    { "$ref": "#/$defs/runResult" }
  ],
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9.][a-z0-9._-]{0,63}=[a-z0-9@/._-]{1,192}$",
      "maxLength": 256
    },
    "logicalPath": {
      "type": "string",
      "pattern": "^(?!(?:.*[/])?(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:[./]|$))(?!(?:.*[/])?\\.{1,2}(?:/|$))(?!.*\\.(?:/|$))[a-z0-9.][a-z0-9._-]{0,63}(?:/[a-z0-9.][a-z0-9._-]{0,63})*$",
      "maxLength": 512
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "authorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "version", "digest"],
      "properties": {
        "contractId": { "const": "dev.lekalo.authority-matrix" },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "policyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "version", "digest"],
      "properties": {
        "policyId": { "const": "dev.lekalo.privacy-export-policy" },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "executionPolicyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 128
        },
        "version": { "$ref": "#/$defs/contractVersion" },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "runRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "plan_ref",
        "approved_plan_digest",
        "approval",
        "fixture_catalog_ref"
      ],
      "properties": {
        "schema_version": {
          "const": "lekalo/native-gate-run/v0.3.2"
        },
        "kind": {
          "const": "native-run-request"
        },
        "plan_ref": { "$ref": "#/$defs/logicalPath" },
        "approved_plan_digest": { "$ref": "#/$defs/sha256Digest" },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "subject_ref", "policy_digest"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["explicit", "checked-in-policy"]
            },
            "subject_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "policy_digest": { "$ref": "#/$defs/sha256Digest" },
            "rule_ref": { "$ref": "#/$defs/sha256Digest" }
          }
        },
        "fixture_catalog_ref": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "runResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "plan_digest",
        "execution_policy_ref",
        "authority_ref",
        "policy_ref",
        "outcome",
        "reason_codes",
        "commands",
        "mutation_summary",
        "original_verification",
        "cleanup",
        "capability_evidence"
      ],
      "properties": {
        "schema_version": {
          "const": "lekalo/native-gate-run/v0.3.2"
        },
        "kind": {
          "const": "native-run-result"
        },
        "plan_digest": { "$ref": "#/$defs/sha256Digest" },
        "execution_policy_ref": { "$ref": "#/$defs/executionPolicyRef" },
        "authority_ref": { "$ref": "#/$defs/authorityRef" },
        "policy_ref": { "$ref": "#/$defs/policyRef" },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "maxLength": 64
          }
        },
        "commands": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/commandResult" }
        },
        "mutation_summary": { "$ref": "#/$defs/mutationSummary" },
        "original_verification": { "$ref": "#/$defs/originalVerification" },
        "cleanup": { "$ref": "#/$defs/cleanup" },
        "capability_evidence": { "$ref": "#/$defs/capabilityEvidence" },
        "provenance": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "missing",
        "blocked",
        "unsupported",
        "infrastructure",
        "security"
      ]
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "package_id",
        "cwd",
        "tool_ref",
        "argv",
        "env_names",
        "outcome"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "maxLength": 128
        },
        "package_id": { "$ref": "#/$defs/packageId" },
        "cwd": { "$ref": "#/$defs/logicalPath" },
        "tool_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "argv": { "$ref": "#/$defs/argv" },
        "env_names": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "maxLength": 64
          }
        },
        "env_recipe_digest": { "$ref": "#/$defs/sha256Digest" },
        "tool_version": {
          "oneOf": [
            { "$ref": "#/$defs/contractVersion" },
            { "const": "unknown" }
          ]
        },
        "exit": { "$ref": "#/$defs/valueState" },
        "duration_ms": { "$ref": "#/$defs/valueState" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "reason_codes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "maxLength": 64
          }
        },
        "output_ref": {
          "oneOf": [
            { "$ref": "#/$defs/sha256Digest" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state"],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": ["withheld", "unknown"]
                }
              }
            }
          ]
        }
      }
    },
    "valueState": {
      "description": "A measured value with the #120 valueState vocabulary: a never-executed command reports unknown/unsupported/withheld, never a fabricated zero; a real zero is known.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "known" },
            "value": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "type": "string",
              "enum": ["unknown", "unsupported", "withheld"]
            }
          }
        }
      ]
    },
    "mutationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "modified", "deleted", "unexpected"],
      "properties": {
        "created": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "$ref": "#/$defs/logicalPath" },
              "digest": { "$ref": "#/$defs/sha256Digest" }
            }
          }
        },
        "modified": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "$ref": "#/$defs/logicalPath" },
              "digest": { "$ref": "#/$defs/sha256Digest" }
            }
          }
        },
        "deleted": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/logicalPath" }
        },
        "unexpected": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/logicalPath" }
        }
      }
    },
    "originalVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["unchanged", "mutated", "unverifiable"]
        },
        "mutated_paths": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/logicalPath" }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["complete", "failed", "deferred", "unknown"]
        },
        "detail": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "capabilityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_denial", "process_containment"],
      "properties": {
        "network_denial": {
          "type": "string",
          "enum": ["enforced", "unavailable", "unknown"]
        },
        "process_containment": {
          "type": "string",
          "enum": ["enforced", "unavailable", "unknown"]
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "receipt_digest": { "$ref": "#/$defs/sha256Digest" }
      }
    }
  }
}
