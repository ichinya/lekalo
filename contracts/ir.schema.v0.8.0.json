{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.ir-schema@0.8.0",
  "title": "Lekalo compiled-IR schema v1 (0.8.0 successor)",
  "description": "The explicit closed schema of the canonical compiled IR for Model 0.8.0 sources (contract dev.lekalo.ir@0.8.0): compact JSON, byte-sorted object keys, semantic-ID-ordered definitions and modules, and the successor's typed relation and secondary-uniqueness facts carried on entity definitions. A 0.2.16 source never produces this contract: its IR stays dev.lekalo.ir@0.2.16 with byte-identical canonical bytes and no relation or uniqueness members. No alias under 0.2.16 exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "definitions",
    "modelVersion",
    "modules"
  ],
  "properties": {
    "contract": {
      "const": "dev.lekalo.ir@0.8.0"
    },
    "modelVersion": {
      "const": "0.8.0"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "kind": {
            "enum": [
              "scalar",
              "enum",
              "value-object",
              "entity",
              "command",
              "query",
              "policy",
              "event",
              "effect",
              "endpoint",
              "scenario",
              "target-binding"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visibility": {
            "enum": [
              "project",
              "module",
              "public"
            ]
          },
          "portability": {
            "enum": [
              "target-specific",
              "portable"
            ]
          },
          "renamed_from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "identity": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "relations": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/$defs/relation"
            }
          },
          "uniqueConstraints": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/uniqueConstraint"
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "const": "module"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "project"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "id_registry": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "localFields",
        "targetFields",
        "min",
        "max",
        "ownership",
        "onDetach",
        "onDelete"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "localFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "targetFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "The member is required in the source document and carried in the IR; null is the explicit unbounded spelling."
        },
        "ownership": {
          "enum": [
            "local",
            "external",
            "shared"
          ]
        },
        "onDetach": {
          "enum": [
            "retain-history",
            "forbid"
          ]
        },
        "onDelete": {
          "enum": [
            "restrict",
            "detach"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "uniqueConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fields",
        "comparison",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "comparison": {
          "enum": [
            "exact-text",
            "declared-normalization"
          ]
        },
        "normalizationRef": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
