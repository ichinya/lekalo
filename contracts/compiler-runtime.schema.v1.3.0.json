{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/compiler-runtime.schema.v1.3.0.json",
  "title": "Lekalo supervised compiler runtime bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entry",
    "compilers",
    "libraries"
  ],
  "properties": {
    "schema_version": {
      "const": "lekalo/compiler-runtime/v1.3.0"
    },
    "entry": {
      "$ref": "#/$defs/entryResource"
    },
    "compilers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "version",
          "platform",
          "resource"
        ],
        "properties": {
          "kind": {
            "const": "typescript-native"
          },
          "version": {
            "const": "7.0.2"
          },
          "platform": {
            "enum": [
              "darwin-arm64",
              "darwin-x64",
              "linux-arm64",
              "linux-x64",
              "win32-x64"
            ]
          },
          "resource": {
            "$ref": "#/$defs/resource"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "platform"
            ],
            "properties": {
              "platform": {
                "const": "darwin-arm64"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "platform"
            ],
            "properties": {
              "platform": {
                "const": "darwin-x64"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "platform"
            ],
            "properties": {
              "platform": {
                "const": "linux-arm64"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "platform"
            ],
            "properties": {
              "platform": {
                "const": "linux-x64"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "platform"
            ],
            "properties": {
              "platform": {
                "const": "win32-x64"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "libraries": {
      "type": "array",
      "minItems": 108,
      "maxItems": 108,
      "items": {
        "$ref": "#/$defs/libraryResource"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    },
    "entryResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "libraryResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^runtime/libraries/lib(?:\\.[a-z0-9.]+)?\\.d\\.ts$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      }
    }
  }
}
