{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.framework-lift-campaign-schema@0.6.4",
  "description": "Closed local-only recorded evaluation evidence. Simulation is never live agent evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "campaignId",
    "taskRef",
    "baselineRef",
    "profile",
    "slots",
    "randomizationSeed",
    "analysis",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lekalo/framework-lift-campaign/v0.6.4"
    },
    "identity": {
      "const": "dev.lekalo.framework-lift-campaign@0.6.4"
    },
    "campaignId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "taskRef": {
      "$ref": "#/$defs/ref"
    },
    "baselineRef": {
      "$ref": "#/$defs/ref"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slot"
      },
      "minItems": 4,
      "maxItems": 256,
      "uniqueItems": true
    },
    "randomizationSeed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "analysis": {
      "const": "intent-to-run-wilson-95-paired-counts-1"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentDigest",
        "role",
        "revision"
      ],
      "properties": {
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "$defs": {
    "arm": {
      "enum": [
        "A",
        "B"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTokens",
        "maxToolCalls",
        "deadlineMs",
        "maxFixCycles",
        "maxProviderRetries"
      ],
      "properties": {
        "maxTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxFixCycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxProviderRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "provider",
        "model",
        "harness",
        "runtime",
        "sampling",
        "network",
        "telemetry",
        "architectureProfile",
        "pricing",
        "limits",
        "measurementRecipe"
      ],
      "properties": {
        "executor": {
          "$ref": "#/$defs/component"
        },
        "provider": {
          "$ref": "#/$defs/component"
        },
        "model": {
          "$ref": "#/$defs/component"
        },
        "harness": {
          "$ref": "#/$defs/component"
        },
        "runtime": {
          "$ref": "#/$defs/component"
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperatureMicros",
            "topPMicros",
            "reasoning",
            "seed",
            "maxOutputTokens"
          ],
          "properties": {
            "temperatureMicros": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "topPMicros": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reasoning": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "seed": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "state",
                    "value"
                  ],
                  "properties": {
                    "state": {
                      "const": "known"
                    },
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "state"
                  ],
                  "properties": {
                    "state": {
                      "enum": [
                        "unknown",
                        "withheld",
                        "unsupported"
                      ]
                    }
                  }
                }
              ]
            },
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "network": {
          "enum": [
            "local-only",
            "public-synthetic"
          ]
        },
        "telemetry": {
          "const": "disabled"
        },
        "architectureProfile": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "known"
                },
                "value": {
                  "$ref": "#/$defs/ref"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unknown",
                    "withheld",
                    "unsupported"
                  ]
                }
              }
            }
          ]
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "currency",
            "basis"
          ],
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "basis": {
              "enum": [
                "reported",
                "estimated"
              ]
            }
          }
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "measurementRecipe": {
          "const": "framework-lift-metrics-1"
        }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairId",
        "arm",
        "repetition"
      ],
      "properties": {
        "pairId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "arm": {
          "$ref": "#/$defs/arm"
        },
        "repetition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
