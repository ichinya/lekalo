{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.lekalo/native-tool-catalog.schema.v1.0.0.json",
  "title": "Lekalo native tool-catalog 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime",
    "assets",
    "tools"
  ],
  "properties": {
    "schema_version": {
      "const": "lekalo/native-tool-catalog/v1.0.0"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "program_digest",
        "version"
      ],
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "program_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 32
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "manifest_digest",
        "files"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9@_.+-]+(?:/[A-Za-z0-9@_.+-]+)*$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 33554432
              }
            }
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entry",
          "entry_digest",
          "artifact_digest",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "entry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9@_.+-]+(?:/[A-Za-z0-9@_.+-]+)*$"
          },
          "entry_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "maxLength": 32
          }
        }
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    }
  }
}
