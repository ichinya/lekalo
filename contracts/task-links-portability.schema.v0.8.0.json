{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.task-links-portability-schema@0.8.0",
  "title": "Lekalo task-links portability schema v1",
  "description": "Closed portability projection for the task-links pilot (issue #52): it separates unchanged core domain semantics from provider adapter facts and target guarantees. Every row names the unchanged domain fact or the adapter/target capability, its requirement, the provided state (supported/partial/unsupported/unknown), the exact pin, and the evidence source. A provider-only change must leave every coreSemantics row untouched while providerAdapters and targetGuarantees move; missing remote dedup or target isolation visibly changes guarantee coverage instead of collapsing into a generic pass.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "lekalo/task-links-portability/v0.8.0"
    },
    "identity": {
      "const": "dev.lekalo.task-links-portability@0.8.0"
    },
    "attachmentRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "fromProfile": {
      "$ref": "#/$defs/profileRef"
    },
    "toProfile": {
      "$ref": "#/$defs/profileRef"
    },
    "profile": {
      "enum": [
        "strict",
        "permissive"
      ]
    },
    "coreSemantics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "providerAdapters": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "targetGuarantees": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "executionProvenance": {
      "type": "array", "maxItems": 32,
      "items": {"$ref": "#/$defs/executionProvenance"}
    },
    "evidenceCoverage": {
      "type": "object",
      "properties": {
        "mockEvidenceIds": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/symbolToken"
          }
        },
        "nativeEvidenceIds": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/symbolToken"
          }
        },
        "unsupportedRequired": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "unknownRequired": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "mockEvidenceIds",
        "nativeEvidenceIds",
        "unsupportedRequired",
        "unknownRequired"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "attachmentRevision",
    "projectId",
    "fromProfile",
    "toProfile",
    "profile",
    "coreSemantics",
    "providerAdapters",
    "targetGuarantees",
    "evidenceCoverage"
  ],
  "additionalProperties": false,
  "$defs": {
    "executionProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "implementation", "buildDigest", "sourceDigest", "inputDigest", "resultDigest", "profileId", "profileDigest", "origin", "assertions"],
      "properties": {
        "owner": {"$ref": "#/$defs/token"}, "implementation": {"$ref": "#/$defs/token"},
        "buildDigest": {"$ref": "#/$defs/digest"}, "sourceDigest": {"$ref": "#/$defs/digest"},
        "inputDigest": {"$ref": "#/$defs/digest"}, "resultDigest": {"$ref": "#/$defs/digest"},
        "profileId": {"$ref": "#/$defs/token"}, "profileDigest": {"$ref": "#/$defs/digest"},
        "origin": {"enum": ["mock", "native"]},
        "assertions": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}
      }
    },
    "symbolToken": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
      "maxLength": 191
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profileRef": {
      "type": "object",
      "properties": {
        "profileId": {
          "$ref": "#/$defs/token"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "profileId",
        "digest"
      ],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "properties": {
        "fact": {
          "enum": [
            "external-identity-exact-tuple",
            "task-links-0-n",
            "detach-preserves-history",
            "actor-and-field-policy",
            "version-conflict-detection",
            "idempotent-intent",
            "object-type-mapping",
            "field-mapping",
            "revision-ordering",
            "request-error-schemas",
            "remote-dedup",
            "unique-index",
            "compare-and-swap",
            "local-transaction",
            "durable-outbox",
            "delivery-uncertainty"
          ]
        },
        "requirement": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "provided": {
          "enum": [
            "supported",
            "partial",
            "unsupported",
            "unknown"
          ]
        },
        "pin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
        },
        "evidenceSource": {
          "enum": [
            "attachment-declaration",
            "mock-evidence",
            "native-evidence"
          ]
        },
        "evidenceId": {
          "$ref": "#/$defs/symbolToken"
        },
        "reason": {
          "type": "string",
          "maxLength": 512
        }
      },
      "required": [
        "fact",
        "requirement",
        "provided",
        "pin",
        "evidenceSource"
      ],
      "additionalProperties": false
    }
  }
}
