{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.mcp-tool-context-output@0.8.0",
  "title": "Lekalo MCP tool output: context",
  "description": "Issue #33 closed result envelope of the context tool. status \"valid\" carries the preserved core receipt in \"result\"; every other status carries the typed \"failure\" branch and never a fabricated payload. The status/result|failure coherence is the published conditional; embedded core payloads are the exact bundled upstream definitions.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "lekalo/mcp-tool-context-output/v0.8.0"
    },
    "identity": {
      "const": "dev.lekalo.mcp-tool-context-output@0.8.0"
    },
    "tool": {
      "const": "lekalo_context"
    },
    "scope": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "groupId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        }
      },
      "required": [
        "projectId",
        "groupId"
      ],
      "additionalProperties": false
    },
    "snapshotRef": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "valid",
        "invalid",
        "denied",
        "unsupported",
        "unavailable",
        "unsupported-version"
      ]
    },
    "contractPins": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "const": "0.2.16"
        },
        "diagnosticRegistry": {
          "const": "0.8.0"
        },
        "protocolProfile": {
          "const": "2025-11-25"
        },
        "context": {
          "const": "0.2.16"
        }
      },
      "required": [
        "diagnostic",
        "diagnosticRegistry",
        "protocolProfile",
        "context"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/diagnosticItem"
      },
      "description": "Wire diagnostic items (lekalo/diagnostic/v0.2.16) resolved against dev.lekalo.diagnostic-registry@0.8.0; every item is the closed published projection bundled under $defs.diagnosticItem."
    },
    "result": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "lekalo/context/v0.2.16"
        },
        "identity": {
          "const": "dev.lekalo.context@0.2.16"
        },
        "context": {
          "$ref": "#/$defs/context.Root"
        }
      },
      "required": [
        "schemaVersion",
        "identity",
        "context"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "failureClass": {
          "enum": [
            "invalid-input",
            "scope-denied",
            "sensitive-output",
            "request-limit",
            "output-limit",
            "timeout",
            "cancelled",
            "contract-unsupported",
            "snapshot-stale",
            "backend-unavailable",
            "result-invalid",
            "domain-invalid",
            "domain-denied",
            "domain-unavailable",
            "domain-unsupported",
            "domain-unsupported-version"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "failureClass"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "tool",
    "scope",
    "snapshotRef",
    "status",
    "contractPins",
    "diagnostics"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "status": {
        "const": "valid"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "properties": {
      "result": {
        "$ref": "#/$defs/_anchor"
      },
      "failure": {
        "not": {}
      }
    },
    "required": [
      "result"
    ]
  },
  "else": {
    "properties": {
      "failure": {
        "$ref": "#/$defs/_anchor"
      },
      "result": {
        "not": {}
      }
    },
    "required": [
      "failure"
    ]
  },
  "$defs": {
    "_anchor": {},
    "validation.counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "warning",
        "info"
      ],
      "properties": {
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "validation.report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "profileVersion",
        "registryVersion",
        "rulesEnabled",
        "counts"
      ],
      "properties": {
        "profile": {
          "description": "The closed built-in profile id that ran (`default` or `strict`).",
          "type": "string",
          "enum": [
            "default",
            "strict"
          ]
        },
        "profileVersion": {
          "description": "The exact profile document version that ran.",
          "const": "0.6.4"
        },
        "registryVersion": {
          "description": "The exact diagnostic registry version the findings resolve against.",
          "const": "0.6.4"
        },
        "moduleScope": {
          "description": "Present only for a `--module`-scoped run; the module semantic id scope.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "rulesEnabled": {
          "description": "The number of rules the profile enabled.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "counts": {
          "$ref": "#/$defs/validation.counts"
        }
      }
    },
    "validation.diagnostic": {
      "ruleId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
        "maxLength": 128
      },
      "diagnosticCode": {
        "type": "string",
        "pattern": "^LEK-[A-Z][A-Z0-9]{1,11}-[0-9]{3}$"
      },
      "symbolId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,2}$",
        "maxLength": 256
      },
      "boundedText": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "logicalPath": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*(/[a-z0-9._-]+)*$",
        "maxLength": 1024,
        "not": {
          "pattern": "(^|/)\\.\\.?(/|$)"
        }
      },
      "position": {
        "type": "object",
        "properties": {
          "byte": {
            "type": "integer",
            "minimum": 0
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "byte",
          "line",
          "column"
        ],
        "additionalProperties": false
      },
      "range": {
        "type": "object",
        "properties": {
          "start": {
            "$ref": "#/$defs/validation.diagnostic/position"
          },
          "end": {
            "$ref": "#/$defs/validation.diagnostic/position"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "source": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "#/$defs/validation.diagnostic/logicalPath"
          },
          "range": {
            "$ref": "#/$defs/validation.diagnostic/range"
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      },
      "dataObject": {
        "type": "object",
        "maxProperties": 16,
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
        },
        "additionalProperties": {
          "$ref": "#/$defs/validation.diagnostic/dataValue"
        }
      },
      "dataValue": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 256
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "maxProperties": 16,
            "propertyNames": {
              "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "maxProperties": 16,
                  "propertyNames": {
                    "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 256
                      },
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "type": "array",
            "maxItems": 64,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 256
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          }
        ]
      },
      "location": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "#/$defs/validation.diagnostic/logicalPath"
          },
          "range": {
            "$ref": "#/$defs/validation.diagnostic/range"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "relatedLocations": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "properties": {
            "relation": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "message_id": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "location": {
              "$ref": "#/$defs/validation.diagnostic/location"
            }
          },
          "required": [
            "relation",
            "message_id",
            "location"
          ],
          "additionalProperties": false
        }
      },
      "causes": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "code": {
              "$ref": "#/$defs/validation.diagnostic/diagnosticCode"
            },
            "message_id": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "message": {
              "$ref": "#/$defs/validation.diagnostic/boundedText"
            },
            "data": {
              "$ref": "#/$defs/validation.diagnostic/dataObject"
            },
            "provider": {
              "$ref": "#/$defs/validation.diagnostic/providerMetadata"
            }
          },
          "required": [
            "id",
            "code",
            "message_id",
            "message",
            "data"
          ],
          "additionalProperties": false
        }
      },
      "fixes": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "properties": {
            "fix_id": {
              "$ref": "#/$defs/validation.diagnostic/ruleId"
            },
            "applicability": {
              "enum": [
                "safe",
                "unsafe",
                "breaking"
              ]
            },
            "message": {
              "$ref": "#/$defs/validation.diagnostic/boundedText"
            },
            "data": {
              "$ref": "#/$defs/validation.diagnostic/dataObject"
            },
            "target": {
              "$ref": "#/$defs/validation.diagnostic/location"
            }
          },
          "required": [
            "fix_id",
            "applicability",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "providerMetadata": {
        "type": "object",
        "maxProperties": 8,
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+:[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "original_code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[\\x21-\\x7E]+$"
            }
          },
          "required": [
            "original_code"
          ],
          "additionalProperties": false
        }
      }
    },
    "diagnosticItem": {
      "description": "One closed `lekalo/diagnostic/v0.2.16` item: a faithful projection of the governing `contracts/diagnostic.schema.v0.2.16.json` (same grammars, bounds, and closed object shapes) with the receipt-level constants pinned.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "registry_version",
        "id",
        "code",
        "severity",
        "category",
        "message_id",
        "message",
        "data",
        "related_locations",
        "causes",
        "fixes",
        "metadata"
      ],
      "properties": {
        "schema_version": {
          "const": "lekalo/diagnostic/v0.2.16"
        },
        "registry_version": {
          "description": "The exact registry version the item resolves against: the MCP union successor (0.8.0) for transport diagnostics, or the accepted predecessor pin of a preserved domain diagnostic.",
          "enum": [
            "0.2.16",
            "0.6.4",
            "0.6.5",
            "0.8.0"
          ]
        },
        "id": {
          "$ref": "#/$defs/validation.diagnostic/ruleId"
        },
        "code": {
          "$ref": "#/$defs/validation.diagnostic/diagnosticCode"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "category": {
          "enum": [
            "model",
            "semantic",
            "compatibility",
            "adapter",
            "infrastructure",
            "security"
          ]
        },
        "message_id": {
          "$ref": "#/$defs/validation.diagnostic/ruleId"
        },
        "message": {
          "$ref": "#/$defs/validation.diagnostic/boundedText"
        },
        "symbol": {
          "$ref": "#/$defs/validation.diagnostic/symbolId"
        },
        "source": {
          "$ref": "#/$defs/validation.diagnostic/source"
        },
        "data": {
          "$ref": "#/$defs/validation.diagnostic/dataObject"
        },
        "related_locations": {
          "$ref": "#/$defs/validation.diagnostic/relatedLocations"
        },
        "causes": {
          "$ref": "#/$defs/validation.diagnostic/causes"
        },
        "fixes": {
          "$ref": "#/$defs/validation.diagnostic/fixes"
        },
        "metadata": {
          "$ref": "#/$defs/validation.diagnostic/providerMetadata"
        }
      }
    },
    "context.Root": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "lekalo/context/v0.2.16"
        },
        "identity": {
          "const": "dev.lekalo.context@0.2.16"
        },
        "modelVersion": {
          "enum": [
            "0.2.16",
            "0.2.16"
          ]
        },
        "mode": {
          "enum": [
            "symbol",
            "changed"
          ]
        },
        "project": {
          "oneOf": [
            {
              "$ref": "#/$defs/context.semanticId"
            },
            {
              "type": "null"
            }
          ]
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context.nodeId"
          },
          "minItems": 1,
          "maxItems": 128
        },
        "budget": {
          "$ref": "#/$defs/context.budget"
        },
        "estimator": {
          "$ref": "#/$defs/context.estimator"
        },
        "irDigest": {
          "$ref": "#/$defs/context.digest"
        },
        "complete": {
          "type": "boolean"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidates",
            "excluded",
            "included"
          ],
          "properties": {
            "candidates": {
              "$ref": "#/$defs/context.count"
            },
            "excluded": {
              "$ref": "#/$defs/context.count"
            },
            "included": {
              "$ref": "#/$defs/context.count"
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context.gap"
          },
          "maxItems": 100
        },
        "manifest": {
          "$ref": "#/$defs/context.manifest"
        },
        "sections": {
          "$ref": "#/$defs/context.sections"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context.span"
          },
          "maxItems": 128
        }
      },
      "required": [
        "schemaVersion",
        "identity",
        "modelVersion",
        "mode",
        "project",
        "roots",
        "budget",
        "estimator",
        "irDigest",
        "complete",
        "coverage",
        "gaps",
        "manifest",
        "sections"
      ],
      "additionalProperties": false
    },
    "context.count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "context.semanticId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "context.nodeId": {
      "type": "string",
      "pattern": "^(project|module|type|entity|operation|policy|event|effect|endpoint|scenario|target-binding|requirement):[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "context.digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "context.ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "context.confidence": {
      "enum": [
        "canonical",
        "verified",
        "extracted",
        "inferred",
        "unknown"
      ]
    },
    "context.relation": {
      "enum": [
        "requires",
        "references",
        "accepts",
        "returns",
        "reads",
        "writes",
        "emits",
        "authorizes",
        "exposes",
        "implements",
        "verifies",
        "derived_from"
      ]
    },
    "context.effectKind": {
      "enum": [
        "read",
        "create",
        "update",
        "delete",
        "write-field",
        "emit-event",
        "enqueue-job",
        "external-call",
        "cache-read",
        "cache-write",
        "cache-invalidate",
        "publish-output",
        "audit-log",
        "transaction-boundary"
      ]
    },
    "context.writeAction": {
      "enum": [
        "set",
        "clear",
        "append",
        "replace",
        "merge"
      ]
    },
    "context.resourceKind": {
      "enum": [
        "canonical",
        "target-resource",
        "external-service",
        "cache",
        "event",
        "job",
        "output",
        "audit"
      ]
    },
    "context.budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimated",
        "fits",
        "limit",
        "minimumRequired"
      ],
      "properties": {
        "estimated": {
          "$ref": "#/$defs/context.count"
        },
        "fits": {
          "type": "boolean"
        },
        "limit": {
          "$ref": "#/$defs/context.count"
        },
        "minimumRequired": {
          "$ref": "#/$defs/context.count"
        }
      }
    },
    "context.estimator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "identity",
        "version"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/context.digest"
        },
        "identity": {
          "const": "dev.lekalo.estimator.chars-4@0.2.16"
        },
        "version": {
          "const": "0.2.16"
        }
      }
    },
    "context.gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap"
      ],
      "properties": {
        "gap": {
          "enum": [
            "closure-bounded",
            "detected-effects-absent",
            "error-contracts-unrepresentable",
            "no-description",
            "no-effects",
            "no-policies",
            "no-relevant-bindings",
            "no-scenario-coverage"
          ]
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          },
          "maxItems": 128
        }
      }
    },
    "context.manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "excluded",
        "included"
      ],
      "properties": {
        "excluded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context.excludedRow"
          },
          "maxItems": 50000
        },
        "included": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context.includedRow"
          },
          "maxItems": 50000
        }
      }
    },
    "context.excludedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason",
        "section"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 600
        },
        "reason": {
          "enum": [
            "budget"
          ]
        },
        "section": {
          "$ref": "#/$defs/context.sectionKey"
        }
      }
    },
    "context.includedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "section",
        "tokens"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 600
        },
        "section": {
          "$ref": "#/$defs/context.sectionKey"
        },
        "tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "context.sectionKey": {
      "enum": [
        "symbol",
        "policies",
        "effects",
