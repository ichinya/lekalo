    },
    "discovery/rust": {
      "package": "lekalo-rust",
      "manifest": "crates/discovery/Cargo.toml",
      "binary": "lekalo-rust-discovery"
    },
    "discovery/typescript": {
      "package": "lekalo-typescript",
      "manifest": "crates/discovery/Cargo.toml",
      "binary": "lekalo-typescript-discovery"
    },
    "discovery/python": {
      "package": "lekalo-python",
      "manifest": "crates/discovery/Cargo.toml",
      "binary": "lekalo-python-discovery"
    },
    "requirements": {
      "package": "lekalo-openspec",
      "manifest": "Cargo.toml",
      "binary": "lekalo-openspec"
    },
    "trace": {
      "package": "lekalo-hlv",
      "manifest": "Cargo.toml",
      "binary": "lekalo-hlv"
    },
    "expressions/node": {
      "package": "lekalo-typescript",
      "manifest": "crates/expressions/Cargo.toml",
      "binary": "lekalo-expressions-node"
    },
    "expressions/php": {
      "package": "lekalo-php",
      "manifest": "crates/expressions/Cargo.toml",
      "binary": "lekalo-expressions-php"
    },
    "expressions/go": {
      "package": "lekalo-go",
      "manifest": "crates/expressions/Cargo.toml",
      "binary": "lekalo-expressions-go"
    },
    "attachments/operations": {
      "package": "lekalo-php-laravel",
      "manifest": "crates/attachments/Cargo.toml",
      "binary": "lekalo-laravel-attachments"
    },
    "attachments/routes": {
      "package": "lekalo-php-laravel",
      "manifest": "crates/attachments/Cargo.toml",
      "binary": "lekalo-laravel-attachments"
    },
    "discovery/php": {
      "package": "lekalo-php",
      "manifest": "crates/discovery/Cargo.toml",
      "binary": "lekalo-php-discovery"
    },
    "discovery/ruby": {
      "package": "lekalo-ruby",
      "script": "bin/discovery.cjs"
    },
    "discovery/java": {
      "package": "lekalo-java",
      "script": "bin/discovery.cjs"
    }
