      "package": "lekalo-php-laravel",
      "manifest": "crates/attachments/Cargo.toml",
      "binary": "lekalo-laravel-attachments"
    },
    "discovery/php": {
      "package": "lekalo-php",
      "manifest": "crates/discovery/Cargo.toml",
      "binary": "lekalo-php-discovery"
    }
