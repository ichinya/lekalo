# CI-only prerequisite for Ubuntu's restricted unprivileged user namespaces.
# Based on the purpose-built AppArmor 4.x bwrap-userns-restrict policy:
# https://gitlab.com/apparmor/apparmor/-/blob/apparmor-4.1/profiles/apparmor/profiles/extras/bwrap-userns-restrict
# This outer policy permits bwrap to construct the product's mount/network/PID
# boundary. Its file rules do not mount or reveal any host path in that boundary.
# Executed adapters stack the child profile, which removes every capability.
# Load only in the ephemeral CI VM, without writing a persistent policy/cache.
abi <abi/4.0>,

profile lekalo-ci-bwrap /usr/bin/bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow pix /** -> &lekalo-ci-bwrap//&lekalo-ci-bwrap-child,
}

profile lekalo-ci-bwrap-child flags=(attach_disconnected,mediate_deleted) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow pix /** -> &lekalo-ci-bwrap-child,
  audit deny capability,
}
