# Exact-byte contracts, documentation, scripts, and fixtures use LF in every checkout.
.gitattributes text eol=lf
*.json text eol=lf
*.sha256 text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
# Byte-compared test fixtures must never re-encode on checkout: the
# observed-mode staleness gate fingerprints the exact working-tree bytes
# against scan-pinned digests, so any CRLF conversion fails the gate.
*.ts text eol=lf
*.php text eol=lf

# The generated adapter artifact embeds vendored license text byte-for-byte
# (trailing spaces inside the Apache header are upstream content, not errors).
adapters/node-typescript/adapter.mjs -whitespace
adapters/php-laravel/adapter.php -whitespace

# Generated Go clients are byte-compared by the client-SDK drift gate:
# gofmt requires LF, so CRLF checkout conversion would flag the fixture.
*.go text eol=lf

# Issue #41: the managed lock and every managed fixture are byte-compared
# custody artifacts (digest pins, plan/record/fixtures), so they must never
# re-encode on checkout either. Appended; the rules above are predecessor
# protections and stay verbatim.
*.lock text eol=lf
tests/fixtures/managed/planner/lekalo.lock text eol=lf
tests/fixtures/** text eol=lf
# SQLite snapshots are binary exact-byte custody, never text-normalized.
tests/fixtures/**/*.sqlite -text !eol
# Issue #94 formatter fixtures are byte-compared on every OS: the CRLF and
# Unicode portability seeds must never re-encode on checkout or commit.
# Kept last so it wins over the broader tests/fixtures/** text rule above.
tests/fixtures/format/** -text
# The SDK generator compares committed generated bytes against its LF
# rendering (issue #106): a CRLF checkout conversion would flag drift,
# and the SDK crates are built and digested as packaged contents. Rust
# sources have no eol attribute, so autocrlf would re-encode them.
sdk/rust/**/*.rs text eol=lf
sdk/templates/**/*.rs text eol=lf
# Issue #106 invalid-request corpus embeds literal NUL bytes to pin decoder
# rejection paths; byte-compared custody, never text-normalized.
tests/fixtures/adapter-sdk/invalid/request-nul-*.json -text !eol
