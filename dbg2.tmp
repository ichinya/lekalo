// Which file diverges? Reproduce with the full sandbox and read the
// diagnostic data: add a temporary debug print via a copy of the CLI run.
const { createHash } = require('crypto');
const { cpSync, mkdirSync, readFileSync, mkdtempSync, rmSync, writeFileSync, readdirSync } = require('fs');
const { tmpdir } = require('os');
const { join } = require('path');
const { spawnSync } = require('child_process');
const root = 'C:/Users/User/orca/workspaces/lekalo/m8-issue-94';
const binary = join(root, 'target/debug/lekalo.exe');
const sha256 = (d) => createHash('sha256').update(d).digest('hex');
const workspace = mkdtempSync(join(tmpdir(), 'dbg3d-'));
const project = join(workspace, 'forged-' + process.pid);
cpSync(join(root, 'tests/fixtures/format/planner-canonical'), project, { recursive: true });
const module = join(project, 'lekalo/modules/scheduling/module.yaml');
const before = readFileSync(module);
// IMPORTANT: also digest every OTHER source file: maybe the manifest
// accidentally pins one of those? No — single file. Print the plan id
// the CLI sees and the source digests.
const forged = Buffer.from('# forged semantic edit\n"definitions":\n  - "description": "FORGED SEMANTIC EDIT"\n    "id": "scheduling"\n    "kind": "module"\n    "version": 1\n"schema_version": "0.2.16"\n');
const forgedDigest = sha256(forged);
const policy = JSON.parse(readFileSync(join(root, 'contracts/format-policy.v0.8.0.json'), 'utf8')).policyDigest;
const base = sha256(Buffer.concat([Buffer.from(policy), Buffer.from([0x1f]), Buffer.from('lekalo/modules/scheduling/module.yaml'), Buffer.from([0x1f]), Buffer.from(forgedDigest), Buffer.from([0x1f]), Buffer.from(forgedDigest)]));
const planId = base.slice(0, 47) + '-1';
const home = join(project, '.lekalo/cache/format', planId);
mkdirSync(join(home, 'before/modules/scheduling'), { recursive: true });
writeFileSync(join(home, 'before/modules/scheduling/module.yaml'), forged);
const manifest = '{"schema_version":"lekalo/format-transaction/v0.8.0","plan_id":"' + planId + '","policy_digest":"' + policy + '","files":[{"path":"lekalo/modules/scheduling/module.yaml","before_sha256":"' + forgedDigest + '","after_sha256":"' + forgedDigest + '"}]}';
writeFileSync(join(home, 'manifest.json'), manifest);
writeFileSync(join(home, 'journal.json'), '{"schema_version":"lekalo/format-transaction/v0.8.0","plan_id":"' + planId + '","manifest_sha256":"' + sha256(manifest) + '"}\n');
console.log('planId:', planId);
console.log('before digest (real):', sha256(before));
console.log('forged digest       :', forgedDigest);
console.log('module bytes now == before:', readFileSync(module).equals(before));
const run1 = spawnSync(binary, ['format', '--check'], { cwd: project, encoding: 'utf8' });
console.log('check first:', run1.status, run1.stdout.slice(0, 160), run1.stderr.slice(0, 160));
