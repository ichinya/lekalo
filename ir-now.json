draft_body","required":true,"type":{"ref":"changelog.public_field_text"}}],"kind":"command","portability":"portable","version":1,"visibility":"project"},{"derived_from":["TASKHUB-REQ-004"],"description":"Explicit opt-in edits the independent draft; any draft change invalidates approval","effects":["changelog.effect_draft_edit"],"id":"changelog.edit_draft","input":[{"name":"entry_id","required":true,"type":{"ref":"changelog.entry_id"}},{"name":"tenant_id","required":true,"type":{"ref":"worklog.tenant_id"}},{"name":"draft_body","required":true,"type":{"ref":"changelog.public_field_text"}},{"name":"expected_revision","required":true,"type":{"ref":"worklog.record_revision"}}],"kind":"command","portability":"portable","version":1,"visibility":"project"},{"description":"Record one approval binding","entity":"changelog.approval","id":"changelog.effect_approval_write","kind":"effect","operation":"create","portability":"portable","version":1,"visibility":"project"},{"description":"Append one lifecycle audit record","entity":"changelog.audit","id":"changelog.effect_audit_append","kind":"effect","operation":"create","portability":"portable","version":1,"visibility":"project"},{"description":"Update one draft entry row","entity":"changelog.entry","id":"changelog.effect_draft_edit","kind":"effect","operation":"update","portability":"portable","version":1,"visibility":"project"},{"description":"Create one draft entry row","entity":"changelog.entry","id":"changelog.effect_draft_write","kind":"effect","operation":"create","portability":"portable","version":1,"visibility":"project"},{"description":"Record the canonical sanitized preview bytes","entity":"changelog.entry","id":"changelog.effect_preview_write","kind":"effect","operation":"update","portability":"portable","version":1,"visibility":"project"},{"description":"Declare the separate publish-output of the public payload","entity":"changelog.snapshot","id":"changelog.effect_publication_emit","kind":"effect","operation":"update"