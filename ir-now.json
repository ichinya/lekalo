enant_id"}},{"name":"revision","required":true,"type":{"ref":"worklog.record_revision"}}],"portability":"portable","version":1,"visibility":"project"},{"description":"One entry was withdrawn; immutable history survives under restricted access","id":"changelog.entry_withdrawn","kind":"event","payload":[{"name":"entry_id","required":true,"type":{"ref":"changelog.entry_id"}},{"name":"tenant_id","required":true,"type":{"ref":"worklog.tenant_id"}}],"portability":"portable","version":1,"visibility":"project"},{"description":"Entry lifecycle state","id":"changelog.lifecycle","kind":"enum","portability":"portable","values":[{"description":"Being written","value":"draft"},{"description":"Canonical public preview produced","value":"previewed"},{"description":"Approval bound to the current preview","value":"approved"},{"description":"Snapshot appended and visible","value":"published"},{"description":"Hidden, immutable history survives","value":"withdrawn"}],"version":1,"visibility":"project"},{"derived_from":["TASKHUB-REQ-005"],"description":"Produce the canonical sanitized public preview bytes under the shared preview and final rendering policy","effects":["changelog.effect_preview_write"],"id":"changelog.preview_entry","input":[{"name":"entry_id","required":true,"type":{"ref":"changelog.entry_id"}},{"name":"tenant_id","required":true,"type":{"ref":"worklog.tenant_id"}},{"name":"expected_revision","required":true,"type":{"ref":"worklog.record_revision"}}],"kind":"command","portability":"portable","version":1,"visibility":"project"},{"derived_from":["TASKHUB-REQ-006"],"description":"Public actor lists currently published snapshot payloads","id":"changelog.public_entries","kind":"query","portability":"portable","reads":["changelog.snapshot"],"returns":{"list":{"ref":"changelog.public_entry_dto"}},"version":1,"visibility":"project"},{"derived_from":["TASKHUB-REQ-006"],"description":"Public actor reads only the currently published snapshot fields through the public DTO; no privat