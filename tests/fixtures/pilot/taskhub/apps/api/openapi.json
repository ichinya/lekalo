{
  "openapi": "3.0.3",
  "info": {
    "title": "taskhub api",
    "version": "1.0.0",
    "description": "Synthetic pilot fixture (issue #49): the committed description of the taskhub HTTP surface. Every endpoint, schema, and name is fictional."
  },
  "paths": {
    "/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "Page through the recorded tasks",
        "responses": {
          "200": {
            "description": "The requested task page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "open": { "type": "integer" }
                  },
                  "required": ["total", "open"]
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createTask",
        "summary": "Create one backlog task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewTaskInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          }
        }
      }
    },
    "/tasks/{taskId}/transition": {
      "post": {
        "operationId": "transitionTask",
        "summary": "Move one task to the next lifecycle state",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": ["backlog", "focused", "done"]
                  }
                },
                "required": ["state"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The moved task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "taskId": { "type": "string" },
          "title": { "type": "string" },
          "state": {
            "type": "string",
            "enum": ["backlog", "focused", "done"]
          }
        },
        "required": ["taskId", "title", "state"]
      },
      "NewTaskInput": {
        "type": "object",
        "properties": {
          "taskId": { "type": "string" },
          "title": { "type": "string" }
        },
        "required": ["taskId", "title"]
      }
    }
  }
}
