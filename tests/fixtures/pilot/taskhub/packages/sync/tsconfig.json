{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": "../../",
    "paths": {
      "@taskhub/*": ["packages/*/src", "apps/*/src"]
    }
  },
  "include": ["src"]
}
