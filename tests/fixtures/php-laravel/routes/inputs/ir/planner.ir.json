{
 "contract": "dev.lekalo.ir@0.2.16",
 "definitions": [
  {
   "derived_from": [
    "PLANNER-REQ-002"
   ],
   "description": "The workspace tasks with no planning row yet, in stable title order",
   "id": "planner.backlog_tasks",
   "kind": "query",
   "reads": [
    "planner.user_task_planning"
   ],
   "returns": {
    "list": {
     "ref": "planner.user_task_planning"
    }
   },
   "version": 1
  },
  {
   "derived_from": [
    "PLANNER-REQ-004"
   ],
   "description": "The planning rows of earlier days, served at their original planned_for; a read never rewrites the stored date",
   "id": "planner.carry_over",
   "kind": "query",
   "reads": [
    "planner.user_task_planning"
   ],
   "returns": {
    "list": {
     "ref": "planner.user_task_planning"
    }
   },
   "version": 1
  },
  {
   "derived_from": [
    "PLANNER-REQ-007"
   ],
   "description": "Complete one planned task; stamps completed_at from the declared clock and refuses an already completed row",
   "effects": [
    "planner.effect_planning_completed"
   ],
   "id": "planner.complete_planning",
   "input": [
    {
     "name": "planning_id",
     "required": true,
     "type": {
      "ref": "planner.planning_id"
     }
    }
   ],
   "kind": "command",
   "version": 1
  },
  {
   "derived_from": [
    "PLANNER-REQ-007"
   ],
   "description": "The planning rows the actor completed, newest day first; a completed row keeps its day and position",
   "id": "planner.completed_planning",
   "kind": "query",
   "reads": [
    "planner.user_task_planning"
   ],
   "returns": {
    "list": {
     "ref": "planner.user_task_planning"
    }
   },
   "version": 1
  },
  {
   "derived_from": [
    "PLANNER-REQ-001"
   ],
   "description": "Count focused tasks",
   "id": "planner.count_focused",
   "kind": "query",
   "reads": [
    "planner.task"
   ],
   "returns": {
    "ref": "planner.task_state"
   },
   "version": 1
  },
  {
   "applies_to": [
    "planner.focus_task"
   ],
   "decision": "deny",
   "description": "Bulk focus is out of scope",
   "id": "planner.deny_bulk_focus",
   "kind": "policy",
   "version": 1
  },
  {
   "applies_to": [
    "planner.complete_planning",
    "planner.move_task",
    "planner.pause_planning",
    "planner.plan_task",
    "planner.reorder_planned",
    "planner.unplan_task"
   ],
   "decision": "deny",
   "derived_from": [
    "PLANNER-REQ-006"
   ],
   "description": "Planning state is scoped to the actor's own workspace and user; foreign rows are invisible and every cross-tenant access is denied",
   "id": "planner.deny_foreign_planning",
   "kind": "policy",
   "version": 1
  },
  {
   "description": "Stamps the completion time of one planning row",
   "emits": [
    "planner.task_completed"
   ],
   "entity": "planner.user_task_planning",
   "id": "planner.effect_planning_completed",
   "kind": "effect",
   "operation": "update",
   "version": 1
  },
  {
   "description": "Creates one planning row for the actor",
   "emits": [
    "planner.task_planned"
   ],
   "entity": "planner.user_task_planning",
   "id": "planner.effect_planning_created",
   "kind": "effect",
   "operation": "create",
   "version": 1
  },
  {
   "description": "Removes one planning row",
   "emits": [
    "planner.task_unplanned"
   ],
   "entity": "planner.user_task_planning",
   "id": "planner.effect_planning_deleted",
   "kind": "effect",
   "operation": "delete",
   "version": 1
  },
  {
   "description": "Moves one planning row to its new day and position",
   "entity": "planner.user_task_planning",
   "id": "planner.effect_planning_moved",
   "kind": "effect",
   "operation": "update",
   "version": 1
  },
  {
   "description": "Stamps the pause time of one planning row",
   "emits": [
    "planner.planning_paused"
   ],
   "entity": "planner.user_task_planning",
   "id": "planner.effect_planning_paused",
   "kind": "effect",
   "operation": "update",
   "version": 1
  },
  {
   "description": "Rewrites the order of one planned day under the optimistic version",
   "emits": [
    "planner.planning_reordered"
   ],
   "entity": "planner.user_task_planning",
   "id": "planner.effect_planning_reordered",
   "kind": "effect",
   "operation": "update",
   "version": 1
  },
  {
   "description": "The workspace tasks with no planning row yet",
