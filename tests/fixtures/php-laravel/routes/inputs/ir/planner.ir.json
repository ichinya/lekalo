   "invokes": "planner.backlog_tasks",
   "kind": "endpoint",
   "method": "GET",
   "path": "/planning/backlog",
   "version": 1
  },
  {
   "description": "The planning rows of earlier days at their original dates",
   "id": "planner.endpoint_carry_over",
   "invokes": "planner.carry_over",
   "kind": "endpoint",
   "method": "GET",
   "path": "/planning/carry-over",
   "version": 1
  },
  {
   "description": "Complete one planned task from the screen",
   "id": "planner.endpoint_complete",
   "invokes": "planner.complete_planning",
   "kind": "endpoint",
   "method": "POST",
   "path": "/planning/{planning_id}/complete",
   "version": 1
  },
  {
   "description": "The planning rows the actor completed",
   "id": "planner.endpoint_completed",
   "invokes": "planner.completed_planning",
   "kind": "endpoint",
   "method": "GET",
   "path": "/planning/completed",
   "version": 1
  },
  {
   "description": "Focus one task from a path id",
   "id": "planner.endpoint_focus_task_by_id",
   "invokes": "planner.focus_task",
   "kind": "endpoint",
   "method": "POST",
   "path": "/tasks/{task_id}/focus",
   "version": 1
  },
  {
   "description": "Move one planned task to an explicit day and position",
   "id": "planner.endpoint_move",
   "invokes": "planner.move_task",
   "kind": "endpoint",
   "method": "PATCH",
   "path": "/planning/{planning_id}",
   "version": 1
  },
  {
   "description": "Pause one planned task",
   "id": "planner.endpoint_pause",
   "invokes": "planner.pause_planning",
   "kind": "endpoint",
   "method": "POST",
   "path": "/planning/{planning_id}/pause",
   "version": 1
  },
  {
   "description": "Plan one task into the actor's day",
   "id": "planner.endpoint_plan",
   "invokes": "planner.plan_task",
   "kind": "endpoint",
   "method": "POST",
   "path": "/planning",
   "version": 1
  },
  {
   "description": "Reorder one planned day under the optimistic version",
   "id": "planner.endpoint_reorder",
   "invokes": "planner.reorder_planned",
   "kind": "endpoint",
   "method": "POST",
   "path": "/planning/reorder",
   "version": 1
  },
  {
   "description": "The maintained focus route of the fixture app, checked in contracted mode",
   "id": "planner.endpoint_tasks_focus",
   "invokes": "planner.focus_task",
   "kind": "endpoint",
   "method": "POST",
   "path": "/api/tasks/{task_id}/focus",
   "version": 1
  },
  {
   "description": "The today board: the planner focus state over HTTP",
   "id": "planner.endpoint_today",
   "invokes": "planner.count_focused",
   "kind": "endpoint",
   "method": "GET",
   "path": "/today",
   "version": 1
  },
  {
   "description": "The planning rows of the actor-local today",
   "id": "planner.endpoint_today_planning",
   "invokes": "planner.today_planning",
   "kind": "endpoint",
   "method": "GET",
   "path": "/planning/today",
   "version": 1
  },
  {
   "description": "Remove one planned task from the plan",
   "id": "planner.endpoint_unplan",
   "invokes": "planner.unplan_task",
   "kind": "endpoint",
   "method": "DELETE",
   "path": "/planning/{planning_id}",
   "version": 1
  },
  {
   "derived_from": [
    "PLANNER-REQ-001"
   ],
   "description": "Focus one task",
   "effects": [
    "planner.update_task"
   ],
   "id": "planner.focus_task",
   "input": [
    {
     "name": "task_id",
     "required": true,
     "type": {
      "ref": "planner.task_id"
     }
    }
   ],
   "kind": "command",
   "version": 1
  },
  {
   "derived_from": [
    "PLANNER-REQ-001"
   ],
   "description": "The today board: list the planner tasks",
   "id": "planner.list_tasks",
   "kind": "query",
   "reads": [
    "planner.task"
   ],
   "returns": {
    "list": {
     "ref": "planner.task"
    }
   },
   "version": 1
  },
  {
   "derived_from": [
    "PLANNER-REQ-002"
   ],
   "description": "Move one planned task to an explicit day and position",
   "effects": [
    "planner.effect_planning_moved"
   ],
   "id": "planner.move_task",
   "input": [
    {
     "name": "planning_id",
     "required": true,
     "type": {
      "ref": "planner.planning_id"
     }
    },
    {
     "name": "planned_for",
     "required": true,
     "type": {
      "ref": "planner.planning_date"
     }
    },
    {
     "name": "position",
     "required": true,
     "type": {
      "ref": "planner.position"
     }
    }
   ],
   "kind": "command",
   "version": 1
  },
  {
   "derived_from": [
    "PLANNER-REQ-003"
   ],
   "description": "Pause one planned task; stamps paused_at from the declared clock",
   "effects": [
    "planner.effect_planning_paused"
   ],
   "id": "planner.pause_planning",
   "input": [
    {
     "name": "planning_id",
     "required": true,
     "type": {
      "ref": "planner.planning_id"
     }
    }
   ],
   "kind": "command",
   "version": 1
  },
  {
   "derived_from": [
    "PLANNER-REQ-002"
   ],
   "description": "Plan one task into the actor's day; idempotent per workspace, user, task and day",
   "effects": [
    "planner.effect_planning_created"
   ],
   "id": "planner.plan_task",
   "input": [
    {
     "name": "task_id",
     "required": true,
     "type": {
      "ref": "planner.task_id"
     }
    },
    {
     "name": "planned_for",
     "required": true,
     "type": {
      "ref": "planner.planning_date"
     }
    }
   ],
   "kind": "command",
   "version": 1
  },
  {
   "base": "date",
   "description": "Calendar day a task is planned for; the actor-local date, never rewritten by reads",
   "id": "planner.planning_date",
   "kind": "scalar",
   "version": 1,
   "visibility": "project"
  },
  {
   "base": "uuid",
   "description": "Stable planning-row identifier",
   "id": "planner.planning_id",
   "kind": "scalar",
   "version": 1,
   "visibility": "project"
  },
  {
   "base": "string",
   "description": "Ordered planning-row ids of one planned day, joined by commas; the wire spelling of the reorder input",
   "id": "planner.planning_order",
   "kind": "scalar",
   "version": 1,
   "visibility": "project"
  },
  {
   "description": "One planned task was paused",
   "id": "planner.planning_paused",
   "kind": "event",
   "payload": [
    {
     "name": "planning_id",
     "required": true,
     "type": {
      "ref": "planner.planning_id"
     }
    },
    {
     "name": "paused_at",
     "required": true,
     "type": {
      "ref": "planner.timestamp"
     }
    }
   ],
   "version": 1
  },
  {
   "description": "One planned day was reordered under a new optimistic version",
   "id": "planner.planning_reordered",
   "kind": "event",
   "payload": [
    {
     "name": "planned_for",
     "required": true,
     "type": {
      "ref": "planner.planning_date"
     }
    },
    {
     "name": "reorder_version",
     "required": true,
     "type": {
      "ref": "planner.reorder_version"
     }
    }
   ],
   "version": 1
  },
  {
   "base": "number",
   "description": "One-based position of the task inside one planned day",
   "id": "planner.position",
   "kind": "scalar",
   "version": 1,
   "visibility": "project"
  },
  {
   "derived_from": [
    "PLANNER-REQ-005"
   ],
   "description": "Reorder one planned day; refused with reorder_stale unless the expected reorder version still matches",
   "effects": [
    "planner.effect_planning_reordered"
   ],
   "id": "planner.reorder_planned",
   "input": [
    {
     "name": "planned_for",
     "required": true,
     "type": {
      "ref": "planner.planning_date"
     }
    },
    {
     "name": "expected_version",
     "required": true,
     "type": {
      "ref": "planner.reorder_version"
     }
    },
    {
     "name": "order",
     "required": true,
     "type": {
      "ref": "planner.planning_order"
     }
    }
   ],
   "kind": "command",
   "version": 1
  },
  {
   "base": "number",
   "description": "Optimistic reorder version of one planned day; every reorder compares and swaps it inside the planning transaction",
   "id": "planner.reorder_version",
   "kind": "scalar",
   "version": 1,
   "visibility": "project"
  },
  {
   "covers": [
    "planner.complete_planning",
    "planner.completed_planning",
    "planner.endpoint_complete",
    "planner.endpoint_completed",
    "planner.today_planning"
   ],
   "derived_from": [
    "PLANNER-REQ-007"
   ],
