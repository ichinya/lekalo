     "required": true,
     "type": {
      "ref": "planner.timestamp"
     }
    }
   ],
   "version": 1
  },
  {
   "description": "A task became focused",
   "id": "planner.task_focused",
   "kind": "event",
   "payload": [
    {
     "name": "task_id",
     "required": true,
     "type": {
      "ref": "planner.task_id"
     }
    }
   ],
   "version": 1
  },
  {
   "base": "uuid",
   "description": "Stable task identifier",
   "id": "planner.task_id",
   "kind": "scalar",
   "version": 1,
   "visibility": "project"
  },
  {
   "description": "A task was planned into a user's day",
   "id": "planner.task_planned",
