   "kind": "scenario",
   "summary": "Given one planned row, the screen completes it; the row renders in the completed bucket with its stamped time.",
   "version": 1
  },
  {
   "covers": [
    "planner.endpoint_focus_task_by_id",
    "planner.endpoint_today_planning",
    "planner.focus_task",
    "planner.today_planning"
   ],
   "derived_from": [
    "PLANNER-REQ-001"
   ],
   "description": "The today board loads, the actor focuses one task from the screen, and the focused state renders",
   "id": "planner.screen_focus_flow",
   "kind": "scenario",
   "summary": "Given one backlog task on the today board, the actor focuses it through the screen and the focused state renders from the next read.",
   "version": 1
  },
  {
   "covers": [
    "planner.backlog_tasks",
    "planner.endpoint_backlog",
    "planner.endpoint_plan",
    "planner.plan_task"
   ],
   "derived_from": [
    "PLANNER-REQ-002"
   ],
   "description": "The screen plans one backlog task and rolls the optimistic card back when the day conflicts",
   "id": "planner.screen_plan_conflict_rollback",
   "kind": "scenario",
   "summary": "Given one backlog task, the screen plans it optimistically; a declared planning_conflict rolls the card back to its bucket.",
   "version": 1
  },
  {
   "covers": [
    "planner.endpoint_reorder",
    "planner.reorder_planned",
    "planner.today_planning"
   ],
   "derived_from": [
    "PLANNER-REQ-005"
   ],
   "description": "The screen reorders one planned day and surfaces the stale-version conflict",
   "id": "planner.screen_stale_reorder",
   "kind": "scenario",
   "summary": "Given one planned day, the screen reorders it under the expected version; a declared reorder_stale keeps the rendered order.",
   "version": 1
  },
