    {
     "name": "task_id",
     "required": true,
     "type": {
      "ref": "planner.task_id"
     }
    },
    {
     "name": "planned_for",
     "required": true,
     "type": {
      "ref": "planner.planning_date"
     }
    },
    {
     "name": "position",
     "required": true,
     "type": {
      "ref": "planner.position"
     }
    }
   ],
   "version": 1
