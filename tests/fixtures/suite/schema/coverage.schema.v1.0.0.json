{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.fixture-coverage@1.0.0",
  "title": "Lekalo diagnostic-rule coverage index (v1.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coverageId",
    "fixtureSchema",
    "registryIdentity",
    "registryDigest",
    "rules"
  ],
  "properties": {
    "coverageId": {
      "const": "dev.lekalo.fixture-coverage.diagnostic-rules"
    },
    "fixtureSchema": {
      "const": "dev.lekalo.fixture@1.0.0"
    },
    "registryIdentity": {
      "const": "dev.lekalo.diagnostic-registry@0.6.3"
    },
    "registryDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script"
      ],
      "properties": {
        "script": {
          "const": "scripts/gen-suite-coverage.mjs"
        },
        "reviewed": {
          "type": "boolean"
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "code",
          "category",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "code": {
            "type": "string",
            "pattern": "^LEK-[A-Z]+-[0-9]{3}$"
          },
          "category": {
            "enum": [
              "adapter",
              "security",
              "semantic",
              "compatibility",
              "infrastructure",
              "model"
            ]
          },
          "evidence": {
            "enum": [
              "suite-pair",
              "family-fixture",
              "test-witness",
              "interaction-only"
            ]
          },
          "suitePair": {
            "type": "string",
            "pattern": "^diagnostic\\.[a-z0-9.-]+\\.pair$"
          },
          "familyFixture": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "family",
                "path"
              ],
              "properties": {
                "family": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "path": {
                  "type": "string",
                  "pattern": "^(?!.*(^|/)\\.\\./)(?!^/)[A-Za-z0-9._][A-Za-z0-9._/ -]*$"
                }
              }
            }
          },
          "testWitness": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "gate"
              ],
              "properties": {
                "gate": {
                  "type": "string",
                  "maxLength": 128
                },
                "note": {
                  "type": "string",
                  "maxLength": 256
                }
              }
            }
          },
          "note": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    }
  }
}
