{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev.lekalo.golden-update-plan@1.0.0",
  "title": "Lekalo golden update plan (v1.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "fixtureSchema",
    "createdBy",
    "reason",
    "caseId",
    "caseRevision",
    "before",
    "after",
    "summary"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "pattern": "^golden-plan-[a-z0-9-]+$"
    },
    "fixtureSchema": {
      "const": "dev.lekalo.fixture@1.0.0"
    },
    "createdBy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script"
      ],
      "properties": {
        "script": {
          "type": "string",
          "pattern": "^scripts/update-golden-[a-z-]*\\.mjs$"
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512
    },
    "caseId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "caseRevision": {
      "type": "integer",
      "minimum": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner"
      ],
      "properties": {
        "runner": {
          "type": "string",
          "maxLength": 64
        },
        "binaryDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "before": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "after": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest",
              "change"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "change": {
                "enum": [
                  "added",
                  "modified",
                  "removed"
                ]
              },
              "declaredPath": {
                "type": "string",
                "pattern": "^(?!.*(^|/)\\.\\./)(?!^/)[A-Za-z0-9._][A-Za-z0-9._/ -]*$",
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticChanges",
        "humanExplanation"
      ],
      "properties": {
        "semanticChanges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "diagnostics-added",
                  "diagnostics-removed",
                  "severity-changed",
                  "reason-codes-changed",
                  "graph-edges-changed",
                  "diff-classification-changed",
                  "scenario-outcome-changed",
                  "protocol-capability-changed",
                  "generated-files-changed",
                  "bytes-changed-explained",
                  "digests-refreshed"
                ]
              },
              "detail": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        },
        "humanExplanation": {
          "type": "string",
          "minLength": 8,
          "maxLength": 2048
        }
      }
    }
  }
}
