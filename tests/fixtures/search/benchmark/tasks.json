{
  "benchmarkId": "dev.lekalo.search-benchmark",
  "recipe": "semantic-search/1",
  "fixture": "tests/fixtures/search/planner",
  "note": "Task-oriented consumer questions with independently authored expectations: every task declares the relevant answer keys, the exact selection verdict, the top-ranked key where one must lead, the precision the page must meet, and the rg answer files its plain-text pattern must surface. Negative tasks declare an empty answer and expect a valid none from lekalo (and, for no-hit negatives, zero rg hits). Expectations are committed before either tool runs and both legs are scored against them.",
  "tasks": [
    {
      "id": "field-writers",
      "family": "field-writers-readers",
      "question": "Which operations write planner.user_task_planning.focused_at?",
      "command": "find",
      "flags": [
        "--writes planner.user_task_planning.focused_at"
      ],
      "relevant": [
        "def:planner.focus_task",
        "def:planner.refocus_task"
      ],
      "expectedSelection": "multiple",
      "expectedTop": "def:planner.focus_task",
      "expectedPrecision": 1,
      "rgPattern": "focused_at",
      "rgRelevantFiles": [
        "lekalo/modules/planner/entities.yaml",
        "evidence/effects.detected.json"
      ]
    },
    {
      "id": "field-readers",
      "family": "field-writers-readers",
      "question": "Which operations read planner.user_task_planning.focused_at?",
      "command": "find",
      "flags": [
        "--reads planner.user_task_planning.focused_at"
      ],
      "relevant": [
        "def:planner.get_focused_task"
      ],
      "expectedSelection": "unique",
      "expectedTop": "def:planner.get_focused_task",
      "expectedPrecision": 1,
      "rgPattern": "focused_at",
      "rgRelevantFiles": [
        "lekalo/modules/planner/entities.yaml",
        "evidence/effects.detected.json"
      ]
    },
    {
      "id": "exact-operation",
      "family": "exact-operation",
      "question": "Find the planner.focus_task operation and its native binding.",
      "command": "search",
      "query": "planner.focus_task",
      "relevant": [
        "def:planner.focus_task",
        "bind:planner.focus_task"
      ],
      "expectedSelection": "ambiguous",
      "expectedTop": "bind:planner.focus_task",
      "rgPattern": "planner.focus_task",
      "rgRelevantFiles": [
        "lekalo/modules/planner/commands.yaml",
        "evidence/observed.index.json"
      ]
    },
    {
      "id": "requirement-chain",
      "family": "requirement-scenario-gate",
      "question": "What implements requirement PLANNER-REQ-001, and how is it covered?",
      "command": "find",
      "flags": [
        "--requirement PLANNER-REQ-001"
      ],
      "relevant": [
        "def:planner.focus_flow",
        "def:planner.focus_task",
        "def:planner.refocus_task",
        "req:aifhub:PLANNER-REQ-001",
        "req:openspec:PLANNER-REQ-001"
      ],
      "expectedSelection": "ambiguous",
      "expectedTop": "def:planner.focus_flow",
      "rgPattern": "PLANNER-REQ-001",
      "rgRelevantFiles": [
        "evidence/trace.openspec.json",
        "evidence/trace.aifhub.json",
        "lekalo/modules/planner/commands.yaml"
      ]
    },
    {
      "id": "gate-chain",
      "family": "requirement-scenario-gate",
      "question": "Which recorded gates does the planner carry evidence for?",
      "command": "find",
      "flags": [
        "--kind gate"
      ],
      "relevant": [
        "gate:hlv.gate.focus"
      ],
      "expectedSelection": "ambiguous",
      "expectedTop": "gate:hlv.gate.focus",
      "expectedPrecision": 1,
      "rgPattern": "hlv.gate.focus",
      "rgRelevantFiles": [
        "evidence/trace.openspec.json"
      ]
    },
    {
      "id": "binding-prefix",
      "family": "binding-prefix",
      "question": "What native bindings live under apps/api/src/planner?",
      "command": "find",
      "flags": [
        "--binding-path apps/api/src/planner"
      ],
      "relevant": [
        "bind:planner.focus_task",
        "bind:planner.get_status",
        "bind:planner.user_task_planning",
        "def:planner.focus_task",
        "def:planner.get_status",
        "def:planner.user_task_planning"
      ],
      "expectedSelection": "multiple",
      "expectedTop": "bind:planner.focus_task",
      "expectedPrecision": 1,
      "rgPattern": "apps/api/src/planner",
      "rgRelevantFiles": [
        "evidence/observed.index.json"
      ]
    },
    {
      "id": "input-type",
      "family": "input-error-type",
      "question": "Which commands take a planner.task_id input?",
      "command": "find",
      "flags": [
        "--input-type planner.task_id"
      ],
      "relevant": [
        "def:planner.archive_task_cmd",
        "def:planner.focus_task",
        "def:planner.import_planning_cmd",
        "def:planner.refocus_task"
      ],
      "expectedSelection": "multiple",
      "expectedTop": "def:planner.archive_task_cmd",
      "expectedPrecision": 1,
      "rgPattern": "planner.task_id",
      "rgRelevantFiles": [
        "lekalo/modules/planner/commands.yaml",
        "lekalo/modules/planner/entities.yaml"
      ]
    },
    {
      "id": "input-type-negative",
      "family": "input-error-type",
      "negative": true,
      "question": "Which commands take an undeclared input type?",
      "command": "find",
      "flags": [
        "--input-type planner.nonexistent_type"
      ],
      "relevant": [],
      "expectedSelection": "none",
      "expectedReturned": 0,
      "rgPattern": "planner.nonexistent_type",
      "rgNoHitNegative": true,
      "rgRelevantFiles": []
    },
    {
      "id": "cross-module-ambiguous-name",
      "family": "cross-module-ambiguous-name",
      "question": "What does get_status mean across modules?",
      "command": "search",
      "query": "get_status",
      "relevant": [
        "def:notify.get_status",
        "def:planner.get_status"
      ],
      "expectedSelection": "ambiguous",
      "expectedTop": "def:notify.get_status",
      "rgPattern": "get_status",
      "rgRelevantFiles": [
        "lekalo/modules/notify/queries.yaml",
        "lekalo/modules/planner/queries.yaml"
      ]
    },
    {
      "id": "waiver-lookup",
      "family": "diagnostic-waiver",
      "question": "Which waiver covers the focus-task lint debt?",
      "command": "find",
      "flags": [
        "--waiver lint-focus-debt"
      ],
      "relevant": [
        "def:planner.focus_task",
        "waiv:lint-focus-debt"
      ],
      "expectedSelection": "multiple",
      "expectedTop": "def:planner.focus_task",
      "expectedPrecision": 1,
      "rgPattern": "lint-focus-debt",
      "rgRelevantFiles": [
        "evidence/waivers.json"
      ]
    },
    {
      "id": "diagnostic-negative",
      "family": "diagnostic-waiver",
      "negative": true,
      "question": "Which admitted findings exist for the rule planner.no-such-rule?",
      "command": "find",
      "flags": [
        "--diagnostic planner.no-such-rule"
      ],
      "relevant": [],
      "expectedSelection": "none",
      "expectedReturned": 0,
      "rgPattern": "lekako-no-such-diagnostic-canary",
      "rgNoHitNegative": true,
      "rgRelevantFiles": []
    }
  ]
}
