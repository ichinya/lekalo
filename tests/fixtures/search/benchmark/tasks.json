{
  "benchmarkId": "dev.lekalo.search-benchmark",
  "recipe": "semantic-search/1",
  "fixture": "tests/fixtures/search/planner",
  "note": "Task-oriented consumer questions with independently authored expectations: every task declares the relevant answer keys, the exact selection verdict, the top-ranked key where one must lead, the MINIMUM answer precision the page must meet (declared on every task, negatives included), the returned-row cap for negatives, and the rg answer files its plain-text pattern must surface together with the minimum rg answer-file precision. Broad lexical questions deliberately tolerate their irrelevant lexical tail: the tolerated class is named per task in toleratedIrrelevant, so a passing task never hides a 0.1-precision page behind an undeclared omission. Negative tasks declare an empty answer and expect a valid none from lekalo (and, for no-hit negatives, zero rg hits). Expectations are committed before either tool runs and both legs are scored against them.",
  "tasks": [
    {
      "id": "field-writers",
      "family": "field-writers-readers",
      "question": "Which operations write planner.user_task_planning.focused_at?",
      "command": "find",
      "flags": [
        "--writes planner.user_task_planning.focused_at"
      ],
      "relevant": [
        "def:planner.focus_task",
        "def:planner.refocus_task"
      ],
      "expectedSelection": "multiple",
      "expectedTop": "def:planner.focus_task",
      "expectedPrecision": 1,
      "toleratedIrrelevant": "none: an exact field selector admits only field-scoped writers",
      "rgPattern": "focused_at",
      "rgRelevantFiles": [
        "lekalo/modules/planner/entities.yaml",
        "evidence/effects.detected.json",
        "lekalo/modules/planner/events.yaml"
      ],
      "rgExpectedFilePrecision": 1
    },
    {
      "id": "field-readers",
      "family": "field-writers-readers",
      "question": "Which operations read planner.user_task_planning.focused_at?",
      "command": "find",
      "flags": [
        "--reads planner.user_task_planning.focused_at"
      ],
      "relevant": [
        "def:planner.get_focused_task"
      ],
      "expectedSelection": "unique",
      "expectedTop": "def:planner.get_focused_task",
      "expectedPrecision": 1,
      "toleratedIrrelevant": "none: an exact field selector admits only field-scoped readers",
      "rgPattern": "focused_at",
      "rgRelevantFiles": [
        "lekalo/modules/planner/entities.yaml",
        "evidence/effects.detected.json",
        "lekalo/modules/planner/events.yaml"
      ],
      "rgExpectedFilePrecision": 1
    },
    {
      "id": "exact-operation",
      "family": "exact-operation",
      "question": "Find the planner.focus_task operation and its native binding.",
      "command": "search",
      "query": "planner.focus_task",
      "relevant": [
        "def:planner.focus_task",
        "bind:planner.focus_task"
      ],
      "expectedSelection": "ambiguous",
      "expectedTop": "bind:planner.focus_task",
      "expectedPrecision": 0.1,
      "toleratedIrrelevant": "the lexical tail of a two-term ID query (focus/task-family definitions, events, and their cards) is deliberately tolerated beside the two exact answers; the exact-ID tier still ranks both answers first",
      "rgPattern": "planner.focus_task",
      "rgRelevantFiles": [
        "lekalo/modules/planner/commands.yaml",
        "evidence/observed.index.json"
      ],
      "rgExpectedFilePrecision": 0.15
    },
    {
      "id": "requirement-chain",
      "family": "requirement-scenario-gate",
      "question": "What implements requirement PLANNER-REQ-001, and how is it covered?",
      "command": "find",
      "flags": [
        "--requirement PLANNER-REQ-001"
      ],
      "relevant": [
        "def:planner.focus_flow",
        "def:planner.focus_task",
        "def:planner.refocus_task",
        "req:aifhub:PLANNER-REQ-001",
        "req:openspec:PLANNER-REQ-001"
      ],
      "expectedSelection": "ambiguous",
      "expectedTop": "def:planner.focus_flow",
      "expectedPrecision": 0.8,
      "toleratedIrrelevant": "the gate card that covers the same requirement chain is a tolerated sixth row, not a false answer",
      "rgPattern": "PLANNER-REQ-001",
      "rgRelevantFiles": [
        "evidence/trace.openspec.json",
        "evidence/trace.aifhub.json",
        "lekalo/modules/planner/commands.yaml",
        "lekalo/project.yaml"
      ],
      "rgExpectedFilePrecision": 1
    },
    {
      "id": "gate-chain",
      "family": "requirement-scenario-gate",
      "question": "Which recorded gates does the planner carry evidence for?",
      "command": "find",
      "flags": [
        "--kind gate"
      ],
      "relevant": [
        "gate:hlv.gate.focus"
      ],
      "expectedSelection": "ambiguous",
      "expectedTop": "gate:hlv.gate.focus",
      "expectedPrecision": 1,
      "toleratedIrrelevant": "none: kind gates over the admitted trace close to exactly the recorded gate cards",
      "rgPattern": "hlv.gate.focus",
      "rgRelevantFiles": [
        "evidence/trace.openspec.json"
      ],
      "rgExpectedFilePrecision": 1
    },
