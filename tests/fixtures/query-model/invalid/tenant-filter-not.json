  },
  "irRef": {
    "identity": "dev.lekalo.ir@0.1.0",
    "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
  },
  "tenancy": [
    { "entity": "planner.task", "field": "tenant" }
  ],
  "queries": [
    {
      "query": "planner.tasks_today",
      "source": "planner.task",
      "cardinality": "page",
      "consistency": "bounded",
      "maxStaleness": 60,
      "parameters": [
        { "name": "cursor_key", "type": "planner.task_id" },
        { "name": "tenant_id", "type": "planner.tenant_id" }
      ],
      "filter": {
        "not": {
          "field": "tenant",
          "op": "eq",
          "value": { "param": "tenant_id" }
        }
      },
      "sort": [
        { "field": "due", "direction": "asc" },
        { "field": "task_id", "direction": "asc" }
      ],
      "pagination": {
        "strategy": "cursor",
        "limit": 50,
        "keyParameter": "cursor_key"
      }
    }
  ]
}
