    {
      "id": "expr.planner/overdue-check",
      "kind": "condition",
      "description": "A started task with a due date in the past is overdue.",
      "params": [
        {
          "scope": "input",
          "field": "due",
          "type": "datetime",
          "nullable": true
        },
        {
          "scope": "input",
          "field": "state",
          "type": "string"
        }
      ],
      "result": "bool",
      "span": {
        "file": "modules/planner/expressions.yaml",
        "startByte": 128,
        "startLine": 12,
        "startColumn": 9,
        "endByte": 512,
        "endLine": 18,
        "endColumn": 22
      },
      "body": {
        "op": "if",
        "condition": {
          "op": "and",
          "operands": [
            {
              "op": "not-null",
              "operand": {
                "op": "ref",
                "scope": "input",
                "field": "due"
              }
            },
            {
              "op": "ne",
              "left": {
                "op": "ref",
                "scope": "input",
                "field": "state"
              },
              "right": {
                "op": "lit-string",
                "value": "done"
              }
            }
          ]
        },
        "then": {
          "op": "lt",
          "left": {
            "op": "ref",
            "scope": "input",
            "field": "due"
          },
          "right": {
            "op": "now"
          }
        },
        "else": {
          "op": "lit-bool",
          "value": false
        }
      }
    },
    {
