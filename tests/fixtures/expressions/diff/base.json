            "else": {
              "op": "lit-bool",
              "value": false
            }
          },
          {
            "op": "in-set",
            "operand": {
              "op": "ref",
              "scope": "input",
              "field": "state"
            },
            "set": {
              "op": "ref",
              "scope": "input",
              "field": "project_tags"
            }
          }
