        {
          "line": "node scripts/pilot-brownfield-ts.mjs --consumer tests/fixtures/pilot/brownfield-mysql --bind packages/api/src/routes/tasks.ts:submitTask:task.submit --disposition public-fixture",
          "exit": 0,
          "stream": "stdout",
          "check": "mysql-observed"
