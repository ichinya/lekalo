{
  "formatVersion": 1,
  "sourceProduct": "0.6.3",
  "setup": [
    {
      "id": "source-build",
      "document": "README.md",
      "line": "cargo build -p lekalo-cli --locked",
      "requires": "built-cli"
    },
    {
      "id": "mysql-packages",
      "document": "docs/tutorial-brownfield-typescript.md",
      "line": "npm ci --ignore-scripts --no-audit --no-fund",
      "requires": "locked-mysql-dependencies"
    }
  ],
  "examples": [
    {
      "id": "read-minimal",
      "document": "README.md",
      "fixture": "tests/fixtures/loader/valid-zero-modules",
      "lane": "portable",
      "write": false,
      "commands": [
        {
          "line": "lekalo load --ir --json --no-cache",
          "exit": 0,
          "stream": "stdout",
          "check": "ir"
        },
        {
          "line": "lekalo validate --strict --json --no-cache",
          "exit": 0,
          "stream": "stdout",
          "check": "validation"
        }
      ]
    },
    {
      "id": "minimal-init",
      "document": "docs/project-layout.md",
      "fixture": "empty",
      "lane": "portable",
      "write": true,
      "commands": [
        {
          "line": "lekalo --json init --project-id tutorial --module planner",
          "exit": 0,
          "stream": "stdout",
          "check": "init"
        },
        {
          "line": "lekalo --no-cache --json load --ir",
          "exit": 0,
          "stream": "stdout",
          "check": "ir"
        },
        {
          "line": "lekalo --no-cache --json validate --strict",
          "exit": 0,
          "stream": "stdout",
          "check": "validation"
        }
      ]
    },
    {
      "id": "inspect-planner",
      "document": "docs/architecture.md",
      "fixture": "tests/fixtures/contracted/planner-slice",
      "lane": "portable",
      "write": false,
      "commands": [
        {
          "line": "lekalo --no-cache --json inspect planner.focus_task",
          "exit": 0,
          "stream": "stdout",
          "check": "inspect"
        },
        {
          "line": "lekalo --no-cache --json impact planner.focus_task",
          "exit": 0,
          "stream": "stdout",
          "check": "impact"
        },
        {
          "line": "lekalo --no-cache --json context planner.focus_task --budget 5000",
          "exit": 0,
          "stream": "stdout",
          "check": "context"
        }
      ]
    },
    {
      "id": "contract-planner",
      "document": "docs/adoption.md",
      "fixture": "tests/fixtures/docs/contracted-module",
      "lane": "portable",
      "write": true,
      "commands": [
        {
          "line": "lekalo --json contract update --declaration declarations/initial.json",
          "exit": 0,
          "stream": "stdout",
          "check": "contract-update"
        },
        {
          "line": "node --test --test-reporter=tap test/native.test.mjs",
          "exit": 0,
          "stream": "stdout",
          "check": "native-tests"
        },
        {
          "line": "lekalo --json contract attach planner.focus_task --native-test tutorial.focus",
          "exit": 0,
          "stream": "stdout",
          "check": "contract-attach"
        },
        {
          "line": "lekalo --json contract attach planner.list_tasks --native-test tutorial.list",
          "exit": 0,
          "stream": "stdout",
          "check": "contract-attach"
        },
        {
          "line": "lekalo --no-cache --json contract check --module planner",
          "exit": 0,
          "stream": "stdout",
          "check": "contract-check"
        }
      ]
    },
    {
      "id": "trace-discovery",
      "document": "docs/integrations.md",
      "fixture": "tests/fixtures/trace",
      "lane": "portable",
      "write": false,
      "commands": [
        {
          "line": "lekalo --json trace validate golden/planner.trace.json",
          "exit": 0,
          "stream": "stdout",
          "check": "trace-validate"
        },
        {
          "line": "lekalo --json trace export golden/planner.trace.json",
          "exit": 0,
          "stream": "stdout",
          "check": "trace-export"
        },
        {
          "line": "lekalo --json provider describe",
          "exit": 0,
          "stream": "stdout",
          "check": "provider"
        }
      ]
    },
    {
